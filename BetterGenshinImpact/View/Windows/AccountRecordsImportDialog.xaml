<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AccountRecordsImportDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="导入数据" Width="640" Height="460" MinWidth="480" MinHeight="360"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" ShowInTaskbar="False"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseWindow" />
    </ui:FluentWindow.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                     Icon="{ui:SymbolIcon ArrowDownload24}" ShowMaximize="False" ShowMinimize="False" />
        <ScrollViewer Grid.Row="1" Margin="24" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding CanInteract, Mode=OneWay}">
                <ui:Button Content="选择 JSON 文件…" Command="{Binding ChooseFileCommand, Mode=OneWay}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Summary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,12,0,12" />
                <TextBlock Text="导入到 UID（可修改；不存在时创建）" />
                <ui:TextBox Text="{Binding TargetUid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,10" MaxLength="20" />
                <TextBlock Text="保留文件中的记录时间，仅合并提供的物品。旧记录、非法数量等会进入库存异常，不直接覆盖当前有效值。" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <CheckBox Content="使用下列分类补充本地字典空缺（不覆盖已有分类）" IsChecked="{Binding IncludeDefinitions, Mode=TwoWay}" Margin="0,12,0,4" />
                <ItemsControl ItemsSource="{Binding Definitions, Mode=OneWay}" />
                <ui:Button Content="导入当前库存" Appearance="Primary" Command="{Binding ImportCommand, Mode=OneWay}" IsEnabled="{Binding HasPackage, Mode=OneWay}" Margin="0,12,0,0" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
