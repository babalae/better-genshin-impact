<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.MusicSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="演奏设置"
                 Width="720"
                 Height="760"
                 MinWidth="600"
                 MinHeight="520"
                 d:DesignHeight="760"
                 d:DesignWidth="720"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <Style x:Key="MusicSettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="SettingsSectionIconStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="演奏设置">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      Margin="24,8,24,24"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,12"
                        Style="{StaticResource MusicSettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsSectionIconStyle}">
                                <ui:SymbolIcon Symbol="MusicNote224" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="输出设置" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="设置当前曲目的乐器档案与移调；可在下方启用自动换乐器" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="1,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="乐器档案" />
                                <ComboBox DisplayMemberPath="Name"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedInstrumentProfile}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="1,0,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="半音移调" />
                                <ui:NumberBox Maximum="24"
                                              Minimum="-24"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Inline"
                                              ValidationMode="InvalidInputOverwritten"
                                              Value="{Binding Transpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12"
                        Style="{StaticResource MusicSettingsCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SettingsSectionIconStyle}">
                                <ui:SymbolIcon Symbol="Timer24" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="演奏控制" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="覆盖曲谱速度，并在每次需要时自动准备对应乐器" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox Content="使用自定义 BPM"
                                          IsChecked="{Binding Config.MusicConfig.UseCustomBpm, Mode=TwoWay}" />
                                <TextBlock Margin="22,3,8,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="按曲谱原 BPM 等比例调整整首曲目的播放速度" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          IsEnabled="{Binding Config.MusicConfig.UseCustomBpm}"
                                          Maximum="1000"
                                          Minimum="1"
                                          SmallChange="1"
                                          SpinButtonPlacementMode="Inline"
                                          ValidationMode="InvalidInputOverwritten"
                                          Value="{Binding Config.MusicConfig.CustomBpm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Separator Margin="0,14" />

                        <CheckBox Content="演奏前自动更换乐器"
                                  IsChecked="{Binding Config.MusicConfig.AutoSwitchInstrument, Mode=TwoWay}" />
                        <TextBlock Margin="22,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="自动打开背包、装备当前输出乐器并使用；支持内置的十种乐器档案" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12"
                        Style="{StaticResource MusicSettingsCardStyle}">
                    <Expander>
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,9,0"
                                               Symbol="Options24" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="MIDI 轨道" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="单独启用轨道，并查看音域与映射命中率。" />
                            <ItemsControl ItemsSource="{Binding SelectedMusicItem.Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2"
                                                Padding="10,8"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                                    <b:Interaction.Triggers>
                                                        <b:EventTrigger EventName="Click">
                                                            <b:InvokeCommandAction Command="{Binding DataContext.UpdateTrackSelectionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" />
                                                        </b:EventTrigger>
                                                    </b:Interaction.Triggers>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding MinNoteNumber, Mode=OneWay}" />
                                                    <Run Text="–" />
                                                    <Run Text="{Binding MaxNoteNumber, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding PlayableRatioText, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource MusicSettingsCardStyle}">
                    <Expander>
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,9,0"
                                               Symbol="Settings24" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="音高映射" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="映射模式" />
                                <ComboBox Grid.Column="1"
                                          Margin="12,0,0,0"
                                          ItemsSource="{Binding MappingModes}"
                                          SelectedItem="{Binding SelectedInstrumentProfile.MappingMode}" />
                            </Grid>
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding SelectedInstrumentProfile.Mappings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,8,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Key}" />
                                            <ui:NumberBox Grid.Column="1"
                                                          Maximum="127"
                                                          Minimum="0"
                                                          SmallChange="1"
                                                          SpinButtonPlacementMode="Compact"
                                                          ValidationMode="InvalidInputOverwritten"
                                                          Value="{Binding MidiNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Margin="0,10,0,0"
                                       HorizontalAlignment="Right"
                                       Appearance="Primary"
                                       Command="{Binding SaveProfilesCommand}"
                                       Content="保存映射"
                                       Icon="{ui:SymbolIcon Save24}" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
