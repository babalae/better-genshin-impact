<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.RouteGraphStudioWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 Width="1500"
                 Height="900"
                 MinWidth="1100"
                 MinHeight="700"
                 Title="路网工作室"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="路网工作室">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Map24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1" Padding="10,8" BorderBrush="#33404D" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Margin="6,0,0,0" Command="{Binding ReloadCommand}" Content="重新加载" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding RunQualityCheckCommand}" Content="质量检查" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding ValidatePlanCommand}" Content="规划验证" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding OpenGraphDirectoryCommand}" Content="图目录" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding OpenOverrideDirectoryCommand}" Content="补丁目录" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Padding="12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold" Text="筛选与图例" />
                    <TextBlock Text="地图" />
                    <ComboBox Margin="0,4,0,10" ItemsSource="{Binding MapOptions}" SelectedItem="{Binding FilterMap}" />
                    <TextBlock Text="层级" />
                    <ComboBox Margin="0,4,0,10" ItemsSource="{Binding LayerOptions}" SelectedItem="{Binding FilterLayer}" />
                    <TextBlock Text="审核状态" />
                    <ComboBox Margin="0,4,0,10" ItemsSource="{Binding ReviewOptions}" SelectedItem="{Binding FilterReview}" />
                    <TextBlock Text="来源筛选" />
                    <TextBox Margin="0,4,0,10" Text="{Binding FilterSource, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="节点 / 边 / 传送点搜索" />
                    <TextBox Margin="0,4,0,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Command="{Binding ApplyFiltersCommand}" Content="应用筛选" />

                    <Separator Margin="0,14" />
                    <TextBlock FontWeight="SemiBold" Text="图例" />
                    <TextBlock Margin="0,8,0,0" Foreground="#BDD2EB" Text="● 普通路径节点" />
                    <TextBlock Margin="0,4,0,0" Foreground="#FFAA23" Text="● 已关联传送入口" />
                    <TextBlock Margin="0,4,0,0" Foreground="#FFDC32" Text="▲ 传送点出生位置" />
                    <TextBlock Margin="0,4,0,0" Foreground="#EB46D2" Text="◆ 当前地图目标" />
                    <TextBlock Margin="0,4,0,0" Foreground="#3CBE6E" Text="━ 已验证边" />
                    <TextBlock Margin="0,4,0,0" Foreground="#F5A02D" Text="━ 风险 / 合成反向边" />
                    <TextBlock Margin="0,4,0,0" Foreground="#DC4646" Text="━ 禁用 / 拒绝边" />
                    <TextBlock Margin="0,10,0,0" Foreground="#AAB5C0" Text="滚轮缩放；中键或右键拖动画布；左键选择对象。" TextWrapping="Wrap" />

                    <Separator Margin="0,14" />
                    <TextBlock FontWeight="SemiBold" Text="当前视图" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding VisibleNodes.Count, StringFormat=节点：{0:N0}}" />
                    <TextBlock Text="{Binding VisibleEdges.Count, StringFormat=边：{0:N0}}" />
                    <TextBlock Text="{Binding VisibleTeleports.Count, StringFormat=传送点：{0:N0}}" />
                    <TextBlock Text="{Binding QualityIssues.Count, StringFormat=质量问题：{0:N0}}" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#465461" BorderThickness="1" CornerRadius="4">
                    <controls:RouteGraphCanvas Nodes="{Binding VisibleNodes}"
                                                       Edges="{Binding VisibleEdges}"
                                                       Teleports="{Binding VisibleTeleports}"
                                                       SelectedNode="{Binding SelectedNode}"
                                                       SelectedEdge="{Binding SelectedEdge}"
                                                       SelectedTeleport="{Binding SelectedTeleport}"
                                                       TargetPoint="{Binding CurrentTargetPoint}"
                                                       SelectNodeCommand="{Binding SelectNodeCommand}"
                                                       SelectEdgeCommand="{Binding SelectEdgeCommand}"
                                                       SelectTeleportCommand="{Binding SelectTeleportCommand}" />
                </Border>
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                <TabControl Grid.Row="2">
                    <TabItem Header="节点">
                        <DataGrid ItemsSource="{Binding VisibleNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Header="节点 ID" Binding="{Binding NodeId}" />
                                <DataGridTextColumn Width="*" Header="地图" Binding="{Binding MapName}" />
                                <DataGridTextColumn Width="*" Header="类型" Binding="{Binding NodeType}" />
                                <DataGridTextColumn Width="*" Header="层级" Binding="{Binding LayerId}" />
                                <DataGridTextColumn Width="*" Header="X" Binding="{Binding X, StringFormat=F2}" />
                                <DataGridTextColumn Width="*" Header="Y" Binding="{Binding Y, StringFormat=F2}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="边">
                        <DataGrid ItemsSource="{Binding VisibleEdges}" SelectedItem="{Binding SelectedEdge, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Header="边 ID" Binding="{Binding EdgeId}" />
                                <DataGridTextColumn Width="*" Header="移动" Binding="{Binding MoveMode}" />
                                <DataGridTextColumn Width="*" Header="审核" Binding="{Binding ReviewStatus}" />
                                <DataGridTextColumn Width="*" Header="来源" Binding="{Binding SourceKind}" />
                                <DataGridCheckBoxColumn Width="90" Header="合成反向" Binding="{Binding IsSyntheticReverse}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="传送点">
                        <DataGrid ItemsSource="{Binding VisibleTeleports}" SelectedItem="{Binding SelectedTeleport, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" Header="名称" Binding="{Binding Name}" />
                                <DataGridTextColumn Width="2*" Header="Anchor" Binding="{Binding AnchorId}" />
                                <DataGridTextColumn Width="*" Header="地图" Binding="{Binding MapName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" />

            <TabControl Grid.Column="4" Margin="0,8,8,8">
                <TabItem Header="节点编辑">
                    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="选择节点后可修改坐标、层级和类型；历史 target 应改为 path。" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,4" Text="{Binding SelectedNodeAnchorsText, StringFormat=传送关联：{0}}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,3" Text="X" />
                            <TextBox Text="{Binding NodeX, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,3" Text="Y" />
                            <TextBox Text="{Binding NodeY, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,3" Text="节点类型" />
                            <TextBox Text="{Binding NodeType, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,3" Text="层级" />
                            <TextBox Text="{Binding NodeLayer, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,3" Text="区域标签" />
                            <TextBox Text="{Binding NodeAreaTag, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,3" Text="楼层" />
                            <TextBox Text="{Binding NodeFloor, TargetNullValue=''}" />
                            <CheckBox Margin="0,8" IsChecked="{Binding NodeUnderground}" Content="地下 / 室内层" />
                            <WrapPanel Margin="0,6,0,0">
                                <ui:Button Margin="0,0,6,6" Command="{Binding ApplyNodeEditCommand}" Content="应用修改" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding AddNodeCommand}" Content="新增节点" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding DeleteNodeCommand}" Content="删除节点" />
                            </WrapPanel>
                            <Separator Margin="0,10" />
                            <TextBlock FontWeight="SemiBold" Text="连接编辑" />
                            <TextBlock Margin="0,5" Text="{Binding ConnectionStartNode.NodeId, TargetNullValue=未设置连接起点}" TextWrapping="Wrap" />
                            <TextBlock Text="移动模式" />
                            <TextBox Margin="0,3,0,6" Text="{Binding EdgeMoveMode}" />
                            <CheckBox IsChecked="{Binding AddBidirectionalEdge}" Content="同时新增反向连接" />
                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button Margin="0,0,6,6" Command="{Binding SetConnectionStartCommand}" Content="设为连接起点" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding AddConnectionCommand}" Content="新增连接" />
                            </WrapPanel>
                            <Separator Margin="0,10" />
                            <TextBlock FontWeight="SemiBold" Text="传送点关联" />
                            <ComboBox Margin="0,6" ItemsSource="{Binding VisibleTeleports}" SelectedItem="{Binding SelectedTeleport}" DisplayMemberPath="Name" />
                            <WrapPanel>
                                <ui:Button Margin="0,0,6,6" Command="{Binding AssociateTeleportCommand}" Content="关联到节点" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding RemoveTeleportAssociationCommand}" Content="取消关联" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="边审核">
                    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedEdge.EdgeId, TargetNullValue=未选择边}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedEdge.FromNodeId, StringFormat=起点：{0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedEdge.ToNodeId, StringFormat=终点：{0}}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedEdge.SourceFileName, StringFormat=文件：{0}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedEdge.SourceAuthor, StringFormat=作者：{0}}" />
                            <TextBlock Text="{Binding SelectedEdge.SuccessCount, StringFormat=成功：{0}}" />
                            <TextBlock Text="{Binding SelectedEdge.FailureCount, StringFormat=失败：{0}}" />
                            <TextBlock Text="{Binding SelectedEdge.LastFailureReason, StringFormat=最近失败：{0}}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Margin="0,0,6,6" Command="{Binding MarkEdgeVerifiedCommand}" Content="标记已验证" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding MarkEdgeRiskyCommand}" Content="标记风险" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding DisableEdgeCommand}" Content="禁用" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding RestoreEdgeCommand}" Content="恢复未审核" />
                                <ui:Button Margin="0,0,6,6" Command="{Binding DeleteEdgeCommand}" Content="删除连接" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="质量问题">
                    <DataGrid ItemsSource="{Binding QualityIssues}" SelectedItem="{Binding SelectedQualityIssue, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="90" Header="级别" Binding="{Binding Severity}" />
                            <DataGridTextColumn Width="130" Header="类型" Binding="{Binding Code}" />
                            <DataGridTextColumn Width="*" Header="说明" Binding="{Binding Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="保存补丁">
                    <StackPanel Margin="12">
                        <TextBlock Text="人工操作只保存为小型 GraphOverrides 补丁，不改写生成图。" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,3" Text="作者" />
                        <TextBox Text="{Binding PatchAuthor}" />
                        <TextBlock Margin="0,8,0,3" Text="修改原因" />
                        <TextBox Height="90" AcceptsReturn="True" Text="{Binding PatchReason}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10" Text="{Binding PendingOperationCount, StringFormat=待保存操作：{0}}" />
                        <ui:Button Command="{Binding SavePatchCommand}" Content="保存补丁并重新加载" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" Padding="10,7" BorderBrush="#33404D" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>
