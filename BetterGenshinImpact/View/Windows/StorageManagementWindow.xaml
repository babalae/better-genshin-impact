<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.StorageManagementWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:converters="clr-namespace:BetterGenshinImpact.View.Converters"
                 xmlns:vm="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 Title="存储空间"
                 Width="760"
                 Height="680"
                 MinWidth="620"
                 MinHeight="460"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 UseLayoutRounding="True"
                 d:DataContext="{d:DesignInstance Type=vm:StorageManagementViewModel}"
                 mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="StorageBooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityRevertConverter x:Key="StorageBooleanToCollapsedConverter" />
        <converters:ColorStringToBrushConverter x:Key="StorageColorBrushConverter" />
        <Style x:Key="StorageActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </ui:FluentWindow.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding RefreshCommand, Mode=OneWay}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="存储空间" Icon="{ui:SymbolIcon Storage24}" ShowMinimize="False" />

        <!-- 数据目录与全局操作 -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="数据目录" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding DataDirectory, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DataDirectory, Mode=OneWay}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="打开目录" Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenDataFolderCommand, Mode=OneWay}" Style="{StaticResource StorageActionButtonStyle}" />
            <ui:Button Grid.Column="2" Content="重新计算" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       Command="{Binding RefreshCommand, Mode=OneWay}" Style="{StaticResource StorageActionButtonStyle}" />
        </Grid>

        <!-- 占用总览：比例条、图例与一键清理 -->
        <Border Grid.Row="2" Margin="18,0,18,12" Padding="16,14" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="占用总览" />
                        <ui:ProgressRing Width="13" Height="13" Margin="8,0,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsMeasuring, Mode=OneWay, Converter={StaticResource StorageBooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontSize="20" FontWeight="SemiBold" Text="{Binding TotalSizeText, Mode=OneWay}" />
                </Grid>
                <Border Height="8" Margin="0,10,0,8" CornerRadius="4" ClipToBounds="True"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <ItemsControl ItemsSource="{Binding OverviewSegments, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ProportionalPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:ProportionalPanel.Weight" Value="{Binding Weight, Mode=OneWay}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StorageOverviewSegment}">
                                <Border Background="{Binding Color, Mode=OneWay, Converter={StaticResource StorageColorBrushConverter}}"
                                        ToolTip="{Binding Label, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ItemsControl ItemsSource="{Binding OverviewSegments, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StorageOverviewSegment}">
                            <StackPanel Margin="0,0,16,4" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Color, Mode=OneWay, Converter={StaticResource StorageColorBrushConverter}}" />
                                <TextBlock Margin="6,0,0,0" FontSize="12" Text="{Binding Label, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding QuickCleanupText, Mode=OneWay}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:Button Grid.Column="1" Margin="12,0,0,0" Appearance="Primary" Content="一键清理"
                               Icon="{ui:SymbolIcon Broom24}" Command="{Binding QuickCleanupCommand, Mode=OneWay}"
                               Style="{StaticResource StorageActionButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 分组列表：每行说明这是什么、清理后会怎样，再给出操作；最后是自动清理设置 -->
        <ScrollViewer Grid.Row="3" Padding="18,0,18,6" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StorageGroupViewModel}">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Margin="2,0,0,6" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Color, Mode=OneWay, Converter={StaticResource StorageColorBrushConverter}}" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding Description, Mode=OneWay}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Border CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StorageAreaItemViewModel}">
                                                <StackPanel>
                                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            Visibility="{Binding IsFirst, Mode=OneWay, Converter={StaticResource StorageBooleanToCollapsedConverter}}" />
                                                    <Grid Margin="14,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" MinWidth="96" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="12" Text="{Binding DetailText, Mode=OneWay}" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <ui:ProgressRing Width="12" Height="12" Margin="0,0,6,0" IsIndeterminate="True"
                                                                             Visibility="{Binding IsWorking, Mode=OneWay, Converter={StaticResource StorageBooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <ui:Button Content="打开" Style="{StaticResource StorageActionButtonStyle}"
                                                                       Command="{Binding DataContext.OpenFolderCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                       CommandParameter="{Binding Mode=OneWay}"
                                                                       Visibility="{Binding CanOpenFolder, Mode=OneWay, Converter={StaticResource StorageBooleanToVisibilityConverter}}" />
                                                            <ui:Button Content="{Binding CleanButtonText, Mode=OneWay}" Style="{StaticResource StorageActionButtonStyle}"
                                                                       IsEnabled="{Binding CanClean, Mode=OneWay}"
                                                                       Command="{Binding DataContext.CleanupCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                       CommandParameter="{Binding Mode=OneWay}"
                                                                       Visibility="{Binding IsCleanable, Mode=OneWay, Converter={StaticResource StorageBooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 自动清理：文件缓存上限，由后台维护每天检查一次 -->
                <TextBlock Margin="2,0,0,6" FontWeight="SemiBold" Text="自动清理" />
                <Border Margin="0,0,0,14" Padding="14,10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="文件缓存上限" />
                            <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                       Text="超过后自动删除最早的缓存，每天检查一次。不包括识别模型编译缓存和下载。"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  DisplayMemberPath="Value" SelectedValuePath="Key"
                                  ItemsSource="{Binding CacheLimitOptions, Mode=OneWay}"
                                  SelectedValue="{Binding StorageConfig.FileCacheLimitMb, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Text="清理时会跳过正在使用的文件。用户数据和日志只展示占用，不会被一键清理删除。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1" MinWidth="72" Height="32" Margin="12,0,0,0" Padding="12,4" Content="关闭" IsCancel="True"
                           Command="{Binding CloseCommand, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
