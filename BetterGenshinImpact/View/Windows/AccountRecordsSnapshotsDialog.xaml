<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AccountRecordsSnapshotsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
    xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
    Title="{i18n:T 查看快照}" Width="1060" Height="720" MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
    ShowInTaskbar="False" Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Controls/AccountRecordsTableResources.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="SnapshotTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" /><Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="RowHeight" Value="36" /><Setter Property="ColumnHeaderHeight" Value="36" />
                <Setter Property="FontSize" Value="14" /><Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="None" /><Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="{DynamicResource ApplicationBackgroundBrush}" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource InventoryHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource AccountRecordsCell}" />
                <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" ShowMinimize="False" />
        <ui:TextBox Grid.Row="1" Margin="20,8" PlaceholderText="{i18n:T 搜索物品或类型}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TabControl Grid.Row="2" Margin="20,0" SelectedIndex="{Binding Mode, Mode=TwoWay}">
            <TabItem Header="{i18n:T 按日期}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{i18n:T 快照日期}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="160" ItemsSource="{Binding Dates, Mode=OneWay}" SelectedItem="{Binding SelectedDate, Mode=TwoWay}" />
                        <TextBlock Text="{i18n:T 类型筛选}" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox Width="180" ItemsSource="{Binding Categories, Mode=OneWay}" SelectedItem="{Binding Category, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock>
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="{Binding Mode=OneWay}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Mode=OneWay}" Value=""><Setter Property="Text" Value="{i18n:T 全部类型}" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource SnapshotTable}" ItemsSource="{Binding Items, Mode=OneWay}" RowStyle="{StaticResource AccountRecordsRow}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserResize="False" CanUserSort="False" Header=""
                                HeaderTemplate="{StaticResource AccountRecordsIconHeaderTemplate}" HeaderStyle="{StaticResource AccountRecordsIconHeader}" CellTemplate="{StaticResource AccountRecordsIconTemplate}" />
                            <DataGridTextColumn Header="{i18n:T 名称}" Width="156" MinWidth="44" SortMemberPath="ItemNameSortKey" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                            <DataGridTemplateColumn Header="{i18n:T 类型}" Width="156" MinWidth="48" SortMemberPath="Category">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><controls:AccountRecordsCategoryView Icon="{Binding PageIcon, Mode=OneWay}" Text="{Binding Category, Mode=OneWay}" Description="{Binding CategoryDescription, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{i18n:T 库存}" Width="120" MinWidth="44" SortMemberPath="Quantity" Binding="{Binding QuantityText, Mode=OneWay}" ElementStyle="{StaticResource InventoryQuantity}" HeaderStyle="{StaticResource InventoryQuantityHeader}" />
                            <DataGridTextColumn Header="{i18n:T 记录时间}" Width="180" MinWidth="80" SortMemberPath="RecordedAt" Binding="{Binding TimeText, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                            <DataGridTextColumn Header="{i18n:T 来源}" Width="*" MinWidth="160" Binding="{Binding SourceName, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                            <!-- 新格式未保存灯状态，保留与库存一致的空白列，不重新推断历史灯色。 -->
                            <DataGridTextColumn Header="{i18n:T 状态}" Width="44" MinWidth="44" MaxWidth="44" CanUserSort="False" CanUserResize="False" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="4,6,4,0" FontSize="11" Opacity="0.14" Text="{Binding CountText, Mode=OneWay}" />
                </Grid>
            </TabItem>
            <TabItem Header="{i18n:T 按物品}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Catalog, Mode=OneWay}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" DisplayMemberPath="Name"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Margin="6,12,6,4" />
                        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                    </ListBox>
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" />
                    <DataGrid Grid.Column="2" Style="{StaticResource SnapshotTable}" ItemsSource="{Binding History, Mode=OneWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i18n:T 快照日期}" Width="115" Binding="{Binding Date, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                            <DataGridTextColumn Header="{i18n:T 库存}" Width="100" Binding="{Binding QuantityText, Mode=OneWay}" SortMemberPath="Quantity" ElementStyle="{StaticResource InventoryQuantity}" HeaderStyle="{StaticResource InventoryQuantityHeader}" />
                            <DataGridTextColumn Header="{i18n:T 记录时间}" Width="175" Binding="{Binding TimeText, Mode=OneWay}" SortMemberPath="RecordedAt" ElementStyle="{StaticResource InventoryText}" />
                            <DataGridTextColumn Header="{i18n:T 来源}" Width="*" MinWidth="100" Binding="{Binding Source, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                            <DataGridTextColumn Header="{i18n:T 读取说明}" Width="150" Binding="{Binding Error, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Margin="20,10" Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</ui:FluentWindow>
