<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AccountRecordsEventsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="事件记录" Width="860" Height="640" MinWidth="620" MinHeight="400"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ui:FluentWindow.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <controls:AccountRecordsMessageConverter x:Key="EventMessage" />
 </ui:FluentWindow.Resources>
 <ui:FluentWindow.InputBindings><KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" /></ui:FluentWindow.InputBindings>
 <ui:FluentWindow.CommandBindings><CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseWindow" /></ui:FluentWindow.CommandBindings>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <ui:TitleBar Title="事件记录" ShowMinimize="False" />
  <Border Grid.Row="1" Margin="16" Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
  <DockPanel>
  <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
   <CheckBox DockPanel.Dock="Right" Content="仅看错误" IsChecked="{Binding ErrorsOnly, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
   <ui:TextBox PlaceholderText="搜索事件关键词" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="搜索物品名、来源、说明、事件 ID 和追溯记录" />
  </DockPanel>
  <ListBox x:Name="EventList" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Events, Mode=OneWay}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
   <ListBox.ContextMenu>
    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay}" IsEnabled="{Binding HasCompletedEvents, Mode=OneWay}">
     <MenuItem Header="归档列表内同类未受阻的完成事件" ToolTip="以选中事件的类型为准，只处理当前筛选列表内的合法目标。" Command="{Binding ArchiveCompletedEventsCommand, Mode=OneWay}" Visibility="{Binding HasCompletedEvents, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
    </ContextMenu>
   </ListBox.ContextMenu>
   <ListBox.ItemTemplate><DataTemplate><StackPanel>
    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding TimeRange, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
    <TextBlock Text="{Binding Message, Converter={StaticResource EventMessage}, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
    <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,12,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
<!-- 普通状态显示原值；新增或未知状态不再误显示为 Planned。 -->
<Setter Property="Text" Value="{Binding State, Mode=OneWay, StringFormat=状态：{0}}"/><Style.Triggers>
<DataTrigger Binding="{Binding State, Mode=OneWay}" Value="Aborted"><Setter Property="Text" Value="状态：已终止"/></DataTrigger>
</Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="未归档"/><Style.Triggers><DataTrigger Binding="{Binding Archived, Mode=OneWay}" Value="True"><Setter Property="Text" Value="已归档"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="2" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
     <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
    </Border>
    <Expander Header="原始追溯记录" Margin="0,12,0,0" IsExpanded="False">
     <TextBox Text="{Binding HistoryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
    </Expander>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</ui:FluentWindow>
