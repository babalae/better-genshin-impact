<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AccountRecordsIconCleanupDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
 Title="{i18n:T 清理图像缓存}" Width="440" Height="520" MinWidth="360" MinHeight="300"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" ShowInTaskbar="False"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <DockPanel>
 <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" ShowMinimize="False" ShowMaximize="False" />
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{i18n:T 选择要清理的分类。图标由所有账号共用，清理后需重新采集；库存和需求不受影响。}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <ItemsControl ItemsSource="{Binding Categories, Mode=OneWay}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,4">
      <Expander.Header><CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></Expander.Header>
      <ItemsControl ItemsSource="{Binding Children, Mode=OneWay}" Margin="28,4,0,4">
       <ItemsControl.ItemTemplate><DataTemplate>
        <CheckBox Content="{Binding Name, Mode=OneWay}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </Expander>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,16,0,0">
   <ui:Button Content="{i18n:T 全选}" Command="{Binding SelectAllCommand, Mode=OneWay}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button Content="{i18n:T 取消}" Command="{Binding CancelCommand, Mode=OneWay}" Margin="8,0"/>
    <ui:Button Content="{i18n:T 清理}" Command="{Binding ConfirmCommand, Mode=OneWay}" Appearance="Primary"/>
   </StackPanel>
  </DockPanel>
 </Grid>
 </DockPanel>
</ui:FluentWindow>
