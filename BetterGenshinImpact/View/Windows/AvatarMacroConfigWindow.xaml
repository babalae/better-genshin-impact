<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AvatarMacroConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
                 xmlns:windows="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 Width="860"
                 Height="640"
                 MinWidth="700"
                 MinHeight="500"
                 Title="{i18n:T 一键宏配置}"
                 d:DataContext="{d:DesignInstance Type=windows:AvatarMacroConfigViewModel}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 mc:Ignorable="d"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <!--  单个宏脚本编辑框，DataContext 为当前角色  -->
        <Style x:Key="MacroScriptTextBoxStyle"
               TargetType="ui:TextBox"
               BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="PlaceholderText" Value="{i18n:T '例如：attack,charge(0.3),jump（指令之间用英文逗号分隔）'}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{i18n:T 一键宏配置}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Script16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  说明  -->
        <Border Grid.Row="1"
                Margin="20,12,20,12"
                Padding="14"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
            <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="{i18n:T 触发一键宏时识别当前出战角色，执行该角色选用的宏。每个角色可写 5 套宏，使用与战斗策略相同的指令，例如 attack、charge(0.3)、jump、keypress(f)。}" />
                <Hyperlink Command="{Binding GoToOneKeyMacroUrlCommand}" Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
                    <Run Text="{i18n:T 查看指令说明}" />
                </Hyperlink>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  角色列表  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:TextBox Grid.Row="0"
                            Margin="0,0,0,8"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="{i18n:T 搜索角色}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:ListView Grid.Row="1"
                             ItemsSource="{Binding FilteredAvatars, Mode=OneWay}"
                             SelectedItem="{Binding SelectedAvatar, Mode=TwoWay}"
                             SelectionMode="Single">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type windows:AvatarMacroItemViewModel}">
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Text="{i18n:T 已配置}"
                                           Visibility="{Binding IsConfigured, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </Grid>

            <!--  当前角色的宏编辑区  -->
            <Grid Grid.Column="2"
                  DataContext="{Binding SelectedAvatar, Mode=OneWay}"
                  Visibility="{Binding DataContext.HasSelectedAvatar, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBlock Grid.Row="0"
                              FontTypography="Subtitle"
                              Text="{Binding Name, Mode=OneWay}" />

                <Grid Grid.Row="1" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{i18n:T 使用的宏}" />
                        <TextBlock Margin="0,2,12,0"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{i18n:T 选择默认时跟随设置页中的默认战斗宏编号}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="220"
                              DisplayMemberPath="Value"
                              ItemsSource="{Binding DataContext.MacroPriorityOptions, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding MacroPriority, Mode=TwoWay}"
                              SelectedValuePath="Key" />
                </Grid>

                <TabControl Grid.Row="2" SelectedIndex="{Binding DataContext.SelectedMacroIndex, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TabItem Header="{i18n:T 宏 1}">
                        <ui:TextBox Style="{StaticResource MacroScriptTextBoxStyle}" Text="{Binding ScriptContent1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                    <TabItem Header="{i18n:T 宏 2}">
                        <ui:TextBox Style="{StaticResource MacroScriptTextBoxStyle}" Text="{Binding ScriptContent2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                    <TabItem Header="{i18n:T 宏 3}">
                        <ui:TextBox Style="{StaticResource MacroScriptTextBoxStyle}" Text="{Binding ScriptContent3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                    <TabItem Header="{i18n:T 宏 4}">
                        <ui:TextBox Style="{StaticResource MacroScriptTextBoxStyle}" Text="{Binding ScriptContent4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                    <TabItem Header="{i18n:T 宏 5}">
                        <ui:TextBox Style="{StaticResource MacroScriptTextBoxStyle}" Text="{Binding ScriptContent5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                       Text="{i18n:T 保存后下次触发一键宏时生效。}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button MinWidth="88"
                           Margin="0,0,10,0"
                           Command="{Binding CancelCommand}"
                           Content="{i18n:T 取消}"
                           IsCancel="True" />
                <ui:Button MinWidth="88"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}"
                           Content="{i18n:T 保存}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
