<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.CloudWebInstanceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 Title="云原神网页版"
                 Width="600"
                 MinHeight="230"
                 MaxHeight="600"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 UseLayoutRounding="True"
                 d:DataContext="{d:DesignInstance Type=vm:CloudWebInstanceWindowViewModel}"
                 mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="CloudBooleanToVisibilityConverter" />
        <Style x:Key="CloudActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="CloudErrorTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding BeginCreateCommand, Mode=OneWay}" />
    </ui:FluentWindow.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="云原神网页版" Icon="{ui:SymbolIcon Cloud24}"
                     ShowMinimize="False" ShowMaximize="False" />

        <!-- 首页只保留入口；实例汇总、创建和状态反馈集中在这个窗口。 -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText, Mode=OneWay}" FontSize="13" />
                <TextBlock Text="状态自动更新 · 每个实例独立保存登录状态" FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="新建实例" Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding BeginCreateCommand, Mode=OneWay}"
                       Style="{StaticResource CloudActionButtonStyle}" ToolTip="新建实例（Ctrl+N）" />
        </Grid>

        <!-- 内联创建减少弹窗层级；名称限制仍以存储层校验为准。 -->
        <Border Grid.Row="2" Margin="18,0,18,12" Padding="12" CornerRadius="6"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding IsCreating, Mode=OneWay, Converter={StaticResource CloudBooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="实例名称" FontSize="12" Margin="0,0,0,7" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding NewInstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="例如：主账号、日常号" MaxLength="32" MinHeight="32"
                                AutomationProperties.Name="实例名称">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateAndLaunchCommand, Mode=OneWay}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <ui:Button Grid.Column="1" Content="新建并打开" Margin="8,0,0,0" Appearance="Primary"
                               Style="{StaticResource CloudActionButtonStyle}"
                               Command="{Binding CreateAndLaunchCommand, Mode=OneWay}" />
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Width="32" Height="32"
                               Padding="6" Margin="4,0,0,0" Appearance="Transparent"
                               Command="{Binding CancelCreateCommand, Mode=OneWay}"
                               ToolTip="取消新建" AutomationProperties.Name="取消新建" />
                </Grid>
                <TextBlock Text="{Binding CreationError, Mode=OneWay}" Style="{StaticResource CloudErrorTextStyle}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="18,0,18,8">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsOperationPending, Mode=OneWay, Converter={StaticResource CloudBooleanToVisibilityConverter}}">
                <ui:ProgressRing Width="13" Height="13" IsIndeterminate="True" />
                <TextBlock Text="{Binding OperationText, Mode=OneWay}" FontSize="12" Margin="7,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Style="{StaticResource CloudErrorTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="18,0,18,8">
            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Instances, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CloudWebInstanceRowViewModel}">
                            <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <ui:SymbolIcon Symbol="Cloud24" FontSize="17" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Mode=OneWay}" />
                                        <TextBlock Text="{Binding DetailText, Mode=OneWay}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected, Mode=OneWay}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="3" Content="{Binding ActionText, Mode=OneWay}" Margin="0,0,5,0"
                                               Command="{Binding DataContext.OpenInstanceCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               CommandParameter="{Binding Mode=OneWay}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource CloudActionButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning, Mode=OneWay}" Value="False">
                                                        <Setter Property="Appearance" Value="Primary" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <!-- Flyout 不属于窗口的可视树，通过 PlacementTarget 和 Tag 取得命令与实例行。 -->
                                    <ui:DropDownButton Grid.Column="4" Icon="{ui:SymbolIcon MoreHorizontal24}" Width="36"
                                                       Height="32" Padding="4" Appearance="Transparent" ToolTip="更多操作"
                                                       AutomationProperties.Name="更多操作"
                                                       Tag="{Binding DataContext, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                        <ui:DropDownButton.Flyout>
                                            <ContextMenu DataContext="{Binding PlacementTarget, Mode=OneWay, RelativeSource={RelativeSource Self}}">
                                                <ui:MenuItem Header="关闭游戏" Icon="{ui:SymbolIcon Power24}"
                                                             Command="{Binding Tag.CloseInstanceCommand, Mode=OneWay}"
                                                             CommandParameter="{Binding DataContext, Mode=OneWay}" />
                                                <ui:MenuItem Header="清理缓存（保留登录）" Icon="{ui:SymbolIcon Broom24}"
                                                             Command="{Binding Tag.ClearCacheCommand, Mode=OneWay}"
                                                             CommandParameter="{Binding DataContext, Mode=OneWay}"
                                                             ToolTip="仅可清理未运行的实例，登录状态会保留。"
                                                             ToolTipService.ShowOnDisabled="True" />
                                                <Separator />
                                                <ui:MenuItem Header="删除实例…" Icon="{ui:SymbolIcon Delete24}"
                                                             Command="{Binding Tag.DeleteInstanceCommand, Mode=OneWay}"
                                                             CommandParameter="{Binding DataContext, Mode=OneWay}"
                                                             ToolTip="仅可删除未运行的实例，删除时会清除登录状态。"
                                                             ToolTipService.ShowOnDisabled="True" />
                                            </ContextMenu>
                                        </ui:DropDownButton.Flyout>
                                    </ui:DropDownButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Margin="16,22" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInstances, Mode=OneWay}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="CloudAdd24" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="添加第一个云原神实例" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock Text="点击「新建实例」，取个名字即可打开游戏。" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="登录、排队请在游戏窗口完成。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" Margin="0,3,0,0">
                        <Hyperlink Command="{Binding OpenTasksCommand, Mode=OneWay}" TextDecorations="None">前往独立任务，选择实例运行</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="关闭" IsCancel="True" MinWidth="72" Height="32" Padding="12,4"
                           Command="{Binding CloseCommand, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
