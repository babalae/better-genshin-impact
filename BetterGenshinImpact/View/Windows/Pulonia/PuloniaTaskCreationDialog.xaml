<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaTaskCreationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy"
                 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:markdown="clr-namespace:BetterGenshinImpact.View.Controls.Markdown"
                 xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Windows.Pulonia"
                 Title="{Binding WindowTitle}"
                 Width="1000"
                 Height="740"
                 MinWidth="800"
                 MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=pulonia:PuloniaTaskCreationDialogViewModel}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/BetterGI;component/View/Controls/Resin/ResinUsageResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <!--
        原生 TreeViewItem 在深色主题下会回退到高饱和系统蓝色，并让图标继承错误前景色。
        资源树沿用任务计划树的主题化交互：自绘展开箭头、柔和悬停/选中背景和左侧强调条。
        -->
        <Style x:Key="PathingResourceTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding RelativePath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Width="22"
                                          Height="34"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Chevron"
                                                  Width="5"
                                                  Height="9"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 4,4.5 L 0,9"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Stroke"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MinHeight="34"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="SelectionIndicator"
                                            Width="3"
                                            Height="20"
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="2"
                                            Visibility="Collapsed" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
        JS 脚本和录制资源列表使用独立容器模板，避免原生 ListBoxItem 在深色主题下
        回退到系统选中色，同时让名称与路径占满左侧资源栏并正确省略过长文本。
        -->
        <Style x:Key="ResourceListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                MinHeight="52"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        Height="26"
                                        Margin="2,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="12,5,8,5"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有能力共用同一份 Schema 字段模板，避免创建弹窗和后续参数编辑出现两套语义。 -->
        <DataTemplate x:Key="ParameterFieldTemplate" DataType="{x:Type pulonia:PuloniaTaskParameterFieldViewModel}">
            <StackPanel Margin="0,0,0,14">
                <ui:CardControl Margin="0,0,0,8">
    <ui:CardControl.Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsResinUsageEditor, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
    </ui:CardControl.Style>
    <ui:CardControl.Header>
        <StackPanel Margin="0,0,16,0">
            <ui:TextBlock FontTypography="Body" Text="树脂使用" TextWrapping="Wrap" />
            <ContentControl Content="{Binding Resin, Mode=OneWay}" ContentTemplate="{StaticResource ResinUsageSummaryTemplate}"
                            Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            HorizontalContentAlignment="Stretch" Focusable="False" />
        </StackPanel>
    </ui:CardControl.Header>
    <ui:Button Content="设置" MinWidth="88" Command="{Binding Resin.EditCommand, Mode=OneWay}"
               AutomationProperties.Name="设置树脂使用" ToolTip="{Binding Resin.Summary, Mode=OneWay}" />
</ui:CardControl>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsResinUsageEditor, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayLabel, Mode=OneWay}" />
                <TextBlock Margin="0,3,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Description, Mode=OneWay}"
                           TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextEditor, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBox MinHeight="82"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsJsonEditor, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <combat:CombatStrategyPicker Width="288" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Strategy="{Binding TextValue, Mode=TwoWay}" AllowedKinds="{Binding AllowedStrategyKinds, Mode=OneWay}">
                    <combat:CombatStrategyPicker.Style>
                        <Style TargetType="combat:CombatStrategyPicker">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsCombatStrategyEditor, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </combat:CombatStrategyPicker.Style>
                </combat:CombatStrategyPicker>
                <ComboBox ItemsSource="{Binding Choices, Mode=OneWay}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoiceEditor, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                 OnContent="已开启"
                                 OffContent="已关闭">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBooleanEditor, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
            </StackPanel>
        </DataTemplate>

        <!-- JS 自定义设置表单（JavaScriptSettingFieldTemplate）已移至添加后弹出的 PuloniaJsScriptSettingsDialog，避免挤占运行设置区。 -->
            </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="{ui:SymbolIcon AddCircle24}" />

        <Grid Grid.Row="1" Margin="18,10,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 任务名称自动使用能力或资源的推荐名称，创建后可在计划树中重命名；菜单已传入具体任务类型，无需再选择能力。 -->

            <!-- 资源型任务使用可搜索清单；只对当前选择按需读取详情。 -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RequiresResource}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 仓库管理放在资源区顶部；列表只显示当前选择，不合并或展开其他来源。 -->
                <Border Grid.Row="0" Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SupportsRepositories}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="仓库" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="170"
                                      Margin="0,0,10,0"
                                      ItemsSource="{Binding RepositoryChoices}"
                                      SelectedValue="{Binding SelectedRepository, Mode=TwoWay}"
                                      IsEnabled="{Binding CanManageRepositories}"
                                      Style="{StaticResource PuloniaRepositorySelectorStyle}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ui:Button Command="{Binding OpenRepositoryManagerCommand}"
                                           Content="管理仓库"
                                           ToolTip="打开 Pulonia 仓库管理，添加、同步和管理来源" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="当前列表读取本机仓库副本或本地仓库；添加任务不会访问远端。如需远端最新内容，请先同步仓库。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding ResourceSearchPlaceholder}"
                                    ClearButtonEnabled="True"
                                    Icon="{ui:SymbolIcon Search24}" />
                        <!-- 资源获取保留在新增流程内；仓库关闭后只刷新当前类型，避免进入页面时全量扫描。 -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,6,0"
                                       Command="{Binding OpenResourceRepositoryCommand}"
                                       Content="获取更多资源">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupportsRepositories}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Command="{Binding RefreshResourcesCommand}"
                                       Content="刷新" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <!-- 地图追踪保留 d-v3 易理解的目录层级，同时用 Behavior 维持 MVVM 选中状态。 -->
                            <TreeView Padding="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      ItemContainerStyle="{StaticResource PathingResourceTreeViewItemStyle}"
                                      ItemsSource="{Binding FilteredResourceTree}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.Style>
                                    <Style TargetType="TreeView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathingResourceSelector}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.Style>
                                <i:Interaction.Behaviors>
                                    <behavior:TreeViewSelectedItemBehavior SelectedItem="{Binding SelectedResourceTreeNode, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>
                                <!-- TreeView 的 ItemContainerStyle 不会自动传给全部递归层级，补充隐式样式避免子目录回退系统模板。 -->
                                <TreeView.Resources>
                                    <Style BasedOn="{StaticResource PathingResourceTreeViewItemStyle}"
                                           TargetType="TreeViewItem" />
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid MinHeight="32" Margin="8,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon FontSize="16"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           Symbol="Folder24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <ui:SymbolIcon FontSize="16"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           Symbol="Document24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <ListBox Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     ItemContainerStyle="{StaticResource ResourceListBoxItemStyle}"
                                     ItemsSource="{Binding FilteredResources}"
                                     SelectedItem="{Binding SelectedResource, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathingResourceSelector}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="40">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Location}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Location}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 未下载和空资源状态引导至统一管理窗口，不自动拉取或订阅。 -->
                            <StackPanel VerticalAlignment="Center" Margin="10"
                                        Visibility="{Binding ShowRepositoryGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding RepositoryGuidance}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                           Content="打开仓库管理" Command="{Binding OpenRepositoryManagerCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Text="{Binding ResourcePreviewTitle, Mode=OneWay}" />
                                <!-- 地图追踪资源按目录自动识别的刷新规则；未识别时提示成功后不会跳过。 -->
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding CooldownHint, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasCooldownHint, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Padding="0"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                      Text="{Binding ResourcePreview}"
                                      TextWrapping="Wrap"
                                      VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTextResourcePreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <markdown:MarkdownView Grid.Row="1"
                                                   Background="Transparent"
                                                   FilePath="{Binding ReadmeFilePath}"
                                                   LinkNavigationMode="SystemDefault"
                                                   PresentationDelay="0:0:0.15">
                                <markdown:MarkdownView.Style>
                                    <Style TargetType="markdown:MarkdownView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowMarkdownPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </markdown:MarkdownView.Style>
                            </markdown:MarkdownView>
                        </Grid>
                    </Border>
                    <!--
                    添加时只保留无法事后修改的目录添加方式，以及暂无其他可视化入口的录制回放选项。
                    地图追踪与 JS 的队伍、拾取、战斗和路线 CD 不在这里填写（路线 CD 只在资源详情中显示识别结果）：新任务沿用所在分组或默认值，
                    添加后在“编辑配置”中修改（分组也可统一设置）；视图模型仍保留这些字段供新一条龙弹窗使用。
                    -->
                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Border Margin="0,0,0,12"
                                        Padding="10"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectoryImport}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Text="目录添加方式" />
                                        <ComboBox DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding DirectoryImportModes}"
                                                  SelectedItem="{Binding SelectedDirectoryImportMode, Mode=TwoWay}" />
                                        <TextBlock Margin="0,5,0,7"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding DirectoryImportModeDescription}"
                                                   TextWrapping="Wrap" />
                                        <CheckBox Content="包含全部子目录"
                                                  IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <!-- 录制回放的“按录制延时回放”暂无其他可视化入口，仍在添加时设置。 -->
                                <ItemsControl ItemsSource="{Binding ParameterFields, Mode=OneWay}"
                                              ItemTemplate="{StaticResource ParameterFieldTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowCreationParameters, Mode=OneWay}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                                <!-- 运行设置与 JS 脚本设置的去向提示；录制回放没有提示时折叠。 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunSettingsHint, Mode=OneWay}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,0,8,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Symbol="Info24" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding RunSettingsHint, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 非资源任务直接展示 Schema 生成的参数表单。 -->
            <Border Grid.Row="1"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RequiresResource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,12"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="创建设置" />
                        <ItemsControl ItemsSource="{Binding ParameterFields}"
                                      ItemTemplate="{StaticResource ParameterFieldTemplate}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="此任务无需额外参数，确认后即可添加。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasParameters}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="3"
                                 Margin="0,6,18,0"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="86"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding ConfirmCommand}"
                               Content="添加任务"
                               IsDefault="True" />
                    <ui:Button MinWidth="76"
                               Command="{Binding CancelCommand}"
                               Content="取消"
                               IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</ui:FluentWindow>
