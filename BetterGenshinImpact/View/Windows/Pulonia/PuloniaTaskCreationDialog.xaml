<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaTaskCreationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:markdown="clr-namespace:BetterGenshinImpact.View.Controls.Markdown"
                 xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Windows.Pulonia"
                 Title="{Binding WindowTitle}"
                 Width="1000"
                 Height="740"
                 MinWidth="800"
                 MinHeight="620"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=pulonia:PuloniaTaskCreationDialogViewModel}">

    <ui:FluentWindow.Resources>
        <!--
        原生 TreeViewItem 在深色主题下会回退到高饱和系统蓝色，并让图标继承错误前景色。
        资源树沿用任务计划树的主题化交互：自绘展开箭头、柔和悬停/选中背景和左侧强调条。
        -->
        <Style x:Key="PathingResourceTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding RelativePath}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Width="22"
                                          Height="34"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Chevron"
                                                  Width="5"
                                                  Height="9"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 4,4.5 L 0,9"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Stroke"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    MinHeight="34"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="SelectionIndicator"
                                            Width="3"
                                            Height="20"
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="2"
                                            Visibility="Collapsed" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有能力共用同一份 Schema 字段模板，避免创建弹窗和后续参数编辑出现两套语义。 -->
        <DataTemplate x:Key="ParameterFieldTemplate" DataType="{x:Type pulonia:PuloniaTaskParameterFieldViewModel}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayLabel}" />
                <TextBlock Margin="0,3,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Description}"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextEditor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBox MinHeight="82"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsJsonEditor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoiceEditor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                 OnContent="已开启"
                                 OffContent="已关闭">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBooleanEditor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
            </StackPanel>
        </DataTemplate>

        <!-- JS 自定义设置沿用现有 settings_ui 支持的六类字段，不回退到原始 JSON 输入。 -->
        <DataTemplate x:Key="JavaScriptSettingFieldTemplate"
                      DataType="{x:Type pulonia:PuloniaJsScriptSettingFieldViewModel}">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Margin="0,0,0,5"
                           FontWeight="SemiBold"
                           Text="{Binding Label}"
                           TextWrapping="Wrap" />
                <Separator>
                    <Separator.Style>
                        <Style TargetType="Separator">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Separator.Style>
                </Separator>
                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedValue, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                 OnContent="已开启"
                                 OffContent="已关闭">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
                <ItemsControl ItemsSource="{Binding MultiOptions}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,14,7"
                                      Content="{Binding Value}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:CascadeSelector CascadeOptions="{Binding CascadeOptions}"
                                          SelectedValue="{Binding SelectedValue, Mode=TwoWay}">
                    <controls:CascadeSelector.Style>
                        <Style TargetType="controls:CascadeSelector">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCascadeSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:CascadeSelector.Style>
                </controls:CascadeSelector>
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding Type, StringFormat=不支持的脚本设置类型：{0}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="{ui:SymbolIcon AddCircle24}" />

        <Grid Grid.Row="1" Margin="18,10,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 任务名称自动使用能力或资源的推荐名称，创建后可在计划树中重命名；仅内置入口需要选择能力。 -->
            <ComboBox Grid.Row="0"
                      MinWidth="200"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Left"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding AvailableDefinitions}"
                      SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBuiltinPicker}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <!-- 资源型任务使用可搜索清单；只对当前选择按需读取详情。 -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RequiresResource}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 仓库管理放在资源区顶部；列表只显示当前选择，不合并或展开其他来源。 -->
                <Border Grid.Row="0" Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SupportsRepositories}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="仓库" />
                        <ComboBox Grid.Column="1"
                                  MinWidth="170"
                                  Margin="0,0,10,0"
                                  ItemsSource="{Binding RepositoryChoices}"
                                  SelectedValue="{Binding SelectedRepository, Mode=TwoWay}"
                                  IsEnabled="{Binding CanManageRepositories}"
                                  Style="{StaticResource PuloniaRepositorySelectorStyle}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ui:Button Command="{Binding OpenRepositoryManagerCommand}"
                                       Content="管理仓库"
                                       ToolTip="打开 Pulonia 仓库管理，添加、更新和管理来源引用" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{Binding ResourceSearchPlaceholder}"
                                    ClearButtonEnabled="True"
                                    Icon="{ui:SymbolIcon Search24}" />
                        <!-- 资源获取保留在新增流程内；仓库关闭后只刷新当前类型，避免进入页面时全量扫描。 -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,6,0"
                                       Command="{Binding OpenResourceRepositoryCommand}"
                                       Content="获取更多资源">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupportsRepositories}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Command="{Binding RefreshResourcesCommand}"
                                       Content="刷新" />
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <!-- 地图追踪保留 d-v3 易理解的目录层级，同时用 Behavior 维持 MVVM 选中状态。 -->
                            <TreeView Padding="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      ItemContainerStyle="{StaticResource PathingResourceTreeViewItemStyle}"
                                      ItemsSource="{Binding FilteredResourceTree}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.Style>
                                    <Style TargetType="TreeView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathingResourceSelector}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.Style>
                                <i:Interaction.Behaviors>
                                    <behavior:TreeViewSelectedItemBehavior SelectedItem="{Binding SelectedResourceTreeNode, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>
                                <!-- TreeView 的 ItemContainerStyle 不会自动传给全部递归层级，补充隐式样式避免子目录回退系统模板。 -->
                                <TreeView.Resources>
                                    <Style BasedOn="{StaticResource PathingResourceTreeViewItemStyle}"
                                           TargetType="TreeViewItem" />
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid MinHeight="32" Margin="8,0,6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon FontSize="16"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           Symbol="Folder24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <ui:SymbolIcon FontSize="16"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Margin="0,0,8,0"
                                                           Symbol="Document24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <ListBox Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding FilteredResources}"
                                     SelectedItem="{Binding SelectedResource, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathingResourceSelector}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="48" Margin="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Location}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Location}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 未下载和空资源状态引导至统一管理窗口，不自动拉取或订阅。 -->
                            <StackPanel VerticalAlignment="Center" Margin="10"
                                        Visibility="{Binding ShowRepositoryGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding RepositoryGuidance}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                           Content="打开仓库管理" Command="{Binding OpenRepositoryManagerCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <Border Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,0,8"
                                       FontWeight="SemiBold"
                                       Text="{Binding ResourcePreviewTitle}" />
                            <TextBox Grid.Row="1"
                                     Padding="0"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     IsReadOnly="True"
                                      Text="{Binding ResourcePreview}"
                                      TextWrapping="Wrap"
                                      VerticalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTextResourcePreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <markdown:MarkdownView Grid.Row="1"
                                                   Background="Transparent"
                                                   FilePath="{Binding ReadmeFilePath}"
                                                   LinkNavigationMode="SystemDefault"
                                                   PresentationDelay="0:0:0.15">
                                <markdown:MarkdownView.Style>
                                    <Style TargetType="markdown:MarkdownView">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowMarkdownPreview}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </markdown:MarkdownView.Style>
                            </markdown:MarkdownView>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Text="运行设置" />
                                <Border Margin="0,0,0,12"
                                        Padding="10"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectoryImport}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,5"
                                                   FontWeight="SemiBold"
                                                   Text="目录添加方式" />
                                        <ComboBox DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding DirectoryImportModes}"
                                                  SelectedItem="{Binding SelectedDirectoryImportMode, Mode=TwoWay}" />
                                        <TextBlock Margin="0,5,0,7"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding DirectoryImportModeDescription}"
                                                   TextWrapping="Wrap" />
                                        <CheckBox Content="包含全部子目录"
                                                  IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJavaScriptTask}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Margin="0,0,0,8"
                                               FontWeight="SemiBold"
                                               Text="脚本自定义设置" />
                                    <ItemsControl ItemsSource="{Binding JavaScriptSettingFields}"
                                                  ItemTemplate="{StaticResource JavaScriptSettingFieldTemplate}" />
                                    <TextBlock Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding JavaScriptSettingsMessage}"
                                               TextWrapping="Wrap" />
                                    <Separator Margin="0,0,0,12" />
                                    <TextBlock Margin="0,0,0,10"
                                               FontWeight="SemiBold"
                                               Text="通用运行选项" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding ParameterFields}"
                                              ItemTemplate="{StaticResource ParameterFieldTemplate}" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="此任务使用能力默认设置，无需额外配置。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasParameters}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- 非资源任务直接展示 Schema 生成的参数表单。 -->
            <Border Grid.Row="1"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RequiresResource}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,12"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="创建设置" />
                        <ItemsControl ItemsSource="{Binding ParameterFields}"
                                      ItemTemplate="{StaticResource ParameterFieldTemplate}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="此任务无需额外参数，确认后即可添加。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasParameters}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="3"
                                 Margin="0,6,18,0"
                                 IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="86"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding ConfirmCommand}"
                               Content="添加任务"
                               IsDefault="True" />
                    <ui:Button MinWidth="76"
                               Command="{Binding CancelCommand}"
                               Content="取消"
                               IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</ui:FluentWindow>
