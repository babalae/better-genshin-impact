<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaSoloTaskCreationDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle}"
                 Width="760"
                 Height="720"
                 MinWidth="560"
                 MinHeight="460"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="{ui:SymbolIcon Add24}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">
                <!--  任务概览：名称与说明  -->
                <Grid Margin="0,4,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Symbol="TaskListLtr24" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Margin="0,2,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  节点名称  -->
                <ui:CardControl Margin="0,0,0,20"
                                Icon="{ui:SymbolIcon Rename24}"
                                Visibility="{Binding CanEditName, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="任务名称" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="显示在任务计划中，可用于区分同一任务的多份配置"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="240"
                                Margin="0,0,36,0"
                                Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>

                <!--  任务设置：专属设置界面优先，否则为自动生成的设置卡片  -->
                <ui:TextBlock Margin="0,0,0,4"
                              FontTypography="BodyStrong"
                              Text="任务设置" />
                <ui:TextBlock Margin="0,0,0,10"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="仅对这个任务生效；未修改的项沿用默认设置。"
                              TextWrapping="Wrap" />
                <controls:PuloniaTaskSettingsEditorView DataContext="{Binding Settings}" />
            </StackPanel>
        </ScrollViewer>

        <!--  底部操作栏  -->
        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="96"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding ConfirmCommand}"
                               Content="添加任务" />
                    <ui:Button MinWidth="96"
                               Command="{Binding CancelCommand}"
                               Content="取消"
                               IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
