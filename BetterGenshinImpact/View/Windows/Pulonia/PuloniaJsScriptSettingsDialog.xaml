<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaJsScriptSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Windows.Pulonia"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle, Mode=OneWay}"
                 Width="680"
                 Height="680"
                 MinWidth="520"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=pulonia:PuloniaJsScriptSettingsDialogViewModel}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <!-- JS 自定义设置沿用现有 settings_ui 支持的六类字段，不回退到原始 JSON 输入。 -->
        <DataTemplate x:Key="JavaScriptSettingFieldTemplate"
                      DataType="{x:Type pulonia:PuloniaJsScriptSettingFieldViewModel}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="{Binding Label, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <Separator>
                    <Separator.Style>
                        <Style TargetType="Separator">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Separator.Style>
                </Separator>
                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox ItemsSource="{Binding Options, Mode=OneWay}"
                          SelectedItem="{Binding SelectedValue, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                 OnContent="已开启"
                                 OffContent="已关闭">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
                <ItemsControl ItemsSource="{Binding MultiOptions, Mode=OneWay}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pulonia:PuloniaJsScriptSettingOptionViewModel}">
                            <CheckBox Margin="0,0,14,7"
                                      Content="{Binding Value, Mode=OneWay}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:CascadeSelector CascadeOptions="{Binding CascadeOptions, Mode=OneWay}"
                                          SelectedValue="{Binding SelectedValue, Mode=TwoWay}">
                    <controls:CascadeSelector.Style>
                        <Style TargetType="controls:CascadeSelector">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCascadeSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:CascadeSelector.Style>
                </controls:CascadeSelector>
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding Type, Mode=OneWay, StringFormat=不支持的脚本设置类型：{0}，保存时保留原值}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle, Mode=OneWay}"
                     Icon="{ui:SymbolIcon Code24}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">
                <!--  概览：脚本名称与说明  -->
                <Grid Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Symbol="Code24" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding ScriptName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Margin="0,2,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  脚本声明的设置字段  -->
                <Border Padding="16,16,16,2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ItemsControl ItemsSource="{Binding Fields, Mode=OneWay}"
                                  ItemTemplate="{StaticResource JavaScriptSettingFieldTemplate}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  底部操作栏  -->
        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="96"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           Command="{Binding ConfirmCommand}"
                           Content="{Binding ConfirmText, Mode=OneWay}" />
                <ui:Button MinWidth="96"
                           Command="{Binding CancelCommand}"
                           Content="取消"
                           IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
