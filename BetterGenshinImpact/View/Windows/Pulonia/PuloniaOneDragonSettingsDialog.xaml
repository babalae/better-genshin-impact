<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaOneDragonSettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="一条龙步骤配置" Width="850" Height="750" MinWidth="650" MinHeight="500"
 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" FontFamily="{StaticResource TextThemeFontFamily}" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ui:FluentWindow.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Controls/PuloniaOneDragonResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></ui:FluentWindow.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="一条龙步骤配置" ShowMinimize="False" ShowMaximize="False"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="20,12,20,20">
    <!-- 窗口只编辑打开时的步骤；高级编辑状态由窗口专属的 Advanced 按需计算。 -->
    <ui:Card Style="{StaticResource DragonCard}"><StackPanel>
     <TextBlock Text="{Binding Node.TypeDisplayName, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <ui:TextBox Margin="0,8,0,8" Text="{Binding Node.Name, Mode=TwoWay}" PlaceholderText="步骤名称" Visibility="{Binding Node.CanEditOneDragonName, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}"/>
     <TextBlock Margin="0,8,0,8" Text="{Binding Node.Name, Mode=OneWay}" Visibility="{Binding Node.CanEditOneDragonName, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}"/>
     <CheckBox Content="启用此步骤" IsChecked="{Binding Node.IsEnabled, Mode=TwoWay}"/>
     <StackPanel Margin="0,10,0,0" Visibility="{Binding Node.CanConfigureRepeat, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}">
      <TextBlock Text="整组执行次数"/><ui:TextBox Margin="0,6,0,0" Text="{Binding Node.RepeatCount, Mode=TwoWay}"/>
     </StackPanel>
     <StackPanel Margin="0,10,0,0" Visibility="{Binding Advanced.CanEditPath, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}"><TextBlock Text="资源位置"/><ui:TextBox Margin="0,6,0,0" Text="{Binding Node.Path, Mode=TwoWay}"/></StackPanel>
     <WrapPanel Margin="0,10,0,0"><TextBlock Text="{Binding Node.ResourceVersionText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ui:Button Content="更新此任务资源" Command="{Binding Session.UpdateResourceVersionCommand, Mode=OneWay}" CommandParameter="{Binding Node, Mode=OneWay}" Visibility="{Binding Node.CanUpdateResourceVersion, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}"/>
     </WrapPanel>
    </StackPanel></ui:Card>
    <!-- 共享设置：队伍、战斗、拾取、行走等逐项修改，立即生效；分组或引用上的修改会传给下面所有任务。 -->
    <ui:Card Style="{StaticResource DragonCard}" Visibility="{Binding Advanced.CanEditSharedSettings, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}"><StackPanel>
     <TextBlock Text="共享设置" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Advanced.SharedSettingsSummary, Mode=OneWay}" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <WrapPanel><ui:Button Content="配置共享设置" Command="{Binding Advanced.EditSharedSettingsCommand, Mode=OneWay}"/></WrapPanel>
    </StackPanel></ui:Card>
    <ui:Card Style="{StaticResource DragonCard}" Visibility="{Binding Advanced.CanEditParameters, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}"><StackPanel>
     <TextBlock Text="任务参数" FontWeight="SemiBold"/><TextBlock Text="只属于此步骤的参数；清空后使用任务默认值，共享设置不受影响。" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     <WrapPanel><ui:Button Content="清空本任务参数" Command="{Binding Advanced.RestoreParameterInheritanceCommand, Mode=OneWay}"/></WrapPanel>
    </StackPanel></ui:Card>
    <!-- 运行配置由主面板的设置卡片即时提交；此处只保留高级来源与参数 JSON。 -->
    <ui:Card Style="{StaticResource DragonCard}"><Expander Header="高级配置与有效来源"><StackPanel Margin="0,12,0,0">
     <StackPanel Visibility="{Binding Advanced.CanEditParameters, Mode=OneWay, Converter={StaticResource DragonBoolVisibility}}">
      <TextBlock Text="{Binding Advanced.ParameterEditorTitle, Mode=OneWay}" FontWeight="SemiBold"/><TextBox Margin="0,6,0,0" MinHeight="100" AcceptsReturn="True" FontFamily="Consolas" Text="{Binding Advanced.ParameterJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
      <ui:Button Content="应用参数 JSON" Command="{Binding Advanced.ApplyParametersCommand, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,8,0,12"/>
     </StackPanel>
     <TextBlock Text="共享设置（JSON 对象，设置项 ID 到值）" FontWeight="SemiBold"/><TextBox Margin="0,6,0,0" MinHeight="80" AcceptsReturn="True" FontFamily="Consolas" Text="{Binding Advanced.SettingsJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
     <ui:Button Content="应用共享设置" Command="{Binding Advanced.ApplySettingsCommand, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,8,0,12"/>
     <TextBlock Text="执行策略" FontWeight="SemiBold"/><TextBox MinHeight="80" AcceptsReturn="True" FontFamily="Consolas" Text="{Binding Advanced.PolicyJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
     <ui:Button Content="应用策略" Command="{Binding Advanced.ApplyPolicyCommand, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,8,0,12"/>
     <TextBlock Text="引用来源" FontWeight="SemiBold"/><TextBox MinHeight="80" AcceptsReturn="True" FontFamily="Consolas" Text="{Binding Advanced.SourceJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"/>
     <ui:Button Content="应用来源" Command="{Binding Advanced.ApplySourceCommand, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,8,0,12"/>
     <TextBlock Text="有效参数与来源" FontWeight="SemiBold"/>
     <ItemsControl ItemsSource="{Binding Advanced.EffectiveParameters, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,0">
      <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source, Mode=OneWay, StringFormat=来源：{0}}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Expander></ui:Card>
    <TextBlock Text="{Binding Advanced.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
    <TextBlock Text="{Binding Document.LastSaveError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
   </StackPanel>
  </ScrollViewer>
  <ui:Card Grid.Row="2" Padding="20,12"><Grid><TextBlock Text="应用后自动保存；配置变更可在一条龙中撤销。" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:Button Content="完成" IsCancel="True" HorizontalAlignment="Right"/></Grid></ui:Card>
 </Grid>
</ui:FluentWindow>
