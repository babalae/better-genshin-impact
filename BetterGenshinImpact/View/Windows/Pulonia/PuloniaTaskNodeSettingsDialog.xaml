<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaTaskNodeSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle}"
                 Width="760"
                 Height="760"
                 MinWidth="580"
                 MinHeight="500"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <!--  分区标题  -->
        <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>
        <!--  高级设置中的原始 JSON 编辑框  -->
        <Style x:Key="JsonEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="{ui:SymbolIcon Edit24}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <!--  计划自动保存失败提示：仅在 LastSaveError 有值时显示，固定在内容区顶部，不随滚动隐藏  -->
        <ui:InfoBar Grid.Row="1"
                    Margin="24,8,24,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{Binding Document.LastSaveError, Mode=OneWay, StringFormat='修改仍保留在当前计划中，下次编辑后会自动重试保存。原因：{0}'}"
                    Severity="Error"
                    Title="任务计划保存失败">
            <ui:InfoBar.Style>
                <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                    <!--  没有保存错误时整体折叠，连同外边距一起不占位  -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Document.LastSaveError, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:InfoBar.Style>
        </ui:InfoBar>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">
                <!--  概览：任务名称、类型与启用开关  -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Symbol="TaskListLtr24" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding Node.Name}"
                                      TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Margin="0,2,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding Node.TypeDisplayName}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                     OffContent="已停用"
                                     OnContent="已启用"
                                     ToolTip="停用后运行计划时跳过此任务" />
                </Grid>

                <!--  基本  -->
                <ui:TextBlock Style="{StaticResource SectionTitle}" Text="基本" />
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Rename24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="任务名称" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="显示在任务计划中的名称"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="240"
                                Margin="0,0,36,0"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                Visibility="{Binding CanConfigureRepeat, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="执行次数" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="按顺序完整执行组内全部任务的轮数"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Width="150"
                                  Margin="0,0,36,0"
                                  AcceptsExpression="False"
                                  ClearButtonEnabled="False"
                                  LargeChange="5"
                                  MaxDecimalPlaces="0"
                                  Maximum="10000"
                                  Minimum="1"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Inline"
                                  Value="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <behavior:NumberBoxValueConstraintBehavior EmptyValue="1" MinimumValue="1" />
                        </b:Interaction.Behaviors>
                    </ui:NumberBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon Folder24}"
                                Visibility="{Binding CanEditPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="资源路径" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="本地路线、脚本或录制文件的位置"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="300"
                                Margin="0,0,36,0"
                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Visibility="{Binding CanUpdateResourceVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="资源版本" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="{Binding Node.ResourceVersionText, StringFormat=当前使用：{0}}"
                                          TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Margin="0,0,36,0"
                               Command="{Binding Session.UpdateResourceVersionCommand, Mode=OneWay}"
                               CommandParameter="{Binding Node}"
                               Content="更新资源"
                               ToolTip="读取本机仓库的最新内容，确认后立即生效" />
                </ui:CardControl>

                <!--  独立任务设置：优先使用独立任务的专属设置界面  -->
                <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="任务设置" />
                    <ui:TextBlock Margin="0,-4,0,10"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="仅对这个任务生效；未修改的项沿用任务默认值。"
                                  TextWrapping="Wrap" />
                    <controls:PuloniaTaskSettingsEditorView DataContext="{Binding Settings}" />
                </StackPanel>

                <!--  JS 脚本自定义设置：按项目 settings_ui 在独立窗口中编辑，确认后立即生效  -->
                <StackPanel Visibility="{Binding HasTaskTools, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="任务设置" />
                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Code24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="脚本自定义设置" />
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="{Binding Advanced.ScriptSettingsSummary, Mode=OneWay}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Margin="0,0,36,0"
                                   Command="{Binding Advanced.EditScriptSettingsCommand, Mode=OneWay}"
                                   Content="配置" />
                    </ui:CardControl>
                </StackPanel>

                <!--  共享设置：队伍、战斗、拾取、行走、路线 CD 与 Shell，在独立窗口中逐项修改，立即生效并向下传播  -->
                <StackPanel Visibility="{Binding Advanced.CanEditSharedSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="共享设置" />
                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Settings24}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="队伍、战斗、拾取与行走等" />
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="{Binding Advanced.SharedSettingsSummary, Mode=OneWay}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Margin="0,0,36,0"
                                   Command="{Binding Advanced.EditSharedSettingsCommand, Mode=OneWay}"
                                   Content="配置" />
                    </ui:CardControl>
                </StackPanel>

                <!--  高级设置：原始数据编辑，点击各自的“应用”后立即生效  -->
                <ui:CardExpander Margin="0,16,0,0"
                                 ContentPadding="16"
                                 Icon="{ui:SymbolIcon Code24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="高级设置" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="原始任务参数、共享设置与执行策略，点击“应用”后立即生效"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <!--  原始任务参数（仅叶子）  -->
                        <StackPanel Visibility="{Binding Advanced.CanEditParameters, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Advanced.ParameterEditorTitle, Mode=OneWay}" />
                            <TextBox Style="{StaticResource JsonEditor}"
                                     Text="{Binding Advanced.ParameterJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Margin="0,6,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Command="{Binding Advanced.RestoreParameterInheritanceCommand, Mode=OneWay}"
                                           Content="清空本任务参数"
                                           ToolTip="删除本任务单独设置的任务参数，恢复使用能力默认值；共享设置不受影响" />
                                <ui:Button Command="{Binding Advanced.ApplyParametersCommand, Mode=OneWay}" Content="应用参数" />
                            </StackPanel>
                        </StackPanel>

                        <!--  原始共享设置  -->
                        <ui:TextBlock Margin="0,16,0,0"
                                      FontTypography="BodyStrong"
                                      Text="共享设置（JSON 对象，设置项 ID 到值）" />
                        <TextBox Style="{StaticResource JsonEditor}"
                                 Text="{Binding Advanced.SettingsJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Command="{Binding Advanced.ApplySettingsCommand, Mode=OneWay}"
                                   Content="应用共享设置" />

                        <!--  执行策略  -->
                        <ui:TextBlock Margin="0,16,0,0"
                                      FontTypography="BodyStrong"
                                      Text="执行策略" />
                        <TextBox Style="{StaticResource JsonEditor}"
                                 Text="{Binding Advanced.PolicyJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Command="{Binding Advanced.ApplyPolicyCommand, Mode=OneWay}"
                                   Content="应用策略" />

                        <!--  引用来源（仅计划或目录引用）  -->
                        <StackPanel Visibility="{Binding Advanced.HasSource, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Margin="0,16,0,0"
                                          FontTypography="BodyStrong"
                                          Text="引用来源" />
                            <TextBox Style="{StaticResource JsonEditor}"
                                     Text="{Binding Advanced.SourceJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       Command="{Binding Advanced.ApplySourceCommand, Mode=OneWay}"
                                       Content="应用来源" />
                        </StackPanel>

                        <!--  最终生效的参数及其来源  -->
                        <StackPanel Visibility="{Binding Node.IsLeaf, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Margin="0,16,0,6"
                                          FontTypography="BodyStrong"
                                          Text="最终生效的参数" />
                            <ItemsControl ItemsSource="{Binding Advanced.EffectiveParameters, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Source, StringFormat=来源：{0}}" />
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{Binding Advanced.Message, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!--  底部操作栏  -->
        <Border Grid.Row="3"
                Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="96"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding SaveCommand}"
                               Content="保存" />
                    <ui:Button MinWidth="96"
                               Command="{Binding CancelCommand}"
                               Content="取消"
                               IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
