<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaTaskNodeSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding WindowTitle}"
                 Width="760"
                 Height="760"
                 MinWidth="580"
                 MinHeight="500"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <!--  分区标题  -->
        <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>
        <!--  高级设置中的原始 JSON 编辑框  -->
        <Style x:Key="JsonEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Icon="{ui:SymbolIcon Edit24}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">
                <!--  概览：任务名称、类型与启用开关  -->
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44"
                            Height="44"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Symbol="TaskListLtr24" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="14,0,12,0"
                                VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="Subtitle"
                                      Text="{Binding Node.Name}"
                                      TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Margin="0,2,0,0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding Node.TypeDisplayName}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="2"
                                     VerticalAlignment="Center"
                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                     OffContent="已停用"
                                     OnContent="已启用"
                                     ToolTip="停用后运行计划时跳过此任务" />
                </Grid>

                <!--  基本  -->
                <ui:TextBlock Style="{StaticResource SectionTitle}" Text="基本" />
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Rename24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="任务名称" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="显示在任务计划中的名称"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="240"
                                Margin="0,0,36,0"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                Visibility="{Binding CanConfigureRepeat, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="执行次数" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="按顺序完整执行组内全部任务的轮数"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox Width="150"
                                  Margin="0,0,36,0"
                                  AcceptsExpression="False"
                                  ClearButtonEnabled="False"
                                  LargeChange="5"
                                  MaxDecimalPlaces="0"
                                  Maximum="10000"
                                  Minimum="1"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Inline"
                                  Value="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <b:Interaction.Behaviors>
                            <behavior:NumberBoxValueConstraintBehavior EmptyValue="1" MinimumValue="1" />
                        </b:Interaction.Behaviors>
                    </ui:NumberBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon Folder24}"
                                Visibility="{Binding CanEditPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="资源路径" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="本地路线、脚本或录制文件的位置"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox Width="300"
                                Margin="0,0,36,0"
                                Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Visibility="{Binding CanUpdateResourceVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="资源版本" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="{Binding Node.ResourceVersionText, StringFormat=当前使用：{0}}"
                                          TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Margin="0,0,36,0"
                               Command="{Binding Session.UpdateResourceVersionCommand, Mode=OneWay}"
                               CommandParameter="{Binding Node}"
                               Content="更新资源"
                               ToolTip="读取本机仓库的最新内容，确认后立即生效" />
                </ui:CardControl>

                <!--  独立任务设置：优先使用独立任务的专属设置界面  -->
                <StackPanel Visibility="{Binding HasSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="任务设置" />
                    <ui:TextBlock Margin="0,-4,0,10"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="仅对这个任务生效；未修改的项沿用默认或分组设置。"
                                  TextWrapping="Wrap" />
                    <controls:PuloniaTaskSettingsEditorView DataContext="{Binding Settings}" />
                </StackPanel>

                <!--  其他任务的专用设置入口（在独立窗口中确认后立即生效）  -->
                <StackPanel Visibility="{Binding HasTaskTools, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock Style="{StaticResource SectionTitle}" Text="任务设置" />
                    <ui:CardControl Margin="0,0,0,8"
                                    Icon="{ui:SymbolIcon Settings24}"
                                    Visibility="{Binding Advanced.CanEditCommonSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="行走、战斗与执行" />
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="分组中的设置会被同类子任务继承，确认后立即生效"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <WrapPanel Margin="0,0,36,0" HorizontalAlignment="Right">
                            <ui:Button Margin="8,2,0,2"
                                       Command="{Binding Advanced.EditCommonSettingsCommand, Mode=OneWay}"
                                       CommandParameter="pathing"
                                       Content="地图追踪"
                                       Visibility="{Binding Advanced.CanEditPathingSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Margin="8,2,0,2"
                                       Command="{Binding Advanced.EditCommonSettingsCommand, Mode=OneWay}"
                                       CommandParameter="javascript"
                                       Content="JS 脚本"
                                       Visibility="{Binding Advanced.CanEditJavaScriptSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Margin="8,2,0,2"
                                       Command="{Binding Advanced.EditCommonSettingsCommand, Mode=OneWay}"
                                       CommandParameter="shell"
                                       Content="Shell"
                                       Visibility="{Binding Advanced.CanEditShellSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                    </ui:CardControl>
                    <ui:CardControl Margin="0,0,0,8"
                                    Icon="{ui:SymbolIcon History24}"
                                    Visibility="{Binding Advanced.CanEditCollectionCooldown, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="采集 CD" />
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="{Binding Advanced.CollectionCooldownSummary, Mode=OneWay}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Margin="0,0,36,0"
                                   Command="{Binding Advanced.EditCollectionCooldownCommand, Mode=OneWay}"
                                   Content="配置" />
                    </ui:CardControl>
                </StackPanel>

                <!--  高级设置：原始数据编辑，点击各自的“应用”后立即生效  -->
                <ui:CardExpander Margin="0,16,0,0"
                                 ContentPadding="16"
                                 Icon="{ui:SymbolIcon Code24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="高级设置" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="参数预设、原始参数与执行策略，点击“应用”后立即生效"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <!--  参数预设  -->
                        <StackPanel Visibility="{Binding Advanced.CanSelectPreset, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock FontTypography="BodyStrong" Text="参数预设" />
                            <ui:TextBlock Margin="0,2,0,0"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="跨计划复用同类任务的一组参数；本任务单独设置的参数优先"
                                          TextWrapping="Wrap" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding Advanced.PresetOptions, Mode=OneWay}"
                                          SelectedItem="{Binding Advanced.SelectedPresetOption, Mode=TwoWay}" />
                                <ui:Button Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Command="{Binding Session.RefreshPresetsCommand, Mode=OneWay}"
                                           Content="刷新" />
                            </Grid>
                        </StackPanel>

                        <!--  原始参数  -->
                        <ui:TextBlock Margin="0,16,0,0"
                                      FontTypography="BodyStrong"
                                      Text="{Binding Advanced.ParameterEditorTitle, Mode=OneWay}" />
                        <TextBox Style="{StaticResource JsonEditor}"
                                 Text="{Binding Advanced.ParameterJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding Advanced.RestoreParameterInheritanceCommand, Mode=OneWay}"
                                       Content="清空本任务参数"
                                       ToolTip="删除本任务单独设置的参数，恢复使用默认值、预设和分组设置"
                                       Visibility="{Binding Advanced.CanSelectPreset, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button Command="{Binding Advanced.ApplyParametersCommand, Mode=OneWay}" Content="应用参数" />
                        </StackPanel>

                        <!--  执行策略  -->
                        <ui:TextBlock Margin="0,16,0,0"
                                      FontTypography="BodyStrong"
                                      Text="执行策略" />
                        <TextBox Style="{StaticResource JsonEditor}"
                                 Text="{Binding Advanced.PolicyJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Command="{Binding Advanced.ApplyPolicyCommand, Mode=OneWay}"
                                   Content="应用策略" />

                        <!--  引用来源（仅计划或目录引用）  -->
                        <StackPanel Visibility="{Binding Advanced.HasSource, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Margin="0,16,0,0"
                                          FontTypography="BodyStrong"
                                          Text="引用来源" />
                            <TextBox Style="{StaticResource JsonEditor}"
                                     Text="{Binding Advanced.SourceJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       Command="{Binding Advanced.ApplySourceCommand, Mode=OneWay}"
                                       Content="应用来源" />
                        </StackPanel>

                        <!--  最终生效的参数及其来源  -->
                        <StackPanel Visibility="{Binding Node.IsLeaf, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Margin="0,16,0,6"
                                          FontTypography="BodyStrong"
                                          Text="最终生效的参数" />
                            <ItemsControl ItemsSource="{Binding Advanced.EffectiveParameters, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Source, StringFormat=来源：{0}}" />
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{Binding Advanced.Message, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardExpander>

                <TextBlock Margin="0,10,0,0"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding Document.LastSaveError, Mode=OneWay, StringFormat=最近保存失败：{0}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!--  底部操作栏  -->
        <Border Grid.Row="2"
                Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button MinWidth="96"
                               Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding SaveCommand}"
                               Content="保存" />
                    <ui:Button MinWidth="96"
                               Command="{Binding CancelCommand}"
                               Content="取消"
                               IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
