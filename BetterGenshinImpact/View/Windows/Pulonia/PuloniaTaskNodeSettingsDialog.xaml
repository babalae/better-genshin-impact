<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.Pulonia.PuloniaTaskNodeSettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="编辑节点配置"
                 Width="680"
                 Height="720"
                 MinWidth="560"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="编辑节点配置"
                     Icon="{ui:SymbolIcon Edit24}" />

        <ScrollViewer Grid.Row="1"
                      Margin="18,10,18,12"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,12"
                        Padding="14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedDocument.SelectedNode.Name, TargetNullValue=未选择节点}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding SelectedDocument.SelectedNode.TypeDisplayName}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="节点自身启用"
                                  IsChecked="{Binding SelectedDocument.SelectedNode.IsEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Padding="14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="基本设置" />
                        <TextBlock Margin="0,10,0,3" Text="名称" />
                        <TextBox Text="{Binding SelectedDocument.SelectedNode.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <Grid Margin="0,12,0,0"
                              Visibility="{Binding SelectedDocument.SelectedNode.CanConfigureRepeat, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="执行次数"
                                       ToolTip="按顺序完整执行本分组内的全部任务；1 表示只执行一轮" />
                            <ui:NumberBox Grid.Column="1"
                                          AcceptsExpression="False"
                                          LargeChange="5"
                                          MaxDecimalPlaces="0"
                                          Maximum="10000"
                                          Minimum="1"
                                          SmallChange="1"
                                          SpinButtonPlacementMode="Inline"
                                          Value="{Binding SelectedDocument.SelectedNode.RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Behaviors>
                                    <behavior:NumberBoxValueConstraintBehavior EmptyValue="1" MinimumValue="1" />
                                </b:Interaction.Behaviors>
                            </ui:NumberBox>
                        </Grid>

                        <TextBlock Margin="0,12,0,3" Text="资源定位" />
                        <TextBox IsEnabled="{Binding SelectedDocument.CanEditPath}"
                                 Text="{Binding SelectedDocument.SelectedNode.Path, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding SelectedDocument.SelectedNode.CanUpdateResourceVersion, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="固定资源版本" />
                                <TextBlock Margin="0,2,8,0"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding SelectedDocument.SelectedNode.ResourceVersionText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedDocument.SelectedNode.ResourceVersionText}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Padding="8,3"
                                       VerticalAlignment="Center"
                                       Command="{Binding UpdateResourceVersionCommand}"
                                       CommandParameter="{Binding SelectedDocument.SelectedNode}"
                                       Content="检查更新" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="参数预设（跨计划复用）"
                                       ToolTip="复用相同任务类型和资源的一组参数；节点或分组中的显式设置优先" />
                            <ui:Button Grid.Column="1"
                                       Padding="7,2"
                                       Command="{Binding RefreshPresetsCommand}"
                                       Content="刷新" />
                        </Grid>
                        <ComboBox DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding SelectedDocument.CanSelectPreset}"
                                  ItemsSource="{Binding SelectedDocument.PresetOptions}"
                                  SelectedItem="{Binding SelectedDocument.SelectedPresetOption, Mode=TwoWay}"
                                  ToolTip="预设只复用参数，不包含任务结构、顺序或计划引用" />

                        <TextBlock Margin="0,14,0,3"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedDocument.ParameterEditorTitle}" />
                        <TextBox MinHeight="112"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedDocument.ParameterJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalScrollBarVisibility="Auto" />
                        <ui:Button Margin="0,5,0,0"
                                   HorizontalAlignment="Right"
                                   Padding="10,4"
                                   Command="{Binding SelectedDocument.ApplyParametersCommand}"
                                   Content="应用参数" />

                        <Expander Margin="0,12,0,0" Header="执行策略">
                            <StackPanel>
                                <TextBox MinHeight="90"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedDocument.PolicyJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                                <ui:Button Margin="0,5,0,0"
                                           HorizontalAlignment="Right"
                                           Padding="10,4"
                                           Command="{Binding SelectedDocument.ApplyPolicyCommand}"
                                           Content="应用策略" />
                            </StackPanel>
                        </Expander>

                        <Expander Margin="0,8,0,0" Header="引用来源">
                            <StackPanel>
                                <TextBox MinHeight="90"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedDocument.SourceJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                                <ui:Button Margin="0,5,0,0"
                                           HorizontalAlignment="Right"
                                           Padding="10,4"
                                           Command="{Binding SelectedDocument.ApplySourceCommand}"
                                           Content="应用来源" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="有效参数与来源" />
                        <ItemsControl ItemsSource="{Binding SelectedDocument.EffectiveParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,5"
                                            Padding="8"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontFamily="Consolas"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Source, StringFormat=来源：{0}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="这里预览共享预设、父组覆盖和节点显式参数的最终结果。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{Binding SelectedDocument.EditorMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Text="{Binding SelectedDocument.LastSaveError, StringFormat=最近保存失败：{0}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="18,12"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="修改会立即写入当前草稿，并继续使用任务计划的自动保存与撤销。" />
                <ui:Button HorizontalAlignment="Right"
                           MinWidth="82"
                           Appearance="Primary"
                           Content="完成"
                           IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
