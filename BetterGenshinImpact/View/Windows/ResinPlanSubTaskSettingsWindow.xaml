<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.ResinPlanSubTaskSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title, Mode=OneWay}" Width="600" Height="680" MinWidth="480" MinHeight="360"
                 WindowStartupLocation="CenterOwner" WindowBackdropType="Auto" ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{DynamicResource TextThemeFontFamily}" FontSize="14" UseLayoutRounding="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 通用参数卡片模板属于窗口本身，不依赖打开它的页面资源。 -->
                <ResourceDictionary Source="/BetterGI;component/View/Controls/PuloniaOneDragonParameterResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ResinPlanDialogButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Title, Mode=OneWay}" ShowMinimize="False" ShowMaximize="False" />

        <!-- 子任务设置卡片：与一条龙通用设置卡片一致 -->
        <ScrollViewer Grid.Row="1" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl Focusable="False"
                              ItemTemplate="{StaticResource OneDragonParameterFieldTemplate}"
                              ItemsSource="{Binding Fields, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部：校验提示与确认按钮 -->
        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{Binding ValidationMessage, Mode=OneWay}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="确定" Style="{StaticResource ResinPlanDialogButton}" Appearance="Primary" IsDefault="True"
                               Click="Confirm_Click" Margin="0,0,8,0" />
                    <ui:Button Content="取消" Style="{StaticResource ResinPlanDialogButton}" IsCancel="True" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
