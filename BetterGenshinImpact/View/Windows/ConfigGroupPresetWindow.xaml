<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.ConfigGroupPresetWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:markdown="clr-namespace:BetterGenshinImpact.View.Controls.Markdown"
                 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
                 Title="{i18n:T 内置预制菜}"
                 Width="960"
                 Height="640"
                 MinWidth="760"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{i18n:T 内置预制菜}">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="AppsList24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="4,2,4,8"
                               FontWeight="SemiBold"
                               Text="{i18n:T 选择预制菜}" />
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Version}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Text="{i18n:T 请从左侧选择一个预制菜}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedPreset.Name}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SelectedPreset.Version, StringFormat=版本：{0}}" />
                        <TextBlock Grid.Row="2"
                                   Margin="0,10,0,10"
                                   Text="{Binding SelectedPreset.Description}"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Row="3" Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" Text="{i18n:T 依赖}" />
                            <ItemsControl Margin="0,4,0,0"
                                          ItemsSource="{Binding SelectedPreset.Manifest.Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Type}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Name}" />
                                            <Run Text="{Binding MinVersion, StringFormat=（最低版本 ≥ {0}）}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <markdown:MarkdownView Grid.Row="4"
                                               FilePath="{Binding SelectedPreset.ReadmePath}"
                                               BasePath="{Binding SelectedPreset.DirectoryPath}"
                                               Background="Transparent"
                                               LinkNavigationMode="SystemDefault"
                                               PresentationDelay="0:0:0.25" />
                        <ui:Button Grid.Row="5"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Left"
                                   Command="{Binding ApplyPresetCommand}"
                                   Content="{i18n:T 应用预制菜}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
