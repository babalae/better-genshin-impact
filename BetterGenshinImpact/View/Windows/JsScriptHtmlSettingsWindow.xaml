<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.JsScriptHtmlSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Title="{Binding Title, Mode=OneWay}"
                 Width="760"
                 Height="640"
                 MinWidth="480"
                 MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:JsScriptHtmlSettingsWindowViewModel}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title, Mode=OneWay}"
                     Icon="{ui:SymbolIcon Settings24}"
                     ShowMinimize="False" />

        <!--  页面加载失败或网页进程退出时显示；放在页面上方的独立行，避免被原生 WebView 遮住  -->
        <ui:InfoBar Grid.Row="1"
                    Margin="12,0,12,8"
                    IsClosable="False"
                    IsOpen="{Binding HasError, Mode=OneWay}"
                    Message="{Binding ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="设置页无法正常显示">
            <ui:InfoBar.Style>
                <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:InfoBar.Style>
        </ui:InfoBar>

        <!--  脚本作者实现的设置页，占满其余区域  -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
