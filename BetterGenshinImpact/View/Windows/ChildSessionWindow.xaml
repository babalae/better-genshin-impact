<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.ChildSessionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModel="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
                 Title="BetterGI 桌面分身"
                 Width="1280"
                 Height="752"
                 MinWidth="415"
                 MinHeight="90"
                 d:DataContext="{d:DesignInstance Type=viewModel:ChildSessionWindowViewModel}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 ResizeMode="CanResize"
                 Topmost="{Binding IsTopmost, Mode=OneWay}"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">
    <Grid x:Name="RootGrid"
          Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar"
                     Grid.Row="0"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Height="32"
                     VerticalContentAlignment="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/logo.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <b:Interaction.Behaviors>
                        <behavior:WindowDragBehavior />
                    </b:Interaction.Behaviors>
                    <Ellipse Width="9"
                             Height="9"
                             Margin="0,0,8,0"
                             Fill="{Binding ConnectionStatusBrush}"
                             ToolTip="{Binding ConnectionStatusToolTip}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="BetterGI 桌面分身" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel VerticalAlignment="Top"
                            IsEnabled="{Binding IsSessionInteractionEnabled}"
                            Orientation="Horizontal">
                    <b:Interaction.Behaviors>
                        <behavior:ResponsiveTitleBarBehavior />
                    </b:Interaction.Behaviors>
                    <ui:Button Width="80"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behavior:ResponsiveTitleBarBehavior.CollapseOrder="1"
                               Command="{Binding StartCommand}"
                               Content="启动"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon Play24}"
                               ToolTip="启动并连接 BetterGI 桌面分身" />
                    <ui:Button Width="80"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behavior:ResponsiveTitleBarBehavior.CollapseOrder="2"
                               Command="{Binding HideCommand}"
                               Content="隐藏"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon EyeOff24}"
                               ToolTip="隐藏窗口并保持 RDP 连接" />
                    <ui:Button Width="110"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behavior:ResponsiveTitleBarBehavior.CollapseOrder="3"
                               Command="{Binding SwitchWindowCommand}"
                               Content="切换窗口"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon ArrowSwap24}"
                               ToolTip="向桌面分身发送 Win+Tab" />
                    <ui:Button Width="110"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               behavior:ResponsiveTitleBarBehavior.CollapseOrder="4"
                               Command="{Binding ToggleGameMouseModeCommand}"
                               Content="{Binding GameMouseModeButtonText}"
                               CornerRadius="0"
                               ToolTip="{Binding GameMouseModeButtonToolTip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Setter Property="Symbol"
                                                Value="Cursor24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameMouseModeEnabled}"
                                                         Value="True">
                                                <Setter Property="Symbol"
                                                        Value="Target24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:DropDownButton Width="120"
                                       Height="32"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       Content="控制中心"
                                       CornerRadius="0"
                                       Icon="{ui:SymbolIcon AppsList24}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <ui:MenuItem Header="运行 BetterGI"
                                             Command="{Binding LaunchBetterGiCommand}" />
                                <ui:MenuItem Header="{Binding WindowSizeModeMenuHeader}"
                                             Command="{Binding ToggleSmallWindowModeCommand}"
                                             ToolTip="{Binding WindowSizeModeMenuToolTip}" />
                                <Separator />
                                <ui:MenuItem Header="桌面分辨率">
                                    <ui:MenuItem Header="1920 × 1080"
                                                 Command="{Binding SelectDefaultResolutionCommand}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsDefaultResolutionSelected, Mode=OneWay}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="窗口">
                                    <ui:MenuItem Header="自适应"
                                                 Command="{Binding UseAdaptiveCommand}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsAdaptive, Mode=OneWay}" />
                                    <ui:MenuItem Header="1 : 1"
                                                 Command="{Binding UseOneToOneCommand}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding IsOneToOne, Mode=OneWay}" />
                                    <Separator />
                                    <ui:MenuItem Header="保持宽高比"
                                                 Command="{Binding ToggleKeepAspectRatioCommand}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding KeepAspectRatio, Mode=OneWay}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="快捷键">
                                    <ui:MenuItem Header="系统组合键发送到桌面分身"
                                                 Command="{Binding ToggleSendSystemShortcutsToRemoteCommand}"
                                                 IsCheckable="True"
                                                 IsChecked="{Binding SendSystemShortcutsToRemote, Mode=OneWay}"
                                                 ToolTip="勾选后，Alt+Tab、Windows 键等系统组合键发送到桌面分身；取消勾选后在本机生效。切换时会自动重新连接 RDP。" />
                                    <Separator />
                                    <ui:MenuItem Header="发送 Win+D 显示桌面"
                                                 Command="{Binding ShowDesktopCommand}" />
                                    <ui:MenuItem Header="发送 Win+Tab 切换窗口"
                                                 Command="{Binding ShowTaskViewCommand}" />
                                </ui:MenuItem>
                                <ui:MenuItem Header="更多">
                                    <ui:MenuItem Header="以管理员权限启动…"
                                                 Command="{Binding LaunchExecutableCommand}"
                                                 Icon="{ui:SymbolIcon Shield24}" />
                                </ui:MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding ToggleAudioMutedCommand}"
                               CornerRadius="0"
                               ToolTip="{Binding AudioButtonToolTip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Setter Property="Symbol"
                                                Value="Speaker224" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAudioMuted}"
                                                         Value="True">
                                                <Setter Property="Symbol"
                                                        Value="SpeakerOff24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                                   BorderBrush="Transparent"
                                   Command="{Binding ToggleTopmostCommand}"
                                   CornerRadius="0"
                                   Icon="{ui:SymbolIcon PinOff24}"
                                   ToolTip="{Binding TopmostButtonToolTip}"
                                   Visibility="{Binding IsTopmost, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                                   BorderBrush="Transparent"
                                   Command="{Binding ToggleTopmostCommand}"
                                   CornerRadius="0"
                                   Icon="{ui:SymbolIcon Pin24}"
                                   ToolTip="{Binding TopmostButtonToolTip}"
                                   Visibility="{Binding IsTopmost, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Popup Width="{Binding ActualWidth, ElementName=RootGrid}"
               AllowsTransparency="True"
               IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=WindowTitleBar}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Grid Background="Transparent">
                <Border MaxWidth="720"
                        Margin="8"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="8">
                    <ui:InfoBar Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                IsClosable="True"
                                IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}"
                                Message="{Binding NotificationMessage}"
                                Severity="{Binding NotificationSeverity}"
                                Title="{Binding NotificationTitle}" />
                </Border>
            </Grid>
        </Popup>

        <Grid Grid.Row="1"
              Background="Black">
            <b:Interaction.Behaviors>
                <behavior:WindowResizeBehavior AspectRatio="1.7777777777777777"
                                               ResizeRequest="{Binding SmallWindowResizeRequest}"
                                               TargetWidth="{Binding WindowResizeTargetWidth}" />
            </b:Interaction.Behaviors>
            <wfi:WindowsFormsHost x:Name="RdpFormsHost"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding IsConnectionPromptVisible, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                <b:Interaction.Behaviors>
                    <behavior:WindowAspectRatioBehavior AspectRatio="1.7777777777777777"
                                                        IsEnabled="{Binding KeepAspectRatio}" />
                </b:Interaction.Behaviors>
                <wfi:WindowsFormsHost.Style>
                    <Style TargetType="{x:Type wfi:WindowsFormsHost}">
                        <!-- 为父窗口保留命中测试区域，避免 RDP 的子 HWND 截获窗口边缘鼠标消息 -->
                        <Setter Property="Margin"
                                Value="3,0,3,3" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                Value="Maximized">
                                <Setter Property="Margin"
                                        Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </wfi:WindowsFormsHost.Style>
            </wfi:WindowsFormsHost>

            <Grid Margin="24"
                  Visibility="{Binding IsConnectionPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border MaxWidth="620"
                        Padding="36,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF171717"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <Border Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Background="#262FA4E7"
                                CornerRadius="36"
                                Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                            <ui:SymbolIcon FontSize="34"
                                           Foreground="#FF60B9F4"
                                           Symbol="DesktopCursor24" />
                        </Border>

                        <Border Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Background="#26FFB900"
                                CornerRadius="36"
                                Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing Width="34"
                                             Height="34"
                                             Foreground="#FFFFC83D"
                                             IsIndeterminate="True" />
                        </Border>

                        <StackPanel Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding ConnectionStatusBrush}" />
                            <TextBlock FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding ConnectionStatusTitle}" />
                        </StackPanel>

                        <TextBlock MaxWidth="510"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#BFFFFFFF"
                                   Text="{Binding ConnectionStatusDescription}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,22,0,0"
                                Padding="16,12"
                                Background="#10000000"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel>
                                <TextBlock Foreground="#E6FFFFFF"
                                           Text="{Binding RdpStatusText}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#99FFFFFF"
                                           Text="{Binding ChildSessionStatusText}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#70FFFFFF"
                                           FontSize="11"
                                           Text="{Binding ConnectionStatusToolTip}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,24,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                            <ui:Button MinWidth="132"
                                       Command="{Binding StartCommand}"
                                       Content="启动并连接"
                                       Icon="{ui:SymbolIcon Play24}" />
                            <ui:HyperlinkButton Margin="16,0,0,0"
                                                Padding="8,6"
                                                Command="{Binding OpenDesktopHelpCommand}"
                                                Content="查看帮助文档"
                                                Cursor="Hand" />
                        </StackPanel>

                        <TextBlock Margin="0,24,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#CCFFFFFF"
                                   Text="请稍候，关闭完成后窗口会自动隐藏。"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="#80FFFFFF"
                                       FontSize="11"
                                       Text="连接成功后，此处会自动切换为桌面分身画面。"
                                       TextAlignment="Center" />
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="#80FFFFFF"
                                       FontSize="11"
                                       Text="游戏鼠标模式下，按住 Alt 可临时释放并显示本地鼠标。"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#80FFFFFF"
                                   FontSize="11"
                                   Text="关闭期间已暂停所有桌面分身操作，以避免状态冲突。"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsSessionClosing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
