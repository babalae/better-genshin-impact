<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.SoloTaskInstanceWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title}"
                 Width="500"
                 MinWidth="460"
                 Height="334"
                 MinHeight="300"
                 MaxHeight="500"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding Title}"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Icon="{ui:SymbolIcon PlayCircle24}" />

        <Grid Grid.Row="1" Margin="18,2,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="每个实例只能运行一个独立任务，可逐个启动或停止。"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsOperationPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ProgressRing Width="14"
                                 Height="14"
                                 IsIndeterminate="True" />
                <TextBlock Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="处理中" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="18,0,18,8"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Instances}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="10,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="7">
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Symbol="{Binding InstanceIcon}" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding StatusText}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Text="{Binding DetailText}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DetailText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           MinWidth="76"
                                           Height="32"
                                           Padding="12,4"
                                           Content="{Binding ActionText}"
                                           IsEnabled="{Binding CanOperate}"
                                           Command="{Binding DataContext.ToggleInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                           CommandParameter="{Binding}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionText}" Value="停止">
                                                    <Setter Property="Appearance" Value="Secondary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="18,8,18,14"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ui:Button HorizontalAlignment="Right"
                       MinWidth="72"
                       Height="32"
                       Content="关闭"
                       IsCancel="True"
                       Command="{Binding CloseCommand}" />
        </Border>
    </Grid>
</ui:FluentWindow>
