<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.ChildSessionAutoLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
                 Title="{i18n:T 自动登录}"
                 Width="520"
                 Height="430"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 ResizeMode="NoResize"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource ApplicationBackgroundBrush}"
                     Height="32"
                     Title="{i18n:T 自动登录}" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{i18n:T 连接桌面分身时自动填写 Windows 登录密码，省去每次输入。密码用 Windows DPAPI 加密后保存在本机配置里，只能被当前 Windows 账户解开。}"
                              TextWrapping="Wrap" />

                <ui:TextBlock x:Name="AccountText"
                              Margin="0,14,0,0"
                              FontWeight="SemiBold" />

                <ui:ToggleSwitch x:Name="AutoLoginSwitch"
                                 Margin="0,14,0,0"
                                 Content="{i18n:T 启动自动登录}"
                                 Checked="OnAutoLoginSwitchChanged"
                                 Unchecked="OnAutoLoginSwitchChanged" />

                <ui:TextBlock Margin="0,20,0,6"
                              FontWeight="SemiBold"
                              Text="{i18n:T 密码}" />
                <PasswordBox x:Name="PasswordInput"
                             Height="32"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                <!-- 一行说明：前半句讲校验，后半句讲当前账户有没有存过密码。 -->
                <ui:TextBlock x:Name="PasswordHintText"
                              Margin="0,6,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap" />

                <ui:InfoBar x:Name="StatusBar"
                            Margin="0,14,0,0"
                            IsClosable="False"
                            IsOpen="False" />

                <StackPanel Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:Button x:Name="ClearButton"
                               MinWidth="120"
                               Click="OnClearPasswordClicked"
                               Content="{i18n:T 清除已保存密码}" />
                    <ui:Button x:Name="SaveButton"
                               MinWidth="120"
                               Margin="12,0,0,0"
                               Appearance="Primary"
                               Click="OnSavePasswordClicked"
                               Content="{i18n:T 保存密码}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
