<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.AccountRecordsDictionaryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
 Title="{Binding Title, Mode=OneWay}" Width="860" Height="640" MinWidth="620" MinHeight="400"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ui:FluentWindow.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></ui:FluentWindow.Resources>
 <b:Interaction.Triggers><b:EventTrigger EventName="Loaded"><b:InvokeCommandAction Command="{Binding RefreshCommand, Mode=OneWay}" /></b:EventTrigger></b:Interaction.Triggers>
 <ui:FluentWindow.InputBindings><KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" /></ui:FluentWindow.InputBindings>
 <ui:FluentWindow.CommandBindings><CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseWindow" /></ui:FluentWindow.CommandBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="{Binding Title, Mode=OneWay}" ShowMinimize="False" />
  <DockPanel Grid.Row="1" Margin="16,8,16,12">
   <ui:Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand, Mode=OneWay}" Margin="8,0,0,0" />
   <ui:TextBox PlaceholderText="搜索字典" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
  </DockPanel>
  <Grid Grid.Row="2" Margin="16,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <Border Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
    <ListBox ItemsSource="{Binding Entries, Mode=OneWay}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
   </Border>
   <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="16,12,16,16">
   <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" />
   <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
     <CheckBox Content="启用编辑" IsChecked="{Binding EditingEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
     <ui:Button Content="打开源文件编辑…" Margin="12,0,0,0" IsEnabled="{Binding EditingEnabled, Mode=OneWay}" Command="{Binding OpenSourceCommand, Mode=OneWay}" />
    </StackPanel>
    <TextBlock Text="字典由所有 UID 共用。外部保存后点击刷新；编辑不会自动迁移物品名称对应的库存记录。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
   </StackPanel>
  </StackPanel>
 </Grid>
</ui:FluentWindow>