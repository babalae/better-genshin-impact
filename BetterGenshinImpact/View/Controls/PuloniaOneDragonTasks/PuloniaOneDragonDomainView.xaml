<UserControl x:Class="BetterGenshinImpact.View.Controls.PuloniaOneDragonTasks.PuloniaOneDragonDomainView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
 xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
 xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers"
 xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.Pages.Pulonia.OneDragonTasks">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="../PuloniaOneDragonResources.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </UserControl.Resources>
 <!-- 自动秘境：沿用旧一条龙的每日/每周/树脂/分解卡片，字段绑定 builtin.auto_domain 参数。 -->
 <StackPanel>
  <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
   <ui:CardExpander.Header>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="选择战斗策略" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="仅用于本任务的秘境战斗" TextWrapping="Wrap"/>
     <ComboBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="200" Margin="0,0,36,0"
               ItemsSource="{Binding StrategyChoices}" SelectedItem="{Binding StrategyName, Mode=TwoWay}"/>
    </Grid>
   </ui:CardExpander.Header>
  </ui:CardExpander>

  <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
   <ui:CardExpander.Header>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="每日秘境刷取配置" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="前往指定秘境消耗树脂，并自动领取奖励。" TextWrapping="Wrap"/>
    </Grid>
   </ui:CardExpander.Header>
   <StackPanel>
    <Grid Margin="16">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="进入秘境切换的队伍名称" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="注意是游戏内你设置的名称" TextWrapping="Wrap"/>
     <ui:TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" MinWidth="150" MaxWidth="800" Margin="20,0,36,0"
                 Text="{Binding PartyName, Mode=TwoWay}" PlaceholderText="留空则不切换队伍"
                 TextAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
    <Grid Margin="16">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" HorizontalAlignment="Left" Text="选择秘境" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" Text="秘境名称" TextWrapping="Wrap"/>
     <vio:CascadingComboBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="10,0,10,0"
               behavior:DomainCascadingComboBoxBehavior.ClearValue="{Binding DomainName, Mode=TwoWay}"
               behavior:DomainCascadingComboBoxBehavior.UseFullLabelsWhenOpen="True"
               ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
               SelectedCascadingItem="{Binding DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}"/>
     <ui:TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,10,0" FontTypography="Body" HorizontalAlignment="Right" Text="周日或限时" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="2" Margin="10,0,10,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Text="选择序号" TextWrapping="Wrap"/>
     <ComboBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" MinWidth="60" Margin="0,0,36,0"
               HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
               ItemsSource="{x:Static tasksVm:PuloniaOneDragonDomainSettingsViewModel.SundayChoices}"
               SelectedItem="{Binding SundayValue, Mode=TwoWay}"/>
    </Grid>
   </StackPanel>
  </ui:CardExpander>

  <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
   <ui:CardExpander.Header>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="每周秘境刷取配置" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="启用后，每日刷取配置将会失效。" TextWrapping="Wrap"/>
     <ui:ToggleSwitch Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,0,20,0"
                      IsChecked="{Binding WeeklyEnabled, Mode=TwoWay}"/>
    </Grid>
   </ui:CardExpander.Header>
   <StackPanel>
    <ui:TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontTypography="Body" FontSize="12"
                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                  Text="周期始于凌晨 4:00 ，如周一 4:00 至周二 3:59 刷取周一秘境" TextWrapping="Wrap"/>
    <Grid Margin="20,16,20,4">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="80"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="日期" TextAlignment="Center"/>
     <ui:TextBlock Grid.Column="1" Margin="8,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Text="队伍" TextAlignment="Center"/>
     <ui:TextBlock Grid.Column="2" Margin="8,0,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="秘境" TextAlignment="Center"/>
     <ui:TextBlock Grid.Column="3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="奖励" TextAlignment="Center"/>
    </Grid>
    <Grid Margin="20,8,20,16">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="80"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="默认" VerticalAlignment="Center"/>
     <ui:TextBox Grid.Column="1" MinWidth="0" Margin="8,0,8,0" Text="{Binding PartyName, Mode=TwoWay}"
                 TextAlignment="Center" TextWrapping="Wrap" PlaceholderText="留空则不切换队伍"/>
     <vio:CascadingComboBox Grid.Column="2" MinWidth="0" Margin="8,0,8,0" HorizontalAlignment="Stretch"
               behavior:DomainCascadingComboBoxBehavior.ClearValue="{Binding DomainName, Mode=TwoWay}"
               behavior:DomainCascadingComboBoxBehavior.UseFullLabelsWhenOpen="True"
               ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
               SelectedCascadingItem="{Binding DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}"/>
     <ComboBox Grid.Column="3" MinWidth="56" HorizontalContentAlignment="Center"
               ItemsSource="{x:Static tasksVm:PuloniaOneDragonDomainSettingsViewModel.SundayChoices}"
               SelectedItem="{Binding SundayValue, Mode=TwoWay}"/>
    </Grid>
    <!-- 周一至周日各一行；字段留空表示沿用默认行配置。 -->
    <ItemsControl Margin="0,0,0,16" ItemsSource="{Binding Weekdays}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Grid Margin="20,0,20,16">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="56"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>
        <ui:TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{Binding DayName}" VerticalAlignment="Center"/>
        <ui:TextBox Grid.Column="1" MinWidth="0" Margin="8,0,8,0" Text="{Binding PartyName, Mode=TwoWay}"
                    TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" PlaceholderText="留空使用默认队伍"/>
        <vio:CascadingComboBox Grid.Column="2" MinWidth="0" Margin="8,0,8,0" HorizontalAlignment="Stretch"
                  behavior:DomainCascadingComboBoxBehavior.ClearValue="{Binding DomainName, Mode=TwoWay}"
                  behavior:DomainCascadingComboBoxBehavior.UseFullLabelsWhenOpen="True"
                  ItemsSource="{x:Static helpers:DomainCascadingItems.Items}"
                  SelectedCascadingItem="{Binding DomainName, Mode=TwoWay, Converter={StaticResource DomainNameConverter}}"/>
        <ComboBox Grid.Column="3" MinWidth="56" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                  ItemsSource="{x:Static tasksVm:PuloniaOneDragonDomainSettingsViewModel.SundayChoices}"
                  SelectedItem="{Binding SundayValue, Mode=TwoWay}"/>
       </Grid>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ui:CardExpander>

  <ui:CardControl Margin="0,0,0,12">
   <ui:CardControl.Header>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ToggleButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Height="36" VerticalAlignment="Center"
                   HorizontalAlignment="Center" Content="领奖树脂设定" x:Name="ResinToggleButton"/>
     <ui:TextBlock Grid.Row="0" Grid.Column="1" FontTypography="Body" HorizontalAlignment="Right" Text="分解圣遗物" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="最高的星级" TextWrapping="Wrap"/>
     <!-- 树脂模式弹窗：关闭时按默认优先级，开启时按下方数量使用树脂。 -->
     <Popup Grid.Row="0" Grid.Column="0" Placement="Center" PlacementTarget="{Binding ElementName=ResinToggleButton}"
            IsOpen="{Binding IsChecked, ElementName=ResinToggleButton}" AllowsTransparency="True" PopupAnimation="Fade"
            HorizontalAlignment="Center" Focusable="False" StaysOpen="False">
      <Border CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1">
       <StackPanel Margin="12">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <ToggleButton Grid.Column="0" IsChecked="{Binding SpecifyResinUse, Mode=TwoWay}" Content="模式切换"/>
         <ui:TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="先用浓缩，后原粹，其余不用" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                       Visibility="{Binding SpecifyResinUse, Converter={StaticResource BooleanToVisibilityRevertConverter}}"/>
         <ui:TextBlock Grid.Column="1" Margin="5,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="按下方配置数量使用树脂" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                       Visibility="{Binding SpecifyResinUse, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        <StackPanel Margin="0,10,0,0" IsEnabled="{Binding SpecifyResinUse}"
                    Visibility="{Binding SpecifyResinUse, Converter={StaticResource BooleanToVisibilityConverter}}">
         <Separator Height="1" Margin="0,0,0,0" Background="Gray"/>
         <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
          <ui:TextBlock Text="原粹树脂刷取次数：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>
          <ui:NumberBox Value="{Binding OriginalResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False"
                        SpinButtonPlacementMode="Inline" Width="120"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <ui:TextBlock Text="浓缩树脂刷取次数：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>
          <ui:NumberBox Value="{Binding CondensedResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False"
                        SpinButtonPlacementMode="Inline" Width="120"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <ui:TextBlock Text="须臾树脂刷取次数：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>
          <ui:NumberBox Value="{Binding TransientResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False"
                        SpinButtonPlacementMode="Inline" Width="120"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal">
          <ui:TextBlock Text="脆弱树脂刷取次数：" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0"/>
          <ui:NumberBox Value="{Binding FragileResinUseCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False"
                        SpinButtonPlacementMode="Inline" Width="120"/>
         </StackPanel>
        </StackPanel>
       </StackPanel>
      </Border>
     </Popup>
    </Grid>
   </ui:CardControl.Header>
   <StackPanel Orientation="Horizontal">
    <ComboBox Width="60" Margin="0,0,10,0"
              ItemsSource="{x:Static tasksVm:PuloniaOneDragonDomainSettingsViewModel.ArtifactStarChoices}"
              SelectedItem="{Binding MaxArtifactStar, Mode=TwoWay}"/>
    <ui:ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding AutoArtifactSalvage, Mode=TwoWay}"/>
   </StackPanel>
  </ui:CardControl>

  <ui:CardControl Margin="0,0,0,4">
   <ui:CardControl.Header>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="启用奖励识别" TextWrapping="Wrap"/>
     <ui:TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="每轮领取后识别奖励名称与数量，任务结束打印汇总" TextWrapping="Wrap"/>
    </Grid>
   </ui:CardControl.Header>
   <ui:ToggleSwitch Margin="0,0,36,0" IsChecked="{Binding RewardRecognitionEnabled, Mode=TwoWay}"/>
  </ui:CardControl>
 </StackPanel>
</UserControl>
