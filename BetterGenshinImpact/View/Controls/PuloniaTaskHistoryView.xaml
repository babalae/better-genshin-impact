<UserControl x:Class="BetterGenshinImpact.View.Controls.PuloniaTaskHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Pages.Pulonia">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- 历史与节点列表使用主题色；选中状态同时有边框，避免仅靠颜色区分。 -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 运行状态按语义分类着色：进行中用强调色，成功/失败/需关注分别使用系统语义色，排队与中性结束显示为灰色。 -->
        <Style x:Key="RunStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="running">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="attention">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 只读文本框保留选择/复制能力，多行日志独立滚动，不撑破整个详情布局。 -->
        <DataTemplate DataType="{x:Type pulonia:PuloniaTaskHistoryField}">
            <StackPanel Margin="0,0,0,12">
                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                <TextBox Margin="0,4,0,0" Padding="6" MaxHeight="180" IsReadOnly="True"
                         Text="{Binding Value, Mode=OneWay}" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <WrapPanel>
                <Button Margin="0,0,8,6" Command="{Binding RefreshRunsCommand}" Content="刷新" />
                <Button Margin="0,0,8,6" Command="{Binding CancelRunCommand}" Content="停止当前选中"
                        ToolTip="停止选中的运行，并等待当前执行器释放资源。" />
                <Button Margin="0,0,8,6" Command="{Binding ResumeRunCommand}" Content="继续未完成节点"
                        ToolTip="沿用原快照，跳过已确认成功的节点；不确定结果需要人工核对。" />
                <Button Margin="0,0,8,6" Command="{Binding ResumeFromNodeCommand}" Content="从选中节点开始"
                        ToolTip="建立关联的新运行，所选节点及之后的节点可能重新执行。" />
            </WrapPanel>
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CountText}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="190" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid>
                <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource HistoryItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="执行记录列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 计划页按当前计划过滤时标题与页面计划名重复，仅在记录跨计划展示时显示。 -->
                                <TextBlock FontWeight="SemiBold" Text="{Binding PlanName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlanName}"
                                           Visibility="{Binding DataContext.ShowPlanTitle, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding StatusText}" Style="{StaticResource RunStatusText}" />
                                <TextBlock FontSize="11" Text="{Binding SubmittedAtText}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding StorageText}" />
                                <TextBlock FontSize="11" Text="{Binding ScopeText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Text="含未核验结果" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding NeedsVerification, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="12" VerticalAlignment="Center" Text="{Binding EmptyText}" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Runs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
            <!-- 未选中记录时的唯一占位提示；选中详情与它互斥显示，避免两条提示文本重叠。 -->
            <TextBlock Grid.Column="2" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="未选中执行记录；点击左侧记录可查看当次执行的节点、输入、结果与证据。" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedRun}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Grid.Column="2" Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="110" MinHeight="60" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" MinHeight="80" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedRun.PlanName}" TextWrapping="Wrap" />
                            <!-- DataContext 指向选中运行，供状态样式按 StatusKind 触发器着色。 -->
                            <TextBlock Margin="12,2,0,0" DataContext="{Binding SelectedRun}" Text="{Binding StatusText}"
                                       Style="{StaticResource RunStatusText}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectedRun.ResultSummary}" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectedRun.Message}" TextWrapping="Wrap" MaxHeight="60" />
                        <TextBlock Margin="0,4,0,0" Text="请核对实际游戏状态；执行结束不等于收益已确认。" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedRun.NeedsVerification, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding SelectedRun.NodeDetails}"
                             SelectedItem="{Binding SelectedRunNodeResult, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.Name="节点尝试列表">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding TaskName}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Text="{Binding SummaryText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="12" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Text="尚无节点结果。排队/执行中请查看运行信息；结束后可逐次查看结果。" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRun.NodeDetails.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <TabControl Grid.Row="3">
                    <TabItem Header="结果与证据">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10" Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolVisibility}}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedRunNodeResult.TaskName}" TextWrapping="Wrap" />
                                <TextBox Margin="0,6,0,0" IsReadOnly="True" Text="{Binding SelectedRunNodeResult.TaskAddress, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding SelectedRunNodeResult.StatusText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Text="{Binding SelectedRunNodeResult.TimingText}" TextWrapping="Wrap" />
                                <TextBox Margin="0,6,0,10" IsReadOnly="True" Text="{Binding SelectedRunNodeResult.Message, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,0,0,12" Text="{Binding SelectedRunNodeResult.VerificationNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding SelectedRunNodeResult.ResultFields}" />
                                <TextBlock Margin="0,6,0,10" FontWeight="SemiBold" Text="证据与已确认副作用" />
                                <ItemsControl ItemsSource="{Binding SelectedRunNodeResult.EvidenceFields}" />
                                <Expander Header="节点原始记录（JSON）">
                                    <TextBox MaxHeight="280" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas"
                                             Text="{Binding SelectedRunNodeResult.RawJson, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="执行输入">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <TextBlock Margin="0,0,0,12" Text="以下内容来自当次固定快照，后续修改计划或删除资源不会改变这些输入。" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SelectedRunNodeResult.InputFields}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="运行信息">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <ItemsControl ItemsSource="{Binding SelectedRun.OverviewFields}" />
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="当前或最近结束的节点地址" />
                                <TextBox IsReadOnly="True" Text="{Binding SelectedRun.CurrentTaskAddress, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Margin="0,14,0,10" Text="本次运行已确认副作用" />
                                <ItemsControl ItemsSource="{Binding SelectedRun.ConfirmedEffectFields}" />
                                <Expander Header="完整执行快照（JSON）">
                                    <TextBox MaxHeight="280" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas"
                                             Text="{Binding SelectedRun.Run.SnapshotJson, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="当前 CD">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <TextBlock Margin="0,0,0,12" Text="这是当前全部账号/世界的 CD 与额度账本，不是选中历史当时的账本快照。历史内的确认事件请在“运行信息”查看。" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding LedgerEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding EffectKey}" />
                                                    <TextBlock Text="{Binding ScopeKey}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding OccurredAtText, StringFormat=确认时间：{0}}" />
                                                    <TextBlock Text="{Binding EligibilityText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="暂无已确认的 CD 或额度事件。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LedgerEntries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock FontSize="11" Text="{Binding StorageDirectory, StringFormat=本地保存位置：{0}}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StorageDirectory}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
