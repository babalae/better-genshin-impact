<UserControl x:Class="BetterGenshinImpact.View.Controls.PuloniaTaskHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:BetterGenshinImpact.View.Converters"
             xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Pages.Pulonia"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
        任务计划页“执行记录”页签、全局执行记录页与一条龙执行记录窗口共用此视图，DataContext 为 PuloniaTaskHistoryViewModel。
        布局：左侧记录列表；右侧为所选记录的概要与操作、任务列表，以及“任务详情 / 运行信息”。
        内部标识、原始 JSON 等排查信息统一收进“技术详情”，默认收起。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <converters:BooleanToVisibilityRevertConverter x:Key="BoolVisibilityRevert" />

        <!-- 详情区卡片。 -->
        <Style x:Key="HistoryCard" TargetType="Border">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 记录与任务列表项：透明底，悬停浅底，选中时强调色浅底并显示左侧指示条，深色主题下不出现系统高亮色。 -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        Height="18"
                                        Margin="-8,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource AccentFillColorDefault}" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态按语义分类着色：进行中用强调色，成功/失败/需核对分别使用系统语义色，排队、跳过与停止为灰色。 -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="running">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="attention">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 状态图标与状态文字使用同一套着色。 -->
        <Style x:Key="StatusIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="running">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind, Mode=OneWay}" Value="attention">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 可选说明文字：内容为空时不占位。 -->
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 可选择复制的只读文字：无边框、透明底，内容为空时不占位。 -->
        <Style x:Key="ReadOnlyText"
               BasedOn="{StaticResource {x:Type TextBox}}"
               TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 小标签（重试轮次、账号）。 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <!-- 分区标题。 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 详情字段：标题在上，内容可选择复制，长内容在框内滚动。 -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type pulonia:PuloniaTaskHistoryField}">
            <StackPanel Margin="0,0,0,10">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Label, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <TextBox MaxHeight="180"
                         Style="{StaticResource ReadOnlyText}"
                         Text="{Binding Value, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <!-- 运行信息：标题与内容同行的紧凑列表。 -->
        <DataTemplate x:Key="InfoRowTemplate" DataType="{x:Type pulonia:PuloniaTaskHistoryField}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Label, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Text="{Binding Value, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- 分割条平时透明，悬停时显色提示可拖动。 -->
        <Style x:Key="HistorySplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：记录列表，从新到旧；运行状态变化时自动刷新。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="4,0,0,6">
                    <ui:Button Width="30"
                               Height="30"
                               MinWidth="0"
                               MinHeight="0"
                               Padding="5"
                               DockPanel.Dock="Right"
                               Appearance="Transparent"
                               BorderThickness="0"
                               Command="{Binding RefreshRunsCommand, Mode=OneWay}"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="刷新；运行状态变化时也会自动更新"
                               AutomationProperties.Name="刷新执行记录" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding CountText, Mode=OneWay}"
                               ToolTip="{Binding StorageDirectory, Mode=OneWay, StringFormat=记录保存在本机：{0}}" />
                </DockPanel>
                <ListBox Grid.Row="1"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         IsSynchronizedWithCurrentItem="False"
                         ItemContainerStyle="{StaticResource HistoryItem}"
                         ItemsSource="{Binding Runs, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="执行记录列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Margin="0,1,10,0"
                                               VerticalAlignment="Top"
                                               FontSize="16"
                                               Style="{StaticResource StatusIconStyle}"
                                               Symbol="{Binding StatusIcon, Mode=OneWay}" />
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Style="{StaticResource StatusTextStyle}"
                                                   Text="{Binding StatusText, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding TimeText, Mode=OneWay}" />
                                    </Grid>
                                    <!-- 计划页只看当前计划，计划名与页面标题重复，仅在跨计划展示时显示。 -->
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding PlanName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PlanName, Mode=OneWay}"
                                               Visibility="{Binding DataContext.ShowPlanTitle, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource OptionalText}"
                                               Text="{Binding SummaryText, Mode=OneWay}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Border Style="{StaticResource Badge}"
                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                ToolTip="部分任务的游戏内结果无法自动确认，请在游戏中核对"
                                                Visibility="{Binding NeedsVerification, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Text="需核对" />
                                        </Border>
                                        <!-- 使用当前登录账号时不显示，切换账号时显示核验的 UID。 -->
                                        <Border ToolTip="运行前切换到的账号">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource Badge}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountText, Mode=OneWay}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding AccountText, Mode=OneWay}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1"
                           Margin="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False"
                           Text="{Binding EmptyText, Mode=OneWay}"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Runs.Count, Mode=OneWay}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource HistorySplitter}" />

            <!-- 未选中记录时的唯一提示；与详情互斥显示。 -->
            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSelectedRun, Mode=OneWay, Converter={StaticResource BoolVisibilityRevert}}">
                <ui:SymbolIcon HorizontalAlignment="Center"
                               FontSize="40"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="History24" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="选择左侧的一条记录，查看每个任务的执行结果。"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 右侧：所选记录的概要与操作、任务列表、任务详情与运行信息。 -->
            <Grid Grid.Column="2" Visibility="{Binding HasSelectedRun, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="110" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="3*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- 概要：状态、触发方式与时间、原因、结果摘要；右侧为针对这条记录的操作。 -->
                <Border Margin="0,0,0,10" Style="{StaticResource HistoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel DataContext="{Binding SelectedRun, Mode=OneWay}">
                            <WrapPanel>
                                <ui:SymbolIcon Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               Style="{StaticResource StatusIconStyle}"
                                               Symbol="{Binding StatusIcon, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource StatusTextStyle}"
                                           Text="{Binding StatusText, Mode=OneWay}" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Text="{Binding PlanName, Mode=OneWay}"
                                           Visibility="{Binding DataContext.ShowPlanTitle, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisibility}}" />
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding SubtitleText, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <!-- 运行中为当前任务，结束后为失败或停止原因；成功结束时不重复显示。 -->
                            <TextBlock Margin="0,6,0,0"
                                       MaxHeight="60"
                                       Style="{StaticResource OptionalText}"
                                       Text="{Binding DetailMessage, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DetailMessage, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="12"
                                       Style="{StaticResource OptionalText}"
                                       Text="{Binding SummaryText, Mode=OneWay}" />
                            <Border Margin="0,8,0,0"
                                    Padding="10,6"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="6"
                                    Visibility="{Binding NeedsVerification, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Margin="0,0,8,0"
                                                   VerticalAlignment="Top"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Symbol="Warning24" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Text="部分任务的游戏内结果无法自动确认（标为“待核对”），请在游戏中核对；续跑或重新开始时这些任务可能重复执行。"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- 操作只在可用时出现：运行中可停止；结束且未全部成功可续跑；已结束的记录可从选中任务重新开始。 -->
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top">
                            <ui:Button Margin="0,0,0,6"
                                       HorizontalAlignment="Stretch"
                                       Command="{Binding CancelRunCommand, Mode=OneWay}"
                                       Content="停止"
                                       Icon="{ui:SymbolIcon Stop24}"
                                       ToolTip="停止这次运行，并等待当前任务退出"
                                       Visibility="{Binding SelectedRun.CanCancel, Mode=OneWay, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" />
                            <ui:Button Margin="0,0,0,6"
                                       HorizontalAlignment="Stretch"
                                       Appearance="Primary"
                                       Command="{Binding ResumeRunCommand, Mode=OneWay}"
                                       Content="续跑"
                                       Icon="{ui:SymbolIcon Play24}"
                                       ToolTip="沿用这次运行当时的设置，跳过已成功的任务，继续剩下的任务"
                                       Visibility="{Binding SelectedRun.CanResume, Mode=OneWay, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" />
                            <ui:Button HorizontalAlignment="Stretch"
                                       Command="{Binding ResumeFromNodeCommand, Mode=OneWay}"
                                       Content="从选中任务开始"
                                       Icon="{ui:SymbolIcon ArrowRedo24}"
                                       ToolTip="沿用这次运行当时的设置，从下方选中的任务开始重新执行，它和之后的任务都会再执行一次"
                                       ToolTipService.ShowOnDisabled="True"
                                       Visibility="{Binding SelectedRun.IsHistorical, Mode=OneWay, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 任务列表：按执行顺序，每次尝试一行；未启用的任务不列出。 -->
                <Border Grid.Row="1"
                        Padding="6"
                        Style="{StaticResource HistoryCard}">
                    <DockPanel>
                        <TextBlock Margin="8,4,8,2"
                                   DockPanel.Dock="Bottom"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{StaticResource OptionalText}"
                                   Text="{Binding SelectedRun.DisabledTaskText, Mode=OneWay}" />
                        <Grid>
                            <ListBox Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource HistoryItem}"
                                     ItemsSource="{Binding SelectedRun.NodeDetails, Mode=OneWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectedItem="{Binding SelectedRunNodeResult, Mode=TwoWay}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="任务结果列表">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Margin="0,1,10,0"
                                                           VerticalAlignment="Top"
                                                           FontSize="16"
                                                           Style="{StaticResource StatusIconStyle}"
                                                           Symbol="{Binding StatusIcon, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1">
                                                <Grid HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TaskName, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TaskName, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="{Binding TypeText, Mode=OneWay}" />
                                                    <!-- 重试时标出第几次尝试，首次尝试不显示。 -->
                                                    <Border Grid.Column="2" Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style BasedOn="{StaticResource Badge}" TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AttemptText, Mode=OneWay}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding AttemptText, Mode=OneWay}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Style="{StaticResource OptionalText}"
                                                           Text="{Binding BriefText, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding BriefText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Top"
                                                        Orientation="Horizontal">
                                                <TextBlock FontSize="12"
                                                           Style="{StaticResource StatusTextStyle}"
                                                           Text="{Binding StatusText, Mode=OneWay}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Style="{StaticResource OptionalText}"
                                                           Text="{Binding DurationText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="还没有任务结果；任务完成后会显示在这里。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRun.NodeDetails.Count, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              Style="{StaticResource HistorySplitter}" />

                <!-- 下方：所选任务的详情与整次运行的信息。 -->
                <Border Grid.Row="3"
                        Padding="0"
                        Style="{StaticResource HistoryCard}">
                    <TabControl BorderThickness="0">
                        <TabItem Header="任务详情">
                            <Grid>
                                <TextBlock Margin="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="选择上方的任务查看详情。"
                                           Visibility="{Binding HasSelectedNode, Mode=OneWay, Converter={StaticResource BoolVisibilityRevert}}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedNode, Mode=OneWay, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel Margin="14,10,14,12" DataContext="{Binding SelectedRunNodeResult, Mode=OneWay}">
                                        <!-- 标题：任务名、类型与状态。 -->
                                        <WrapPanel>
                                            <TextBlock Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding TaskName, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding TypeText, Mode=OneWay}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <ui:SymbolIcon Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Style="{StaticResource StatusIconStyle}"
                                                           Symbol="{Binding StatusIcon, Mode=OneWay}" />
                                            <TextBlock Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource StatusTextStyle}"
                                                       Text="{Binding StatusText, Mode=OneWay}" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding TimingText, Mode=OneWay}" />
                                        </WrapPanel>
                                        <!-- 执行器给出的说明或失败原因，可选择复制。 -->
                                        <TextBox Margin="0,8,0,0"
                                                 MaxHeight="160"
                                                 Style="{StaticResource ReadOnlyText}"
                                                 Text="{Binding Message, Mode=OneWay}" />
                                        <!-- 只有结果需要核对时才说明这类任务的核验边界。 -->
                                        <Border Margin="0,8,0,0"
                                                Padding="10,6"
                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VerificationNote, Mode=OneWay}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12"
                                                       Text="{Binding VerificationNote, Mode=OneWay}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <!-- 结果：执行器返回的关键数据；没有返回数据时整段隐藏。 -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultFields.Count, Mode=OneWay}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="结果" />
                                            <ItemsControl ItemTemplate="{StaticResource FieldTemplate}"
                                                          ItemsSource="{Binding ResultFields, Mode=OneWay}" />
                                        </StackPanel>
                                        <Expander Margin="0,12,0,0" Header="当次使用的设置">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Margin="0,0,0,10"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="来自开始执行时保存的快照；之后修改计划不会改变这些内容。"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}"
                                                              ItemsSource="{Binding SettingsFields, Mode=OneWay}" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Margin="0,8,0,0" Header="技术详情（排查问题用）">
                                            <StackPanel Margin="0,8,0,0">
                                                <ItemsControl ItemTemplate="{StaticResource FieldTemplate}"
                                                              ItemsSource="{Binding TechnicalFields, Mode=OneWay}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="原始记录（JSON）" />
                                                <TextBox MaxHeight="260"
                                                         FontFamily="Consolas"
                                                         Style="{StaticResource ReadOnlyText}"
                                                         Text="{Binding RawJson, Mode=OneWay}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="运行信息">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,10,14,12" DataContext="{Binding SelectedRun, Mode=OneWay}">
                                    <ItemsControl ItemTemplate="{StaticResource InfoRowTemplate}"
                                                  ItemsSource="{Binding InfoFields, Mode=OneWay}" />
                                    <Expander Margin="0,12,0,0" Header="技术详情（排查问题用）">
                                        <StackPanel Margin="0,8,0,0">
                                            <ItemsControl ItemTemplate="{StaticResource FieldTemplate}"
                                                          ItemsSource="{Binding TechnicalFields, Mode=OneWay}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="完整执行快照（JSON）" />
                                            <TextBox MaxHeight="260"
                                                     FontFamily="Consolas"
                                                     Style="{StaticResource ReadOnlyText}"
                                                     Text="{Binding Run.SnapshotJson, Mode=OneWay}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- 操作结果、读取失败或恢复提示；没有内容时不占位。 -->
        <TextBlock Grid.Row="1"
                   Margin="4,8,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolVisibility}}" />
    </Grid>
</UserControl>
