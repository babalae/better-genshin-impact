<UserControl x:Class="BetterGenshinImpact.View.Controls.PuloniaOneDragonHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
        一条龙执行记录窗口：运行记录与任务计划页、全局执行记录页共用同一个执行记录视图，不再维护单独的一份布局；
        DataContext 为窗口专属的 PuloniaTaskHistoryViewModel，路线 CD 总览取其 Cooldowns。
    -->
    <TabControl BorderThickness="0">
        <TabItem Header="运行记录">
            <controls:PuloniaTaskHistoryView Margin="0,12,0,0" />
        </TabItem>
        <TabItem Header="路线 CD">
            <controls:PuloniaCollectionCooldownOverviewView Margin="0,12,0,0" DataContext="{Binding Cooldowns, Mode=OneWay}" />
        </TabItem>
    </TabControl>
</UserControl>
