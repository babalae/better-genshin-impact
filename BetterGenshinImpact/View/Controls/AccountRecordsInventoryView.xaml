<UserControl x:Class="BetterGenshinImpact.View.Controls.AccountRecordsInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AccountRecordsTableResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="InventoryErrorBrush" Color="#EA4335" />
        <SolidColorBrush x:Key="InventoryWarningBrush" Color="#F28C28" />
        <behavior:BindingProxy x:Key="InventoryProxy" Data="{Binding Mode=OneWay}" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <controls:AccountRecordsTimeConverter x:Key="InventoryTime" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" behavior:NativeScrolling.IsEnabled="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" RowHeight="36" MinRowHeight="36"
                  FontSize="14" ColumnHeaderHeight="36" ColumnHeaderStyle="{StaticResource InventoryHeader}"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  RowBackground="{DynamicResource ApplicationBackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource ApplicationBackgroundBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="ItemsSource" Value="{Binding Items, Mode=OneWay}" />
                </Style>
            </DataGrid.Style>
            <b:Interaction.Behaviors>
                <behavior:AccountRecordsTimeRefreshBehavior Command="{Binding RefreshTimeWarningsCommand, Mode=OneWay}" />
                <behavior:AccountRecordsRowSelectionBehavior OpenDetailsCommand="{Binding ShowRecentCommand, Mode=OneWay}" />
                <behavior:AccountRecordsColumnWidthsBehavior ResetVersion="{Binding DataContext.ColumnWidthResetVersion, RelativeSource={RelativeSource AncestorType={x:Type pages:AccountRecordsPage}}, Mode=OneWay}" />
            </b:Interaction.Behaviors>
            <DataGrid.CellStyle><StaticResource ResourceKey="AccountRecordsCell" /></DataGrid.CellStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{i18n:T 刷新}" Command="{Binding Data.RefreshCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource AccountRecordsRow}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                                <MenuItem Header="{Binding PriorActionText, Mode=OneWay}" Command="{Binding Data.TogglePriorCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}"
                                          ToolTip="{i18n:T 仅置顶当前物品。}" />
                                <MenuItem Header="{i18n:T 查看物品详情…}" ToolTip="{i18n:T 双击物品行也可查看库存与历史记录}" Command="{Binding Data.ShowRecentCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="{i18n:T 修改数量 / 修订字典}" Command="{Binding Data.EditCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="{i18n:T 刷新}" Command="{Binding Data.RefreshCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                                <MenuItem Header="{i18n:T 归档同类未受阻的完成事件}" Command="{Binding Data.ArchiveCompletedEventsCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Visibility="{Binding CanBatchArchive, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                                <MenuItem Header="{i18n:T 查看异常}" Command="{Binding Data.ShowStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" IsEnabled="{Binding HasStatusLight, Mode=OneWay}" />
                                <Separator />
                                <MenuItem Header="{i18n:T 显示过期时间}" IsCheckable="True"
                                          IsChecked="{Binding Data.ShowExpirationColumn, Source={StaticResource InventoryProxy}, Mode=OneWay}"
                                          Command="{Binding Data.ToggleExpirationColumnCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                                <Separator />
                                <MenuItem Header="{i18n:T 删除图像缓存}" Command="{Binding Data.DeleteIconCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="{i18n:T 上传图标…}" Command="{Binding Data.UploadIconCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <Separator />
                                <MenuItem Header="{i18n:T 删除此物品记录}" Command="{Binding Data.DeleteCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserResize="False" CanUserSort="False" Header="" HeaderTemplate="{StaticResource AccountRecordsIconHeaderTemplate}" HeaderStyle="{StaticResource AccountRecordsIconHeader}" CellTemplate="{StaticResource AccountRecordsIconTemplate}" />
                <!-- 固定默认宽度，不随窗口压缩；放不下时使用横向滚动。 -->
                <DataGridTextColumn Header="{i18n:T 名称}" Binding="{Binding Name, Mode=OneWay}" SortMemberPath="ItemNameSortKey" ElementStyle="{StaticResource AccountRecordsNameText}" Width="156" MinWidth="44" />
                <DataGridTemplateColumn Header="{i18n:T 类型}" SortMemberPath="Category" Width="156" MinWidth="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 保留原始类型文字，PNG 只表达所属背包页；窄列仅保留 36×36 图标。 -->
                            <controls:AccountRecordsCategoryView Icon="{Binding PageIcon, Mode=OneWay}"
                                Text="{Binding Category, Mode=OneWay}" Description="{Binding CategoryDescription, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:T 库存}" SortMemberPath="Quantity" HeaderStyle="{StaticResource InventoryQuantityHeader}" Width="120" MinWidth="44">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding QuantityText, Mode=OneWay}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpiredQuantityText, Mode=OneWay}" FontSize="11" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           ToolTip="{Binding ExpiredQuantityDetails, Mode=OneWay}" />
                                <TextBlock Text="{Binding AdditionalDeltaText, Mode=OneWay}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding DeltaText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:T 记录时间}" SortMemberPath="RecordedAt" Width="104" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Style="{StaticResource InventoryText}" ToolTip="{Binding TimeText, Mode=OneWay}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource InventoryTime}" Mode="OneWay">
                                    <Binding Path="RecordedAt" Mode="OneWay" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=DataGridCell}" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:T 过期时间}" Width="160" MinWidth="80" SortMemberPath="EarliestExpiration"
                    Visibility="{Binding Data.ShowExpirationColumn, Source={StaticResource InventoryProxy}, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding ExpirationText, Mode=OneWay}" ToolTip="{Binding ExpirationDetails, Mode=OneWay}" Style="{StaticResource InventoryText}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:T 来源}" Width="*" MinWidth="160" CanUserResize="True" SortMemberPath="SourceName">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding SourceName, Mode=OneWay}" ToolTip="{Binding SourceReference, Mode=OneWay}" Style="{StaticResource InventoryText}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{i18n:T 状态}" Width="44" MinWidth="44" MaxWidth="44" CanUserResize="False" CanUserReorder="False" SortMemberPath="StateRank">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Style="{StaticResource ErrorButton}" Visibility="{Binding HasStatusLight, Converter={StaticResource BoolVisibility}, Mode=OneWay}"
                                AutomationProperties.Name="查看库存状态"
                                Command="{Binding Data.ShowStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseEnter">
                                    <b:InvokeCommandAction Command="{Binding Data.PreviewStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                </b:EventTrigger>
                                <b:EventTrigger EventName="MouseLeave">
                                    <b:InvokeCommandAction Command="{Binding Data.EndStatusPreviewCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- 加载遮罩只覆盖表体，保留当前表头、列宽和排序箭头，阻止操作未完成的行。 -->
        <Grid Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
              Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
            <b:Interaction.Behaviors>
                <behavior:AccountRecordsViewportOverlayBehavior Target="{Binding ElementName=InventoryGrid, Mode=OneWay}" />
            </b:Interaction.Behaviors>
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
            <controls:AccountRecordsEmptyState IsHitTestVisible="False" IsLoading="{Binding IsLoading, Mode=OneWay}" />
        </Grid>
        <!-- 异常提示只占底部局部区域，不覆盖表格或拦截表格交互。 -->
        <Border Grid.Row="1" Margin="0,4,0,0" Padding="10,4" CornerRadius="6" HorizontalAlignment="Left"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
            <b:Interaction.Behaviors>
                <behavior:AccountRecordsViewportOverlayBehavior Target="{Binding ElementName=InventoryGrid, Mode=OneWay}" HorizontalOnly="True" />
            </b:Interaction.Behaviors>
            <Grid>
                <!-- 关闭入口与首张卡片标题顶端对齐，不再单独占用一行。 -->
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,2,0,2"
                               Visibility="{Binding ShowStatusMessage, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                <!-- 错误与提醒数量放在卡片标题；底部限高滚动，完整说明不再被最高优先级事项覆盖。 -->
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasNoticeCards, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
                    <b:Interaction.Behaviors>
                        <behavior:AccountRecordsNoticeHeightBehavior NoticeTarget="{Binding NoticeRow, Mode=OneWay}" />
                    </b:Interaction.Behaviors>
                    <ItemsControl ItemsSource="{Binding NoticeCards, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding AccentColor, Mode=OneWay}" BorderThickness="3,0,0,0" Padding="8,2" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Details, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,8,0" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <ui:Button Padding="8,2" MinHeight="24" Content="{i18n:T 打开 log}" Margin="0,0,6,0" Command="{Binding Data.OpenNoticeCardEventsCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                            <ui:Button Padding="8,2" MinHeight="24" Content="{i18n:T 舍弃}" Margin="0,0,6,0" Command="{Binding Data.ResolveNoticeCardCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Visibility="{Binding CanResolve, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                                            <ui:Button Padding="8,2" MinHeight="24" Content="{i18n:T 归档}" Margin="0,0,6,0" Command="{Binding Data.ArchiveNoticeCardCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Visibility="{Binding CanArchive, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                                            <ui:Button Padding="8,2" MinHeight="24" Content="{i18n:T 批量归档}" Command="{Binding Data.ArchiveNoticeCardBatchCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" Visibility="{Binding CanBatchArchive, Converter={StaticResource BoolVisibility}, Mode=OneWay}" ToolTip="{i18n:T 归档本账户中未受阻的同类完成事件。}" />
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                           Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" ToolTip="{i18n:T 收起全部提示，不归档事件}"
                           AutomationProperties.Name="关闭通知" Command="{Binding CloseNoticeCommand, Mode=OneWay}">
                    <b:Interaction.Behaviors>
                        <behavior:AccountRecordsNoticeCloseGuardBehavior NoticeTarget="{Binding NoticeRow, Mode=OneWay}" />
                    </b:Interaction.Behaviors>
                </ui:Button>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Margin="4,6,4,0" FontSize="11"
                   Text="{Binding ItemCountText, Mode=OneWay}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.14"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
