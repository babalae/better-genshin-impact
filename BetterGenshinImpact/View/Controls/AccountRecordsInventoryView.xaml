<UserControl x:Class="BetterGenshinImpact.View.Controls.AccountRecordsInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="InventoryErrorBrush" Color="#EA4335" />
        <SolidColorBrush x:Key="InventoryWarningBrush" Color="#F28C28" />
        <behavior:BindingProxy x:Key="InventoryProxy" Data="{Binding Mode=OneWay}" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <controls:AccountRecordsTimeConverter x:Key="InventoryTime" />
        <Style x:Key="InventoryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="InventoryQuantity" TargetType="TextBlock" BasedOn="{StaticResource InventoryText}">
            <!-- 接入待核实增量后，仅该状态改为左对齐，显示确认库存及（+99）/（−99）；普通库存仍居中。 -->
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 保留标准列宽拖拽部件，仅移除系统表头的渐变和立体边框。 -->
        <Style x:Key="InventoryHeaderGrip" TargetType="Thumb" BasedOn="{StaticResource {x:Type Thumb}}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InventoryHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                            <TextBlock x:Name="SortArrow" Text="↓" Visibility="Collapsed" FontSize="12" FontWeight="Normal"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource InventoryHeaderGrip}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource InventoryHeaderGrip}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value="↑" />
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InventoryQuantityHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource InventoryHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- 红灯只表示库存异常；短暂悬停/按压动画避免持续闪烁干扰阅读。 -->
        <Style x:Key="ErrorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Light" Width="10" Height="10" Fill="{StaticResource InventoryErrorBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>                            <DataTrigger Binding="{Binding StateRank, Mode=OneWay}" Value="1"><Setter TargetName="Light" Property="Fill" Value="{StaticResource InventoryWarningBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding StateRank, Mode=OneWay}" Value="2"><Setter TargetName="Light" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding StateRank, Mode=OneWay}" Value="3"><Setter TargetName="Light" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding StateRank, Mode=OneWay}" Value="4"><Setter TargetName="Light" Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" /></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.35" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.35" Duration="0:0:0.12" />
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                    <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.55" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Light" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter TargetName="Light" Property="StrokeThickness" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Items, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" RowHeight="36" MinRowHeight="36"
                  FontSize="14" ColumnHeaderHeight="36" ColumnHeaderStyle="{StaticResource InventoryHeader}"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  RowBackground="{DynamicResource ApplicationBackgroundBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0">
            <b:Interaction.Behaviors>
                <behavior:AccountRecordsRowSelectionBehavior OpenDetailsCommand="{Binding ShowRecentCommand, Mode=OneWay}" />
                <behavior:AccountRecordsColumnWidthsBehavior ResetVersion="{Binding DataContext.ColumnWidthResetVersion, RelativeSource={RelativeSource AncestorType={x:Type pages:AccountRecordsPage}}, Mode=OneWay}" />
            </b:Interaction.Behaviors>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <!-- 选中反馈统一由整行提供，避免系统单元格的亮蓝覆盖。 -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Grid Background="{TemplateBinding Background}">
                                    <Border x:Name="Highlight" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
                                    <DataGridCellsPresenter />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.06" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.16" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNoticeActive, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding StateRank, Mode=OneWay}" Value="1" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Highlight" Property="Background" Value="{StaticResource InventoryWarningBrush}" />
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNoticeActive, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding StateRank, Mode=OneWay}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Highlight" Property="Background" Value="{StaticResource InventoryErrorBrush}" />
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNoticeActive, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding StateRank, Mode=OneWay}" Value="2" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNoticeActive, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding StateRank, Mode=OneWay}" Value="3" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNoticeActive, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding StateRank, Mode=OneWay}" Value="4" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                                <MenuItem Header="查看物品详情…" FontWeight="SemiBold" ToolTip="双击物品行也可查看最近来源记录" Command="{Binding Data.ShowRecentCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="修改数量 / 修订字典" Command="{Binding Data.EditCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="归档所有已完成事件" Command="{Binding Data.ArchiveCompletedEventsCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" IsEnabled="{Binding Data.HasCompletedEvents, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                                <MenuItem Header="查看异常" Command="{Binding Data.ShowStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" IsEnabled="{Binding HasStatusLight, Mode=OneWay}" />
                                <Separator />
                                <MenuItem Header="删除图标缓存（等待重建）" Command="{Binding Data.DeleteIconCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <MenuItem Header="上传图标（不推荐）…" Command="{Binding Data.UploadIconCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                <Separator />
                                <MenuItem Header="删除此物品记录" Command="{Binding Data.DeleteCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.Header>
                        <Grid Width="36" Height="36" ToolTip="物品图标">
                        <Rectangle Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.15">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/Images/account-records-watermark.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        </Grid>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InventoryHeader}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid Width="36" Height="36">
                            <ui:SymbolIcon Symbol="Box24" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Icon, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <Image Source="{Binding Icon, Mode=OneWay}" Width="36" Height="36" Stretch="Uniform" />
                        </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- 固定默认宽度，不随窗口压缩；放不下时使用横向滚动。 -->
                <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" Width="156" MinWidth="44" />
                <DataGridTextColumn Header="类型" Binding="{Binding Category, Mode=OneWay}" ElementStyle="{StaticResource InventoryText}" Width="112" MinWidth="44" />
                <DataGridTemplateColumn Header="库存" SortMemberPath="Quantity" HeaderStyle="{StaticResource InventoryQuantityHeader}" Width="120" MinWidth="44">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding Quantity, Mode=OneWay, TargetNullValue=未知}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DeltaText, Mode=OneWay}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding DeltaText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="记录时间" SortMemberPath="RecordedAt" Width="104" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Style="{StaticResource InventoryText}" ToolTip="{Binding TimeText, Mode=OneWay}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource InventoryTime}" Mode="OneWay">
                                    <Binding Path="RecordedAt" Mode="OneWay" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=DataGridCell}" Mode="OneWay" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="来源" Width="*" MinWidth="160" CanUserResize="True" SortMemberPath="SourceName">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock Text="{Binding SourceName, Mode=OneWay}" ToolTip="{Binding SourceReference, Mode=OneWay}" Style="{StaticResource InventoryText}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="状态" Width="44" MinWidth="44" MaxWidth="44" CanUserResize="False" CanUserReorder="False" SortMemberPath="StateRank">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Button Style="{StaticResource ErrorButton}" Visibility="{Binding HasStatusLight, Converter={StaticResource BoolVisibility}, Mode=OneWay}"
                                AutomationProperties.Name="查看库存状态"
                                Command="{Binding Data.ShowStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseEnter">
                                    <b:InvokeCommandAction Command="{Binding Data.PreviewStatusCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}" />
                                </b:EventTrigger>
                                <b:EventTrigger EventName="MouseLeave">
                                    <b:InvokeCommandAction Command="{Binding Data.EndStatusPreviewCommand, Source={StaticResource InventoryProxy}, Mode=OneWay}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </Button>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <controls:AccountRecordsEmptyState Margin="0,38,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
        <!-- 异常提示只占底部局部区域，不覆盖表格或拦截表格交互。 -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}, Mode=OneWay}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:Button Width="32" Height="32" Padding="0" Margin="0,0,4,0" VerticalContentAlignment="Center" Icon="{ui:SymbolIcon DocumentBulletList20}" ToolTip="查看事件记录" AutomationProperties.Name="查看事件记录" Command="{Binding OpenEventsCommand, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="接受" Command="{Binding ResolveNoticeCommand, Mode=OneWay}" CommandParameter="accept" Visibility="{Binding CanAcceptNotice, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="舍弃" Command="{Binding ResolveNoticeCommand, Mode=OneWay}" CommandParameter="discard" Visibility="{Binding CanResolveNotice, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="保留提示" Command="{Binding KeepNoticeCommand, Mode=OneWay}" Visibility="{Binding CanKeepNotice, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="归档" Command="{Binding AcknowledgeNoticeCommand, Mode=OneWay}" Visibility="{Binding CanAcknowledgeNotice, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="批量归档" ToolTip="归档当前 UID 的所有已完成事件，仅处理绿色事件。" Command="{Binding ArchiveCompletedEventsCommand, Mode=OneWay}" Visibility="{Binding ShowBatchArchive, Converter={StaticResource BoolVisibility}, Mode=OneWay}" />
                    <ui:Button Height="32" VerticalContentAlignment="Center" Content="关闭" ToolTip="收起提示，不归档事件" Command="{Binding CloseNoticeCommand, Mode=OneWay}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status, Mode=OneWay}" />
                    <TextBlock Text="{Binding NoticeDetails, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NoticeDetails, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
