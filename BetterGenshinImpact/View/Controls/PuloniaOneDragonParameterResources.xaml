<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy"
                    
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
                    xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BetterGI;component/View/Controls/Resin/ResinUsageResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        一条龙参数字段资源字典（Pulonia 一条龙专用）。
        参考旧一条龙 View/Pages/OneDragonFlowPage.xaml 的 ui:CardControl / ui:CardExpander 卡片视觉：
        - 标量字段：一个 ui:CardControl，左侧标题+小号说明，右侧仅显示对应类型的编辑器
        - 对象字段：一个 ui:CardExpander，展开后通过 ItemsControl 递归渲染 Children 子字段
        - 高级 JSON 字段（如命令参数或脚本设置 JSON）：默认折叠的 ui:CardExpander，内含等宽字体多行文本框
        使用方通过 ItemTemplate="{StaticResource OneDragonParameterFieldTemplate}" 应用于根字段集合。
    -->

    <!--  布尔→可见性转换器：保证每个字段只渲染与其类型匹配的编辑器（键名按契约固定）  -->
    <BooleanToVisibilityConverter x:Key="FieldVisibility" />

    <!--
        参数字段递归模板。
        说明：子字段 ItemsControl 的 ItemTemplate 通过 DynamicResource 引用本模板自身，
        延迟到运行期解析，避免资源字典解析阶段出现静态资源前向自引用失败的问题。
    -->
    <DataTemplate x:Key="OneDragonParameterFieldTemplate">

        <!--
            根容器同时承载九种字段形态，由各形态的 Visibility 保证同一时刻只显示一种：
            IsBoolean / IsChoice / IsCombatStrategy / IsDomain / IsResinUsage / IsText / IsNumber / IsObject / IsAdvancedJson 互斥为 True。
        -->
        <Grid>
            <!-- 树脂使用保持嵌套对象合同，只通过公共弹窗整体编辑。 -->
            <ui:CardControl Margin="0,0,0,8" Visibility="{Binding IsResinUsage, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock FontTypography="Body" Text="树脂使用" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Resin, Mode=OneWay}" ContentTemplate="{StaticResource ResinUsageSummaryTemplate}"
                                        Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        HorizontalContentAlignment="Stretch" Focusable="False" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="设置" MinWidth="88"  Command="{Binding Resin.EditCommand, Mode=OneWay}"
                           AutomationProperties.Name="设置树脂使用" ToolTip="{Binding Resin.Summary, Mode=OneWay}" />
            </ui:CardControl>

            <!--  布尔字段：右侧开关  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsBoolean, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  字段标题  -->
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <!--  字段说明（小号次要文字）  -->
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Margin="0"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding BooleanValue, Mode=TwoWay}" />
            </ui:CardControl>

            <!--  选项字段：右侧下拉框  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsChoice, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox Margin="0"
                          MinWidth="160"
                          MaxWidth="360"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding Choices, Mode=OneWay}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
            </ui:CardControl>

        <!-- 战斗策略字段：使用统一的两级选择器。 -->
        <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsCombatStrategy, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <combat:CombatStrategyPicker Width="288" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Strategy="{Binding TextValue, Mode=TwoWay}" AllowedKinds="{Binding AllowedStrategyKinds, Mode=OneWay}" />
            </ui:CardControl>

            <!--
                秘境字段：与自动秘境设置一致的按国家分组选择框，只列出可手动刷取的秘境；清空按钮写回空字符串。
                选项按字段类型由 VM 提供：体力计划的移涌活动秘境只列出对应类型，首项为“跟随培养计划”（保存为空字符串）。
            -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsDomain, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <vio:CascadingComboBox Width="210"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       behavior:DomainCascadingComboBoxBehavior.ClearValue="{Binding TextValue, Mode=TwoWay}"
                                       behavior:DomainCascadingComboBoxBehavior.UseFullLabelsWhenOpen="True"
                                       ItemsSource="{Binding DomainItems, Mode=OneWay}"
                                       SelectedCascadingItem="{Binding SelectedDomainItem, Mode=TwoWay}" />
            </ui:CardControl>

            <!--  文本字段：右侧文本框  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsText, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:TextBox Margin="0"
                            MinWidth="160"
                            MaxWidth="360"
                            HorizontalAlignment="Right"
                            Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
            </ui:CardControl>

            <!--  数字字段：右侧数字框，上下限由 VM 的 Minimum / Maximum 提供  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsNumber, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:NumberBox Margin="0"
                              Width="150"
                              HorizontalAlignment="Right"
                              ClearButtonEnabled="False"
                              Maximum="{Binding Maximum, Mode=OneWay}"
                              Minimum="{Binding Minimum, Mode=OneWay}"
                              SpinButtonPlacementMode="Inline"
                              ValidationMode="InvalidInputOverwritten"
                              Value="{Binding NumberValue, Mode=TwoWay}" />
            </ui:CardControl>

            <!--
                对象字段：可展开卡片，展开后递归渲染子字段。
                子字段集合 Children 内每个元素仍是参数字段 VM，因此再次套用本模板形成树状表单。
            -->
            <ui:CardExpander Margin="0,0,0,8"
                             ContentPadding="0"
                             Visibility="{Binding IsObject, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <!--  子字段列表：缩进展示并通过 DynamicResource 递归引用本模板  -->
                <StackPanel Margin="16,6,16,10">
                    <ItemsControl ItemTemplate="{DynamicResource OneDragonParameterFieldTemplate}"
                                  ItemsSource="{Binding Children, Mode=OneWay}" />
                </StackPanel>
            </ui:CardExpander>

            <!--
                高级 JSON 字段（如命令参数或脚本设置 JSON）：默认折叠的卡片展开器，
                展开后为等宽字体多行文本框，直接编辑原始 JSON 文本，而不是通用表单卡片。
            -->
            <ui:CardExpander Margin="0,0,0,8"
                             ContentPadding="0"
                             Visibility="{Binding IsAdvancedJson, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <!--  多行 JSON 编辑框：随输入实时同步回 VM 的 TextValue  -->
                <TextBox Margin="16,8,16,12"
                         MinHeight="110"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto" />
            </ui:CardExpander>

        </Grid>
    </DataTemplate>
</ResourceDictionary>
