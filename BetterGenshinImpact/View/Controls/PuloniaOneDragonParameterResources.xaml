<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        一条龙参数字段资源字典（Pulonia 一条龙专用）。
        参考旧一条龙 View/Pages/OneDragonFlowPage.xaml 的 ui:CardControl / ui:CardExpander 卡片视觉：
        - 标量字段：一个 ui:CardControl，左侧标题+小号说明，右侧仅显示对应类型的编辑器
        - 对象字段：一个 ui:CardExpander，展开后通过 ItemsControl 递归渲染 Children 子字段
        - 高级 JSON 字段（如命令参数或脚本设置 JSON）：默认折叠的 ui:CardExpander，内含等宽字体多行文本框
        使用方通过 ItemTemplate="{StaticResource OneDragonParameterFieldTemplate}" 应用于根字段集合。
    -->

    <!--  布尔→可见性转换器：保证每个字段只渲染与其类型匹配的编辑器（键名按契约固定）  -->
    <BooleanToVisibilityConverter x:Key="FieldVisibility" />

    <!--
        参数字段递归模板。
        说明：子字段 ItemsControl 的 ItemTemplate 通过 DynamicResource 引用本模板自身，
        延迟到运行期解析，避免资源字典解析阶段出现静态资源前向自引用失败的问题。
    -->
    <DataTemplate x:Key="OneDragonParameterFieldTemplate">

        <!--
            根容器同时承载六种字段形态，由各形态的 Visibility 保证同一时刻只显示一种：
            IsBoolean / IsChoice / IsText / IsNumber / IsObject / IsAdvancedJson 互斥为 True。
        -->
        <Grid>

            <!--  布尔字段：右侧开关  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsBoolean, Converter={StaticResource FieldVisibility}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  字段标题  -->
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <!--  字段说明（小号次要文字）  -->
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Margin="0,0,36,0"
                                 HorizontalAlignment="Right"
                                 IsChecked="{Binding BooleanValue, Mode=TwoWay}" />
            </ui:CardControl>

            <!--  选项字段：右侧下拉框  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsChoice, Converter={StaticResource FieldVisibility}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox Margin="0,0,36,0"
                          MinWidth="160"
                          MaxWidth="360"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
            </ui:CardControl>

            <!--  文本字段：右侧文本框  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsText, Converter={StaticResource FieldVisibility}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:TextBox Margin="0,0,36,0"
                            MinWidth="160"
                            MaxWidth="360"
                            HorizontalAlignment="Right"
                            Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
            </ui:CardControl>

            <!--  数字字段：右侧数字框，上下限由 VM 的 Minimum / Maximum 提供  -->
            <ui:CardControl Margin="0,0,0,8"
                            Visibility="{Binding IsNumber, Converter={StaticResource FieldVisibility}}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:NumberBox Margin="0,0,36,0"
                              Width="150"
                              HorizontalAlignment="Right"
                              ClearButtonEnabled="False"
                              Maximum="{Binding Maximum}"
                              Minimum="{Binding Minimum}"
                              SpinButtonPlacementMode="Inline"
                              ValidationMode="InvalidInputOverwritten"
                              Value="{Binding NumberValue, Mode=TwoWay}" />
            </ui:CardControl>

            <!--
                对象字段：可展开卡片，展开后递归渲染子字段。
                子字段集合 Children 内每个元素仍是参数字段 VM，因此再次套用本模板形成树状表单。
            -->
            <ui:CardExpander Margin="0,0,0,8"
                             ContentPadding="0"
                             Visibility="{Binding IsObject, Converter={StaticResource FieldVisibility}}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <!--  子字段列表：缩进展示并通过 DynamicResource 递归引用本模板  -->
                <StackPanel Margin="16,6,16,10">
                    <ItemsControl ItemTemplate="{DynamicResource OneDragonParameterFieldTemplate}"
                                  ItemsSource="{Binding Children}" />
                </StackPanel>
            </ui:CardExpander>

            <!--
                高级 JSON 字段（如命令参数或脚本设置 JSON）：默认折叠的卡片展开器，
                展开后为等宽字体多行文本框，直接编辑原始 JSON 文本，而不是通用表单卡片。
            -->
            <ui:CardExpander Margin="0,0,0,8"
                             ContentPadding="0"
                             Visibility="{Binding IsAdvancedJson, Converter={StaticResource FieldVisibility}}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{Binding DisplayName}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding Description}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <!--  多行 JSON 编辑框：随输入实时同步回 VM 的 TextValue  -->
                <TextBox Margin="16,8,16,12"
                         MinHeight="110"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto"
                         Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalScrollBarVisibility="Auto" />
            </ui:CardExpander>

        </Grid>
    </DataTemplate>
</ResourceDictionary>
