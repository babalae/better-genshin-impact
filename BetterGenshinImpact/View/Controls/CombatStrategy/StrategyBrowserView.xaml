<UserControl x:Class="BetterGenshinImpact.View.Controls.CombatStrategy.StrategyBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"
             FontFamily="{DynamicResource TextThemeFontFamily}">
    <UserControl.Resources>
        <!-- 子视图构造时尚未接入父面板；初始化所需的静态资源必须在本地可解析。 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CombatStrategyStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="StrategyEntryTemplate">
                <Grid ToolTip="{Binding Node.RelativePath, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Folder24" FontSize="18" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding Node.IsFolder, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" />
                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0" Visibility="{Binding IsCurrent, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Node.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle, Mode=OneWay}" Margin="0,3,0,0" TextWrapping="NoWrap">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StrategyOptionalTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="4" Margin="10,0,0,0" VerticalAlignment="Top" Padding="4,1">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding Badge, Mode=OneWay}" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Node.Strategy.Kind, Mode=OneWay}" Value="Txt"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HasError, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchInput" Height="34" ClearButtonEnabled="False" VerticalContentAlignment="Center" PlaceholderText="搜索策略名称或路径…" Icon="{ui:SymbolIcon Search20}"
                        Text="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="搜索当前类别策略" ToolTip="按策略名称和相对路径搜索" InputMethod.IsInputMethodEnabled="True" Padding="8,4,30,4" />
            <ui:Button Style="{StaticResource StrategySubtleButtonStyle}" x:Name="ClearSearchButton" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" Width="28" Height="28" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                       Command="{Binding DataContext.ClearSearchCommand, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay}"
                       Visibility="{Binding DataContext.HasSearchText, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" />
            <ComboBox x:Name="SortSelector" Grid.Column="1" Width="112" Height="34" Margin="8,0,0,0" HorizontalAlignment="Stretch" Padding="8,4"
                      ItemsSource="{Binding SortOptions, Mode=OneWay}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" AutomationProperties.Name="排序方式" />
        </Grid>
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,0,0,8" Margin="0,0,0,6">
            <Grid>
                <TextBlock Text="{Binding LocationText, Mode=OneWay}" Style="{StaticResource StrategySecondaryTextStyle}" Margin="0,4" Visibility="{Binding IsSearching, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" />
                <ItemsControl ItemsSource="{Binding Breadcrumb, Mode=OneWay}">
                    <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding IsSearching, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChevronRight16" FontSize="10" Margin="2,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Style.Triggers><DataTrigger Binding="{Binding RelativePath, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <ui:Button Style="{StaticResource StrategySubtleButtonStyle}" Appearance="Transparent" Padding="2,3" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}">
                                <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Name, Mode=OneWay}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding RelativePath, Mode=OneWay}" Value=""><Setter Property="Text" Value="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=local:StrategyBrowserView}, Mode=OneWay}" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </ui:Button>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <ListBox x:Name="EntryList" Grid.Row="2" ItemsSource="{Binding Entries, Mode=OneWay}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 ItemTemplate="{StaticResource StrategyEntryTemplate}" Style="{StaticResource StrategyListStyle}"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                 AutomationProperties.Name="{Binding LocationText, Mode=OneWay}">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource StrategyListItemStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
            <b:Interaction.Behaviors><local:StrategyEntryActivationBehavior /><local:TypeToSearchBehavior SearchBox="{Binding ElementName=SearchInput, Mode=OneWay}" /></b:Interaction.Behaviors>
        </ListBox>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource StrategyVisibility}}">
            <ui:SymbolIcon Symbol="Search20" FontSize="28" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding EmptyText, Mode=OneWay}" Style="{StaticResource StrategySecondaryTextStyle}" TextAlignment="Center" />
            <ItemsControl ItemsSource="{Binding DataContext.SearchAlternatives, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <ui:Button Style="{StaticResource StrategySubtleButtonStyle}" Appearance="Transparent" Margin="0,6,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Command="{Binding DataContext.SwitchCategoryCommand, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay}" CommandParameter="{Binding Mode=OneWay}">
                        <TextBlock><Run Text="在 " /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" 中找到 " /><Run Text="{Binding MatchCount, Mode=OneWay}" /><Run Text=" 项 →" /></TextBlock>
                    </ui:Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock Text="{Binding LoadError, Mode=OneWay}" Style="{StaticResource StrategyOptionalTextStyle}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Text="{Binding DataContext.RecordHint, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay}" Style="{StaticResource StrategySecondaryTextStyle}"
                       Visibility="{Binding DataContext.IsKeyMouseCategory, RelativeSource={RelativeSource AncestorType=local:CombatStrategyPickerPanel}, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
