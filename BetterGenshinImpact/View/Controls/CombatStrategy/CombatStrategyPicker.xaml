<UserControl x:Class="BetterGenshinImpact.View.Controls.CombatStrategy.CombatStrategyPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy"
             x:Name="Root" MinWidth="180" Height="36" Focusable="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14"
             FontFamily="{DynamicResource TextThemeFontFamily}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CombatStrategyStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <local:MiddleEllipsisConverter x:Key="MiddleEllipsis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid DataContext="{Binding ViewModel, ElementName=Root, Mode=OneWay}">
        <ToggleButton x:Name="Trigger" IsChecked="{Binding IsOpen, Mode=TwoWay}" Style="{StaticResource StrategyTriggerStyle}"
                      ToolTip="{Binding ToolTipText, Mode=OneWay}" AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}">
            <ToggleButton.InputBindings><KeyBinding Key="Down" Modifiers="Alt" Command="{Binding ShowCommand, Mode=OneWay}" /></ToggleButton.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="6,1" CornerRadius="4" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Kind, Mode=OneWay}" Value="Txt"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsAutomatic, Mode=OneWay}" Value="True">
                                    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Setter Property="CornerRadius" Value="12" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasWarning, Mode=OneWay}" Value="True"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsOwnRecording, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Badge, Mode=OneWay}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.Kind, Mode=OneWay}" Value="Txt"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsAutomatic, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasWarning, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Ellipse Width="10" Height="10" Margin="2,0,10,0" Fill="{DynamicResource SystemFillColorCriticalBrush}"
                         Visibility="{Binding IsOwnRecording, Mode=OneWay, Converter={StaticResource StrategyVisibility}}" />
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <!-- Run.Text 默认双向绑定；这些只读显示属性必须显式使用单向绑定。 -->
                    <Run Text="{Binding TriggerDirectory, Mode=OneWay, Converter={StaticResource MiddleEllipsis}, ConverterParameter=18}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Run Text="{Binding TriggerName, Mode=OneWay, Converter={StaticResource MiddleEllipsis}}" />
                </TextBlock>
                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronDown16" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Style.Triggers><DataTrigger Binding="{Binding IsOwnRecording, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Grid>
        </ToggleButton>
        <Popup x:Name="StrategyPopup" IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Trigger, Mode=OneWay}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="True">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="Opened"><b:InvokeCommandAction Command="{Binding OpenedCommand, Mode=OneWay}" /></b:EventTrigger>
                <b:EventTrigger EventName="Closed"><b:InvokeCommandAction Command="{Binding CloseCommand, Mode=OneWay}" /></b:EventTrigger>
            </b:Interaction.Triggers>
            <b:Interaction.Behaviors><local:PopupScrollIsolationBehavior /></b:Interaction.Behaviors>
            <Border Width="{x:Static local:PopupScrollIsolationBehavior.DefaultPopupWidth}" Height="{x:Static local:PopupScrollIsolationBehavior.DefaultPopupHeight}"
                    Margin="0,4,0,0" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                <local:CombatStrategyPickerPanel />
            </Border>
        </Popup>
    </Grid>
</UserControl>
