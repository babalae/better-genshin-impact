<UserControl x:Class="BetterGenshinImpact.View.Controls.AccountRecordsEmptyState"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             IsHitTestVisible="False"
             Focusable="False">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ViewModel.RefreshMessageCommand, ElementName=Root, Mode=OneWay}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <!-- 用 PNG 的透明通道着色，使同一水印适配明暗主题。 -->
    <Grid Margin="24">
        <Viewbox MaxWidth="240" MaxHeight="300" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Width="240">
                <Rectangle Width="240" Height="240" Opacity="0.14"
                           Fill="{DynamicResource TextFillColorPrimaryBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Resources/Images/account-records-watermark.png"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding ViewModel.Message, ElementName=Root, Mode=OneWay}" FontSize="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
