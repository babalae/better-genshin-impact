<UserControl x:Class="BetterGenshinImpact.View.Controls.Resin.CraftResinEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{DynamicResource TextThemeFontFamily}" FontSize="14"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BetterGI;component/View/Pages/SoloTaskSettings/SoloTaskSettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CraftMode" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Margin" Value="0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="CraftNumber" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
                <Setter Property="Width" Value="150" /><Setter Property="Minimum" Value="1" /><Setter Property="Maximum" Value="999" />
                <Setter Property="SmallChange" Value="1" /><Setter Property="LargeChange" Value="5" />
                <Setter Property="SpinButtonPlacementMode" Value="Inline" /><Setter Property="ClearButtonEnabled" Value="False" />
                <Setter Property="ValidationMode" Value="InvalidInputOverwritten" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Margin="20,12,20,8">
            <TextBlock Text="合成方式" FontWeight="SemiBold" Margin="0,0,0,4" />
            <RadioButton GroupName="CraftResinMode" Style="{StaticResource CraftMode}" IsChecked="{Binding IsDefaultMode, Mode=TwoWay}" AutomationProperties.Name="按默认数量合成">
                <StackPanel><TextBlock Text="按默认数量合成" /><TextBlock Text="使用合成台默认数量" Style="{StaticResource SoloDescription}" /></StackPanel>
            </RadioButton>
            <RadioButton GroupName="CraftResinMode" Style="{StaticResource CraftMode}" IsChecked="{Binding KeepResin, Mode=TwoWay}" AutomationProperties.Name="保留原粹树脂">
                <StackPanel><TextBlock Text="保留原粹树脂" /><TextBlock Text="合成后至少保留指定数量的原粹树脂" Style="{StaticResource SoloDescription}" /></StackPanel>
            </RadioButton>
        </StackPanel>
        <StackPanel Visibility="{Binding ShowKeepAmount, Mode=OneWay, Converter={StaticResource SoloVisibility}}">
            <Separator Margin="20,0" />
            <Grid Style="{StaticResource SoloRow}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <TextBlock Text="保留数量" VerticalAlignment="Center" />
                <ui:NumberBox Grid.Column="1" Style="{StaticResource CraftNumber}" VerticalAlignment="Center" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"
                              Value="{Binding KeepAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="保留原粹树脂数量" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
