<UserControl x:Class="BetterGenshinImpact.View.Controls.Resin.ResinSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root" Focusable="False" FontFamily="{DynamicResource TextThemeFontFamily}" FontSize="14"
             AutomationProperties.Name="{Binding AutomationName, ElementName=Root, Mode=OneWay}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BetterGI;component/View/Pages/SoloTaskSettings/SoloTaskSettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ResinCard" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 所有依赖属性均显式绑定 Root，不改变宿主的 DataContext。CardAction 保留默认键盘和箭头行为。 -->
    <ui:CardAction Style="{StaticResource ResinCard}" Command="{Binding Command, ElementName=Root, Mode=OneWay}"
                   AutomationProperties.Name="{Binding AutomationName, ElementName=Root, Mode=OneWay}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Drop24" FontSize="24" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                <TextBlock Text="{Binding Header, ElementName=Root, Mode=OneWay}" />
                <TextBlock Text="{Binding Summary, ElementName=Root, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SoloDescription}">
                            <Style.Triggers><DataTrigger Binding="{Binding HasProblem, ElementName=Root, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Margin="0,4,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Problem, ElementName=Root, Mode=OneWay}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Problem, ElementName=Root, Mode=OneWay}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Problem, ElementName=Root, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </ui:CardAction>
</UserControl>
