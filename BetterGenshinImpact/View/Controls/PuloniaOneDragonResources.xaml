<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Windows.Pulonia"
 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls">
 <BooleanToVisibilityConverter x:Key="DragonBoolVisibility" />
 <!-- 新一条龙沿用老一条龙的主题卡片；原任务计划的样式和视图保持独立。 -->
 <Style x:Key="DragonCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
  <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14"/>
 </Style>
 <Style x:Key="DragonListItem" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
  <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
    <ContentPresenter HorizontalAlignment="Stretch"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
<Style x:Key="TaskTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Width="20"
                                          Height="34"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Chevron"
                                                  Width="5"
                                                  Height="9"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 4,4.5 L 0,9"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="1.4" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Stroke"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="TreeSelectionIndicator"
                                            Width="3"
                                            Height="20"
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="2"
                                            Visibility="Collapsed" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter TargetName="TreeSelectionIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<DataTemplate x:Key="ParameterFieldTemplate" DataType="{x:Type pulonia:PuloniaTaskParameterFieldViewModel}">
    <!--
        旧任务计划参数字段模板：改为与 PuloniaOneDragonParameterResources 中
        OneDragonParameterFieldTemplate 一致的老一条龙卡片视觉（ui:CardControl / ui:CardExpander）。
        四种编辑器互斥：由各 Is*Editor 标志配合 DragonBoolVisibility 控制显隐，同一字段只显示对应编辑器。
    -->
    <Grid>
        <!--  文本字段：左侧标题+小号说明，右侧文本框  -->
        <ui:CardControl Margin="0,0,0,8"
                        Visibility="{Binding IsTextEditor, Converter={StaticResource DragonBoolVisibility}}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  字段标题  -->
                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="Body"
                                  Text="{Binding DisplayLabel}"
                                  TextWrapping="Wrap" />
                    <!--  字段说明（小号次要文字）  -->
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardControl.Header>
            <ui:TextBox Margin="0,0,36,0"
                        MinWidth="160"
                        MaxWidth="360"
                        HorizontalAlignment="Right"
                        Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
        </ui:CardControl>

        <!--  选项字段：左侧标题+小号说明，右侧下拉框  -->
        <ui:CardControl Margin="0,0,0,8"
                        Visibility="{Binding IsChoiceEditor, Converter={StaticResource DragonBoolVisibility}}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="Body"
                                  Text="{Binding DisplayLabel}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardControl.Header>
            <ComboBox Margin="0,0,36,0"
                      MinWidth="160"
                      MaxWidth="360"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
        </ui:CardControl>

        <!--  布尔字段：左侧标题+小号说明，右侧开关  -->
        <ui:CardControl Margin="0,0,0,8"
                        Visibility="{Binding IsBooleanEditor, Converter={StaticResource DragonBoolVisibility}}">
            <ui:CardControl.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="Body"
                                  Text="{Binding DisplayLabel}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardControl.Header>
            <ui:ToggleSwitch Margin="0,0,36,0"
                             HorizontalAlignment="Right"
                             IsChecked="{Binding BooleanValue, Mode=TwoWay}" />
        </ui:CardControl>

        <!--  高级 JSON 字段：默认折叠的卡片展开器，展开后为等宽字体多行文本框，而不是通用表单卡片  -->
        <ui:CardExpander Margin="0,0,0,8"
                         ContentPadding="0"
                         Visibility="{Binding IsJsonEditor, Converter={StaticResource DragonBoolVisibility}}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock Grid.Row="0"
                                  FontTypography="Body"
                                  Text="{Binding DisplayLabel}"
                                  TextWrapping="Wrap" />
                    <ui:TextBlock Grid.Row="1"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Text="{Binding Description}"
                                  TextWrapping="Wrap" />
                </Grid>
            </ui:CardExpander.Header>
            <!--  多行 JSON 编辑框：随输入实时同步回 VM 的 TextValue  -->
            <TextBox Margin="16,8,16,12"
                     MinHeight="110"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     HorizontalScrollBarVisibility="Auto"
                     Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalScrollBarVisibility="Auto" />
        </ui:CardExpander>
    </Grid>
</DataTemplate>
<DataTemplate x:Key="JavaScriptSettingFieldTemplate"
                      DataType="{x:Type pulonia:PuloniaJsScriptSettingFieldViewModel}">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Margin="0,0,0,5"
                           FontWeight="SemiBold"
                           Text="{Binding Label}"
                           TextWrapping="Wrap" />
                <Separator>
                    <Separator.Style>
                        <Style TargetType="Separator">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Separator.Style>
                </Separator>
                <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedValue, Mode=TwoWay}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <ui:ToggleSwitch IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                 OnContent="已开启"
                                 OffContent="已关闭">
                    <ui:ToggleSwitch.Style>
                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
                <ItemsControl ItemsSource="{Binding MultiOptions}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiCheckbox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,14,7"
                                      Content="{Binding Value}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:CascadeSelector CascadeOptions="{Binding CascadeOptions}"
                                          SelectedValue="{Binding SelectedValue, Mode=TwoWay}">
                    <controls:CascadeSelector.Style>
                        <Style TargetType="controls:CascadeSelector">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCascadeSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:CascadeSelector.Style>
                </controls:CascadeSelector>
                <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding Type, StringFormat=不支持的脚本设置类型：{0}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </ResourceDictionary>
