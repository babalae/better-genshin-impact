<UserControl x:Class="BetterGenshinImpact.View.Controls.PuloniaTaskSettingsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
        任务设置编辑器（DataContext 为 PuloniaTaskSettingsEditorViewModel），新增与编辑弹窗共用：
        1. 独立任务声明了专属设置界面：ContentControl 通过启动时全局注册的隐式模板渲染专属视图
        2. 按参数 Schema 生成通用设置卡片，也补齐专属界面未编辑的参数
        3. 两者都没有：显示无需设置的提示
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PuloniaOneDragonParameterResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <!--  专属设置界面  -->
        <ContentControl Content="{Binding DedicatedSettings, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Focusable="False"
                        Visibility="{Binding HasDedicatedSettings, Converter={StaticResource FieldVisibility}, Mode=OneWay}" />

        <!--  通用设置卡片  -->
        <ui:CardExpander Margin="0,0,0,8" ContentPadding="16"
                         Visibility="{Binding HasFields, Mode=OneWay, Converter={StaticResource FieldVisibility}}">
            <ui:CardExpander.Style>
                <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDedicatedSettings, Mode=OneWay}" Value="False">
                            <Setter Property="IsExpanded" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:CardExpander.Style>
            <ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Text="更多任务设置" FontTypography="Body" />
                    <ui:TextBlock Text="展开配置此任务的其他执行参数。" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl Focusable="False"
                          ItemTemplate="{StaticResource OneDragonParameterFieldTemplate}"
                          ItemsSource="{Binding Fields, Mode=OneWay}"
                          Visibility="{Binding HasFields, Converter={StaticResource FieldVisibility}, Mode=OneWay}" />
        </ui:CardExpander>

        <!--  无需设置  -->
        <ui:CardControl Icon="{ui:SymbolIcon Info24}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource FieldVisibility}, Mode=OneWay}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="Body" Text="此任务无需额外设置" />
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Text="运行时直接使用任务默认配置。"
                                  TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
        </ui:CardControl>
    </StackPanel>
</UserControl>
