<ui:FluentWindow x:Class="BetterGenshinImpact.View.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
                 xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:markup="clr-namespace:BetterGenshinImpact.Markup"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModel="clr-namespace:BetterGenshinImpact.ViewModel"
                 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
                 Title="{Binding WindowTitle, Mode=OneWay}"
                 Icon="{Binding InstanceIconSource, Mode=OneWay}"
                 Width="1050"
                 Height="700"
                 d:Background="#D2D2D2"
                 d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource TextThemeFontFamily}"
                 Visibility="{Binding IsVisible, Mode=TwoWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterScreen"
                 WindowState="{Binding WindowState, Mode=TwoWay}"
                 mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- 子实例“当前账户”子菜单的账户项：显示名称与 UID 尾号，勾选当前账户，选择即修改。 -->
        <Style x:Key="ChildInstanceAccountMenuItemStyle"
               BasedOn="{StaticResource {x:Type MenuItem}}"
               TargetType="{x:Type MenuItem}">
            <Setter Property="Header" Value="{Binding DisplayText, Mode=OneWay}" />
            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding SelectCommand, Mode=OneWay}" />
        </Style>

    </Window.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Activated">
            <b:InvokeCommandAction Command="{Binding ActivatedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Closing">
            <b:InvokeCommandAction Command="{Binding ClosingCommand}" PassEventArgsToCommand="True" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 自定义背景图层：置于最底层（首个子元素），覆盖标题栏与内容区，不响应鼠标 -->
        <Image Grid.Row="0"
               Grid.RowSpan="2"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               IsHitTestVisible="False"
               Opacity="{Binding Config.CommonConfig.MainBackgroundOpacity, FallbackValue=0.35}"
               Source="{Binding MainBackgroundSource, TargetNullValue={x:Null}}"
               Stretch="{Binding Config.CommonConfig.MainBackgroundStretch, FallbackValue=UniformToFill}"
               Visibility="{Binding IsMainBackgroundVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Column="0"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="False"
                           OpenPaneLength="160">
            <b:Interaction.Behaviors>
                <behavior:AnimatedNavigationSelectionIndicatorBehavior />
            </b:Interaction.Behaviors>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{i18n:T 启动}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 实时触发}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:TriggerSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Timer24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{i18n:T 独立任务}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:TaskSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="TaskListSquareLtr24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 任务计划}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:PuloniaTaskPlanPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BranchFork24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- 新一条龙只是 Pulonia 任务计划的独立界面包装；验收前保留全部旧入口。 -->
                <ui:NavigationViewItem Content="新一条龙"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:PuloniaOneDragonPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AnimalTurtle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 执行记录}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:PuloniaTaskHistoryPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Pulonia 账户页：所有实例都显示。 -->
                <ui:NavigationViewItem Content="账户"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:PuloniaAccountsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PersonAccounts24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- 账号记录页面暂用「狛荷屋」展示名，待定案后再接入翻译。 -->
                <ui:NavigationViewItem Content="狛荷屋(test)"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:AccountRecordsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Box24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--<ui:NavigationViewItemSeparator />-->

                <ui:NavigationViewItem Content="{i18n:T 一条龙}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:OneDragonFlowPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AnimalTurtle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 全自动}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Bot24" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>

                        <!--<ui:NavigationViewItemSeparator />-->
                        <!--  ConvertRange20  -->
                        <ui:NavigationViewItem Content="{i18n:T 调度器}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:ScriptControlPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="DeveloperBoard24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <!--  WebAsset24 | DocumentJs16 | Script16  -->
                        <ui:NavigationViewItem Content="{i18n:T JS 脚本}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:JsListPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="DocumentJs16" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <!--  Map24  -->
                        <ui:NavigationViewItem Content="{i18n:T 地图追踪}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:MapPathingPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Map24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <!--  Script16  -->
                        <ui:NavigationViewItem Content="{i18n:T 录制回放}"
                                               NavigationCacheMode="Enabled"
                                               TargetPageType="{x:Type pages:KeyMouseRecordPage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Record24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 辅助操控}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:MacroSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="XboxController24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!--  按键宏：不识图的键鼠宏，见 Docs/design/key-macro.md  -->
                <ui:NavigationViewItem Content="{i18n:T 按键宏}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:KeyMacroPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="KeyboardLayoutFloat24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 自动演奏}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:MusicPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote224" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 悬浮小窗}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:GuideWindowSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                         <ui:SymbolIcon Symbol="VideoClip24" />
                     </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{i18n:T 快捷键}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:HotKeyPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!--<ui:NavigationViewItem Content="按键绑定"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:KeyBindingsSettingsPage}" Cursor="Hand">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="KeyboardMouse16" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>-->
                <ui:NavigationViewItem Content="{i18n:T 通知}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:NotificationSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Alert24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!--  插件：功能选择与插件管理，见 Docs/design/plugin-system.md 第 13 节  -->
                <ui:NavigationViewItem Content="{i18n:T 插件}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:PluginsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{i18n:T 设置}"
                                       NavigationCacheMode="Enabled"
                                       TargetPageType="{x:Type pages:CommonSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <!-- 兑换码更新通知卡片 -->
                    <Border CornerRadius="8"
                            MinWidth="240"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,12,0"
                            Cursor="Hand"
                            Visibility="{Binding IsRedeemCodeInfoBarOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseLeftButtonDown">
                                <b:InvokeCommandAction Command="{Binding OpenFeedCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.2" ShadowDepth="2" BlurRadius="16"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                    CornerRadius="4,0,0,4"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    CornerRadius="0"
                                    Padding="14,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{i18n:T 🎁 有新的兑换码可用}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="{i18n:T 点击查看详情}"/>
                                </StackPanel>
                            </Border>
                            <!-- 右侧关闭按钮区域 -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    CornerRadius="0,4,4,0"
                                    Padding="6,0,8,0">
                                <ui:Button Width="28" Height="28"
                                           Padding="0"
                                           VerticalAlignment="Center"
                                           Background="Transparent"
                                           BorderBrush="Transparent"
                                           CornerRadius="4"
                                           Icon="{ui:SymbolIcon Dismiss16}"
                                           Command="{Binding DismissRedeemCodeCommand}"
                                           ToolTip="{i18n:T 关闭}" />
                            </Border>
                        </Grid>
                    </Border>
                    <!--
                        UID 不一致提示（统筹设计 4.4）：跟随当前账户的运行开始时游戏中读到的 UID 与本实例当前账户不一致。
                        目录中有读到的 UID 对应的账户时提供“改为该账户”，修改从下一次运行开始生效；关闭或修改当前账户后消失。
                    -->
                    <Border MaxWidth="420"
                            Margin="0,8,12,0"
                            Padding="14,12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsUidMismatchNoticeOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="2" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="游戏中的 UID 与当前账户不一致" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding UidMismatchNoticeText, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <ui:Button Margin="0,8,0,0"
                                           Appearance="Caution"
                                           Command="{Binding ApplyAccountSuggestionCommand, Mode=OneWay}"
                                           Content="{Binding AccountSuggestionButtonText, Mode=OneWay}"
                                           Icon="{ui:SymbolIcon PersonSwap24}"
                                           ToolTip="把本实例当前账户改为游戏中读到的 UID 对应的账户，下一次运行开始时生效"
                                           Visibility="{Binding HasAccountSuggestion, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                       Width="28"
                                       Height="28"
                                       Margin="8,0,0,0"
                                       Padding="0"
                                       VerticalAlignment="Top"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       Command="{Binding DismissUidMismatchNoticeCommand, Mode=OneWay}"
                                       Icon="{ui:SymbolIcon Dismiss16}"
                                       ToolTip="关闭"
                                       AutomationProperties.Name="关闭 UID 不一致提示" />
                        </Grid>
                    </Border>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:TitleBar Grid.Row="0" Grid.Column="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{Binding InstanceIconSource, Mode=OneWay}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <b:Interaction.Behaviors>
                        <behavior:WindowDragBehavior />
                    </b:Interaction.Behaviors>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Title, Mode=OneWay}" />
                    <Border Height="22"
                            Margin="8,0,0,0"
                            Padding="8,0"
                            VerticalAlignment="Center"
                            Background="{Binding InstanceAccentBrush, Mode=OneWay}"
                            CornerRadius="11"
                            Visibility="{Binding IsInstanceIdentityVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding InstanceTagText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <!-- Pulonia 账户徽标：账户目录有多个账户时显示本实例当前账户，点击改为其他账户或管理账户；
                         当前账户未确定或最近一次 UID 比对不一致时显示提示色，悬停说明原因。 -->
                    <Grid Margin="0,0,6,0"
                          VerticalAlignment="Top"
                          Visibility="{Binding IsAccountBadgeVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 下拉打开时按钮不响应点击，避免点击按钮关闭下拉后又立即打开 -->
                        <ui:Button Height="32"
                                   Padding="8,0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   Command="{Binding OpenAccountMenuCommand, Mode=OneWay}"
                                   CornerRadius="0"
                                   IsHitTestVisible="{Binding IsAccountMenuOpen, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                   ToolTip="{Binding AccountBadgeToolTip, Mode=OneWay}"
                                   AutomationProperties.Name="{Binding AccountBadgeText, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Symbol="PersonAccounts24"
                                               Visibility="{Binding IsAccountBadgeWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:SymbolIcon Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Symbol="PersonWarning24"
                                               Visibility="{Binding IsAccountBadgeWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock MaxWidth="160"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="{Binding AccountBadgeText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccountBadgeWarning, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:SymbolIcon Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Symbol="ChevronDown16" />
                            </StackPanel>
                        </ui:Button>
                        <!-- 下拉的定位点在按钮右下角，以 Left 方式展开：顶边对齐按钮底边，右边缘对齐按钮右边缘 -->
                        <ui:Flyout MinWidth="0"
                                   MinHeight="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   IsOpen="{Binding IsAccountMenuOpen, Mode=TwoWay}"
                                   Placement="Left">
                            <StackPanel MinWidth="240" MaxWidth="360">
                                <!-- UID 比对不一致且目录中有读到的 UID 对应的账户时，一键改为该账户 -->
                                <ui:Button Margin="0,0,0,6"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Appearance="Caution"
                                           Command="{Binding ApplyAccountSuggestionCommand, Mode=OneWay}"
                                           Icon="{ui:SymbolIcon PersonWarning24}"
                                           Visibility="{Binding HasAccountSuggestion, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AccountSuggestionText, Mode=OneWay}" TextWrapping="Wrap" />
                                </ui:Button>
                                <TextBlock Margin="8,0,0,4"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="本实例当前账户" />
                                <ItemsControl ItemsSource="{Binding BadgeAccounts, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Left"
                                                       Appearance="Transparent"
                                                       BorderThickness="0"
                                                       Command="{Binding SelectCommand, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="16" Margin="0,0,8,0">
                                                        <ui:SymbolIcon FontSize="14"
                                                                       Symbol="Checkmark16"
                                                                       Visibility="{Binding IsCurrent, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding DisplayText, Mode=OneWay}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,6" />
                                <ui:Button HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Appearance="Transparent"
                                           BorderThickness="0"
                                           Command="{Binding ManageAccountsCommand, Mode=OneWay}"
                                           Content="管理账户"
                                           Icon="{ui:SymbolIcon Settings24}" />
                            </StackPanel>
                        </ui:Flyout>
                    </Grid>
                    <!-- 主实例在线子实例入口：直接展示前三个，其余实例收进“+N”菜单。 -->
                    <Border Margin="0,2,8,0"
                            Padding="4,0"
                            Height="32"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasConnectedChildInstances, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding VisibleConnectedChildInstances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="30"
                                              Height="30"
                                              Margin="0,0,2,0"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <b:Interaction.Behaviors>
                                                <behavior:TitleBarContextMenuBehavior />
                                            </b:Interaction.Behaviors>
                                            <Grid.ContextMenu>
                                                <!-- ContextMenu 不在可视树中，通过 PlacementTarget 取回实例项和主窗口 ViewModel。 -->
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <ui:MenuItem Header="{i18n:T 打开实例}"
                                                                 Command="{Binding PlacementTarget.Tag.ActivateConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                 CommandParameter="{Binding}"
                                                                 Icon="{ui:SymbolIcon Open24}" />
                                                    <!-- 子实例的 Pulonia 当前账户：只在账户目录有多个账户时显示，选择即写入共享设置文件。 -->
                                                    <ui:MenuItem Header="{Binding AccountMenuHeader, Mode=OneWay}"
                                                                 Icon="{ui:SymbolIcon PersonAccounts24}"
                                                                 ItemContainerStyle="{StaticResource ChildInstanceAccountMenuItemStyle}"
                                                                 ItemsSource="{Binding AccountOptions, Mode=OneWay}"
                                                                 Visibility="{Binding HasAccount, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Separator />
                                                    <ui:MenuItem Header="{i18n:T 关闭实例}"
                                                                 Command="{Binding PlacementTarget.Tag.CloseConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                 CommandParameter="{Binding}"
                                                                 Icon="{ui:SymbolIcon Dismiss24}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <ui:Button Width="28"
                                                       Height="28"
                                                       Padding="0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Command="{Binding DataContext.ActivateConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       CornerRadius="14"
                                                       ToolTip="{Binding ToolTip}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="{Binding Icon}" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,0,2"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom"
                                                     Panel.ZIndex="1"
                                                     Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                                     IsHitTestVisible="False"
                                                     Stroke="{DynamicResource ControlFillColorDefaultBrush}"
                                                     StrokeThickness="1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:DropDownButton Height="28"
                                               MinWidth="38"
                                               Margin="0,1,0,0"
                                               Padding="8,0"
                                               Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                               BorderBrush="Transparent"
                                               Content="{Binding ConnectedInstanceOverflowCount, StringFormat=+{0}}"
                                               CornerRadius="6"
                                               ToolTip="{i18n:T 查看全部在线子实例}"
                                               Visibility="{Binding HasConnectedInstanceOverflow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 ItemsSource="{Binding ConnectedChildInstances}">
                                        <ContextMenu.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Margin="0,0,8,0" Symbol="{Binding Icon}" />
                                                    <!-- 账户目录有多个账户时显示“实例名 — 当前账户”。 -->
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding MenuText, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContextMenu.ItemTemplate>
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Command"
                                                        Value="{Binding DataContext.ActivateConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                                <Setter Property="Tag"
                                                        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <Setter Property="ContextMenu">
                                                    <Setter.Value>
                                                        <!-- “+N”列表项同样支持右键操作，PlacementTarget.Tag 保存主窗口 ViewModel。 -->
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <ui:MenuItem Header="{i18n:T 打开实例}"
                                                                         Command="{Binding PlacementTarget.Tag.ActivateConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                         CommandParameter="{Binding}"
                                                                         Icon="{ui:SymbolIcon Open24}" />
                                                            <ui:MenuItem Header="{Binding AccountMenuHeader, Mode=OneWay}"
                                                                         Icon="{ui:SymbolIcon PersonAccounts24}"
                                                                         ItemContainerStyle="{StaticResource ChildInstanceAccountMenuItemStyle}"
                                                                         ItemsSource="{Binding AccountOptions, Mode=OneWay}"
                                                                         Visibility="{Binding HasAccount, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <Separator />
                                                            <ui:MenuItem Header="{i18n:T 关闭实例}"
                                                                         Command="{Binding PlacementTarget.Tag.CloseConnectedInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                                         CommandParameter="{Binding}"
                                                                         Icon="{ui:SymbolIcon Dismiss24}" />
                                                        </ContextMenu>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </StackPanel>
                    </Border>
                    <!-- 下载中心：本次运行有下载任务时显示；图标外圈为进行中任务的总进度，有失败任务时显示红点 -->
                    <Grid DataContext="{Binding DownloadCenter, Mode=OneWay}"
                          Visibility="{Binding HasItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 弹出层打开时按钮不响应点击，避免点击按钮关闭弹出层后又立即打开 -->
                        <ui:Button Width="40"
                                   Height="32"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderBrush="Transparent"
                                   Command="{Binding OpenCommand}"
                                   CornerRadius="0"
                                   IsHitTestVisible="{Binding IsOpen, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                   ToolTip="{Binding ButtonToolTip, Mode=OneWay}">
                            <Grid Width="24" Height="24">
                                <ui:ProgressRing Width="24"
                                                 Height="24"
                                                 IsIndeterminate="{Binding IsOverallIndeterminate, Mode=OneWay}"
                                                 Progress="{Binding OverallProgress, Mode=OneWay}"
                                                 Visibility="{Binding HasActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Symbol="ArrowDownload24" />
                                <Ellipse Width="8"
                                         Height="8"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="{DynamicResource SystemFillColorCriticalBrush}"
                                         IsHitTestVisible="False"
                                         Visibility="{Binding HasFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ui:Button>
                        <!-- 弹出层的定位点在按钮右下角，以 Left 方式展开：顶边对齐按钮底边，右边缘对齐按钮右边缘 -->
                        <ui:Flyout MinWidth="0"
                                   MinHeight="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   IsOpen="{Binding IsOpen, Mode=TwoWay}"
                                   Placement="Left">
                            <controls:DownloadCenterView />
                        </ui:Flyout>
                    </Grid>
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding OpenFeedCommand}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon Gift16}"
                               Foreground="{Binding RedeemCodeButtonForeground}"
                               ToolTip="{i18n:T 获取兑换码信息}" />
                    <ui:Button Width="40"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding SwitchBackdropCommand}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon Blur24}"
                               ToolTip="{i18n:T 切换深浅主题或背景样式}" />
                    <ui:Button Width="32"
                               Height="32"
                               Background="Transparent"
                               BorderBrush="Transparent"
                               Command="{Binding HideCommand}"
                               CornerRadius="0"
                               Icon="{ui:SymbolIcon CaretDown24}"
                               ToolTip="{i18n:T 最小化到托盘}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <tray:NotifyIcon Grid.Row="0" Grid.Column="0"
                         FocusOnLeftClick="False"
                         Icon="{Binding InstanceIconSource, Mode=OneWay}"
                         LeftDoubleClick="OnNotifyIconLeftDoubleClick"
                         MenuOnRightClick="True"
                         TooltipText="{Binding TrayTooltipText, Mode=OneWay}">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <ContextMenu.DataContext>
                        <markup:ServiceLocator Type="{x:Type viewModel:NotifyIconViewModel}" />
                    </ContextMenu.DataContext>
                    <ui:MenuItem Header="{Binding InstanceDisplayName, Mode=OneWay}"
                                 IsEnabled="False"
                                 Visibility="{Binding IsInstanceIdentityVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:MenuItem.Icon>
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{Binding InstanceAccentBrush, Mode=OneWay}" />
                        </ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator Visibility="{Binding IsInstanceIdentityVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:MenuItem Command="{Binding ShowOrHideCommand}"
                                 Header="{i18n:T 显示或隐藏此实例窗口}"
                                 Icon="{ui:SymbolIcon Window24}" />
                    <Separator />
                    <ui:MenuItem Command="{Binding OpenChildSessionWindowCommand}"
                                  Header="{i18n:T 桌面分身}"
                                  Icon="{ui:SymbolIcon DesktopCursor24}"
                                  Visibility="{Binding IsPrimaryInstance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!--  悬浮小窗：只在主实例提供  -->
                    <ui:MenuItem Header="{i18n:T 悬浮小窗}"
                                 Icon="{ui:SymbolIcon VideoClip24}"
                                 Visibility="{Binding IsGuideWindowAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:MenuItem Command="{Binding ToggleGuideWindowCommand}"
                                     Header="{Binding GuideToggleText, Mode=OneWay}"
                                     Icon="{ui:SymbolIcon PictureInPicture24}" />
                        <ui:MenuItem Command="{Binding OpenGuideFromClipboardCommand}"
                                     Header="{i18n:T 打开剪贴板中的链接}"
                                     Icon="{ui:SymbolIcon ClipboardLink24}" />
                        <ui:MenuItem Command="{Binding RestoreGuideWindowCommand}"
                                     Header="{i18n:T 恢复小窗（关闭穿透、不透明）}"
                                     Icon="{ui:SymbolIcon ArrowReset24}" />
                        <Separator />
                        <ui:MenuItem Command="{Binding OpenGuideSettingsCommand}"
                                     Header="{i18n:T 小窗设置}"
                                     Icon="{ui:SymbolIcon Settings24}" />
                    </ui:MenuItem>
                    <Separator Visibility="{Binding IsPrimaryInstance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:MenuItem Command="{Binding CheckUpdateCommand}"
                                 Header="{i18n:T 检查更新}"
                                 Icon="{ui:SymbolIcon ArrowAutofitUp24}"
                                 Visibility="{Binding IsPrimaryInstance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Separator Visibility="{Binding IsPrimaryInstance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:MenuItem Command="{Binding ExitCommand}"
                                 Header="{Binding ExitMenuText, Mode=OneWay}"
                                 Icon="{ui:SymbolIcon Dismiss24}" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
