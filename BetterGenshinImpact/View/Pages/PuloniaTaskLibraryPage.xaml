<UserControl x:Class="BetterGenshinImpact.View.Pages.PuloniaTaskLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
             d:DataContext="{d:DesignInstance Type=pages:PuloniaTaskLibraryViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="任务库" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="搜索已注册能力和本地资源；先预览、配置并固定版本，再一次性加入任务计划。" />
            </StackPanel>
            <!-- 工具入口独占一行，窄窗口下不再与标题和说明互相挤压。 -->
            <WrapPanel Grid.Row="1"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Right"
                       Orientation="Horizontal">
                <ui:Button Margin="0,0,6,0"
                           Command="{Binding ViewModel.OpenPathingToolsCommand}"
                           Content="路线录制与编辑" />
                <ui:Button Margin="0,0,6,0"
                           Command="{Binding ViewModel.OpenJavaScriptToolsCommand}"
                           Content="JS 工具" />
                <ui:Button Margin="0,0,6,0"
                           Command="{Binding ViewModel.OpenKeyMouseToolsCommand}"
                           Content="录制回放工具" />
                <ui:Button Margin="0,0,6,0"
                           Command="{Binding ViewModel.OpenResourceRepositoryCommand}"
                           Content="资源来源与下载" />
                <ui:Button Command="{Binding ViewModel.RefreshCommand}"
                           Content="刷新任务库" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="搜索名称、目录或任务类型"
                                ClearButtonEnabled="True"
                                Icon="{ui:SymbolIcon Search24}" />
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ViewModel.Categories}"
                                  SelectedItem="{Binding ViewModel.SelectedCategory, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding ViewModel.Scopes}"
                                  SelectedItem="{Binding ViewModel.SelectedScope, Mode=TwoWay}" />
                    </Grid>
                    <ListBox Grid.Row="2"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding ViewModel.FilteredItems}"
                             SelectedItem="{Binding ViewModel.SelectedItem, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="58" Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="6,2"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                            <TextBlock FontSize="10" Text="{Binding TypeLabel}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding SecondaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SecondaryText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{Binding ViewModel.SelectedItem.DisplayName, FallbackValue=资源详情, TargetNullValue=资源详情}" />
                        <TextBlock Margin="0,4,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ViewModel.SelectedItem.Definition.Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             Padding="0"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             Text="{Binding ViewModel.PreviewText}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="目标计划" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="140"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding ViewModel.TargetPlans}"
                                      SelectedItem="{Binding ViewModel.SelectedTargetPlan, Mode=TwoWay}" />
                            <ui:Button Grid.Column="2"
                                       Margin="12,0,0,0"
                                       MinWidth="150"
                                       Appearance="Primary"
                                       Command="{Binding ViewModel.AddSelectedCommand}"
                                       Content="配置并添加到计划" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="确认弹窗中可继续修改名称、目录模式和运行设置。"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding ViewModel.StatusMessage}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="1"
                         Width="120"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>
    </Grid>
</UserControl>
