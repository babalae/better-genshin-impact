<UserControl x:Class="BetterGenshinImpact.View.Pages.AccountRecordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             xmlns:records="clr-namespace:BetterGenshinImpact.Service.AccountRecords"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <b:Interaction.Behaviors>
        <behavior:AccountRecordsDeferredLoadBehavior Command="{Binding LoadCommand, Mode=OneWay}" />
    </b:Interaction.Behaviors>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction Command="{Binding CloseUidPopupsCommand, Mode=OneWay}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <UserControl.Resources>
        <behavior:BindingProxy x:Key="AccountRecordsProxy" Data="{Binding Mode=OneWay}" />
    </UserControl.Resources>
    <Grid Margin="22,16,16,12" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="任务运行中：人工数据修改已锁定，任务上报及查看、搜索、排序不受影响。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocked, Source={x:Static records:AccountRecordsInteractionGate.Instance}, Mode=OneWay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="AccountRecordsToolbar" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="AccountRecordsAccountMenu" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="狛荷屋"
                           FontSize="24" FontWeight="SemiBold" Margin="0,4,16,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button Appearance="Primary" Height="34"
                           Margin="0,0,8,0" ToolTip="导入数据"
                           Command="{Binding OpenPlaceholderCommand, Mode=OneWay}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowEnter20" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform><RotateTransform Angle="90" /></ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </ui:Button.Icon>
                </ui:Button>
                <ui:DropDownButton Icon="{ui:SymbolIcon MoreHorizontal24}" Height="34"
                                   Margin="0,0,12,0" ToolTip="当前页签的更多操作">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="刷新库存" Command="{Binding Data.Inventory.RefreshCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <MenuItem Header="事件记录…" Command="{Binding Data.Inventory.OpenEventsCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="all" />
                            <MenuItem Header="新增库存记录…" Command="{Binding Data.Inventory.AddCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" IsEnabled="{Binding Data.Inventory.HasUid, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Header="快照设置">
                                <MenuItem Header="查看快照（未建设）" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="自动日期快照" IsCheckable="True"
                                          IsChecked="{Binding Data.Inventory.SnapshotsEnabled, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}"
                                          Command="{Binding Data.Inventory.ToggleSnapshotsCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                <MenuItem Header="快照保留数量…" Command="{Binding Data.Inventory.SetRetentionCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="snapshots" />
                            </MenuItem>
                            <MenuItem Header="导入库存…" Command="{Binding Data.OpenImportCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <MenuItem Header="导出库存…" Command="{Binding Data.ExportInventoryCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Header="优先显示来源名称" IsCheckable="True"
                                      IsChecked="{Binding Data.Inventory.PreferReadableSource, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}"
                                      Command="{Binding Data.Inventory.ToggleSourceNamesCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <MenuItem Header="恢复所有分页默认栏宽" Command="{Binding Data.ResetColumnWidthsCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Header="高级">
                                <!--  仅占位：未来可以考虑追溯来源的可靠性、来源的判断等。  -->
                                <MenuItem Header="追踪来源提醒（未建设）" IsCheckable="True" IsChecked="False" IsEnabled="False"
                                          ToolTip="功能尚未建设。" />
                                <MenuItem Header="自定义提醒规则…" ToolTip="InventoryRules 可配置多条独立规则，每条使用自己的 Id、条件和 Message；保存后刷新或等待一分钟，示例默认禁用。"
                                          Command="{Binding Data.Inventory.EditWarningRulesCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                <MenuItem Header="查看物品字典…" Command="{Binding Data.Inventory.ViewDictionaryCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="items" />
                                <MenuItem Header="查看补充字典…" Command="{Binding Data.Inventory.ViewDictionaryCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="user" />
                                <MenuItem Header="查看来源字典…" Command="{Binding Data.Inventory.ViewDictionaryCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="sources" />
                                <Separator />
                                <MenuItem Header="来源记录保留数量…" Command="{Binding Data.Inventory.SetRetentionCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="recent" />
                                <MenuItem Header="事件保留数量…" Command="{Binding Data.Inventory.SetRetentionCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="events" />
                                <Separator />
                                <MenuItem Header="使用图像缓存" IsCheckable="True"
                                          ToolTip="所有子表共用；关闭仅停用图片缓存，不删除文件。"
                                          IsChecked="{Binding Data.Inventory.UseImageCache, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}"
                                          Command="{Binding Data.Inventory.ToggleImageCacheCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                <MenuItem Header="无图像时显示行号" IsCheckable="True"
                                          IsChecked="{Binding Data.Inventory.ShowMissingIconRowNumbers, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}"
                                          Command="{Binding Data.Inventory.ToggleMissingIconRowNumbersCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                <MenuItem Header="清理所有图像缓存…" Command="{Binding Data.Inventory.ClearIconCacheCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                <MenuItem Header="重置为预设值…" Command="{Binding Data.ResetToDefaultsCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                            </MenuItem>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>
            <ui:DropDownButton Grid.Column="2" Icon="{ui:SymbolIcon MoreVertical24}" Height="34" Width="20" MinWidth="0"
                               Padding="0" Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                               Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="账号菜单">
                <!-- 账号菜单仅显示竖向省略号，不占用 UID 与搜索框的宽度。 -->
                <ui:DropDownButton.Template>
                    <ControlTemplate TargetType="ui:DropDownButton">
                        <Border x:Name="MenuBackground" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Icon}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Focusable="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBackground" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuBackground" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ui:DropDownButton.Template>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="清空库存记录…" Command="{Binding Data.ClearAccountCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="inventory" />
                        <Separator />
                        <MenuItem Header="删除 UID 及全部账号数据…" Command="{Binding Data.ClearAccountCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" CommandParameter="uid" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
            <Grid x:Name="UidToolbar" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="UID" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <!-- 标准选择控件管理展开和选择；新增入口独立于 UID 集合，删除通过账号菜单执行。 -->
                <ComboBox x:Name="UidSelector" Grid.Column="1" Width="132" MinHeight="34" FontSize="14"
                          ItemsSource="{Binding UidOptions, Mode=OneWay}"
                          SelectedItem="{Binding SelectedUid, Mode=TwoWay}"
                          IsDropDownOpen="{Binding IsUidDropDownOpen, Mode=TwoWay}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          HorizontalContentAlignment="Stretch"
                          ToolTip="选择 UID，或通过下拉列表中的＋新增">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="32" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Mode=OneWay}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:SymbolIcon x:Name="SelectionMark" Grid.Column="1" Symbol="Checkmark16"
                                               FontSize="12" Visibility="Collapsed"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Mode=OneWay}" Value="True">
                                    <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                              Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Background="{DynamicResource ControlFillColorDefaultBrush}"
                                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                              Content="{TemplateBinding SelectionBoxItem}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="SelectorBorder" Padding="8,4" BorderThickness="1" CornerRadius="6"
                                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown16" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{TemplateBinding Foreground}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelectorBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="SelectorBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                            BorderThickness="1" CornerRadius="6"
                                            Background="{DynamicResource ApplicationBackgroundBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <!-- 新增按钮固定在下拉框底部，不参与账号选择或排序。 -->
                                            <ui:Button DockPanel.Dock="Bottom" Content="＋" Padding="0" Width="32" MinWidth="0" Height="32"
                                                       HorizontalAlignment="Right" HorizontalContentAlignment="Center" Appearance="Transparent"
                                                       BorderThickness="0" BorderBrush="Transparent"
                                                       ToolTip="新增 UID"
                                                       Command="{Binding DataContext.BeginAddUidCommand, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                            <ScrollViewer MaxHeight="256" CanContentScroll="True"
                                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ComboBox.Template>
                </ComboBox>
            </Grid>
            <!-- 浮窗锚点覆盖 UID 工具栏与账号菜单，右边缘随菜单按钮对齐。 -->
            <Border x:Name="UidPopupAnchor" Grid.Column="1" Grid.ColumnSpan="2" IsHitTestVisible="False" />
            <Popup PlacementTarget="{Binding ElementName=UidPopupAnchor}" Placement="Bottom" VerticalOffset="4"
                   IsOpen="{Binding IsAddingUid, Mode=TwoWay}"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                <Border Width="{Binding ActualWidth, ElementName=UidPopupAnchor, Mode=OneWay}" Padding="12"
                        CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="新增 UID" Margin="0,0,0,8" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBox Text="{Binding PendingUid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="输入 UID" MaxLength="20">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddUidCommand, Mode=OneWay}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelAddUidCommand, Mode=OneWay}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <TextBlock Text="{Binding UidValidationMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <ui:Button Content="取消" Command="{Binding CancelAddUidCommand, Mode=OneWay}" Margin="0,0,8,0" />
                            <ui:Button Content="添加" Command="{Binding AddUidCommand, Mode=OneWay}" Appearance="Primary" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        <!-- 库存分页已接入数据与筛选；材料需求、活动日历暂保留独立占位。 -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel>
                                    <ContentPresenter Content="{Binding Mode=OneWay}" />
                                    <!-- 指示条跟随页签选中状态，并使用当前主题的强调色。 -->
                                    <Border x:Name="SelectionIndicator" Height="3" Margin="0,6,0,0" CornerRadius="1.5"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}, Mode=OneWay}" Value="True">
                                        <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 页签和搜索框在同一行分列排布，右列与 UID 工具栏共享宽度。 -->
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AccountRecordsToolbar" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AccountRecordsAccountMenu" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" Height="1" Margin="0,0,0,4" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,0,16,8" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Column="1" Height="34" Margin="0,0,0,8" VerticalAlignment="Center"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{Binding SearchPlaceholder, Mode=OneWay}"
                                        Icon="{ui:SymbolIcon Search20}">
                                <!-- 页签标题下方含指示条，搜索框仅视觉上移，不改变上方 UID 的布局。 -->
                                <ui:TextBox.RenderTransform>
                                    <TranslateTransform Y="-5" />
                                </ui:TextBox.RenderTransform>
                            </ui:TextBox>
                            <ui:DropDownButton Grid.Column="2" Width="20" MinWidth="0" Height="34" Padding="0"
                                               Margin="4,0,0,8" VerticalAlignment="Center" ToolTip="筛选库存类型"
                                               AutomationProperties.Name="筛选库存类型">
                                <ui:DropDownButton.RenderTransform><TranslateTransform Y="-5" /></ui:DropDownButton.RenderTransform>
                                <ui:DropDownButton.Style>
                                    <Style TargetType="ui:DropDownButton" BasedOn="{StaticResource {x:Type ui:DropDownButton}}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ui:DropDownButton">
                                                    <Border x:Name="FilterBackground" Background="Transparent" CornerRadius="4">
                                                        <ui:SymbolIcon Symbol="Filter24" FontSize="16" Foreground="{TemplateBinding Foreground}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FilterBackground" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="FilterBackground" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="FilterBackground" Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Inventory.HasCategoryFilter, Mode=OneWay}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTabIndex, Mode=OneWay}" Value="1"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedTabIndex, Mode=OneWay}" Value="2"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:DropDownButton.Style>
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu MinWidth="220" MaxHeight="420">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Name, Mode=OneWay}" />
                                                <Setter Property="IsCheckable" Value="True" />
                                                <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                <Setter Property="StaysOpenOnClick" Value="True" />
                                            </Style>
                                        </ContextMenu.Resources>
                                        <ContextMenu.ItemsSource>
                                            <CompositeCollection>
                                                <MenuItem Header="全部类型" IsCheckable="True" StaysOpenOnClick="True"
                                                          IsChecked="{Binding Data.Inventory.AllCategoriesSelected, Source={StaticResource AccountRecordsProxy}, Mode=TwoWay}" />
                                                <Separator />
                                                <CollectionContainer Collection="{Binding Data.Inventory.Categories, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                                <Separator />
                                                <MenuItem IsCheckable="False" IsChecked="False" StaysOpenOnClick="True">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:Button Content="重置" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0"
                                                                       Command="{Binding Data.Inventory.ResetCategoriesCommand, Source={StaticResource AccountRecordsProxy}, Mode=OneWay}" />
                                                            <ui:Button Content="确认" Icon="{ui:SymbolIcon Checkmark16}">
                                                                <b:Interaction.Triggers>
                                                                    <b:EventTrigger EventName="Click">
                                                                        <behavior:CloseContainingMenuAction />
                                                                    </b:EventTrigger>
                                                                </b:Interaction.Triggers>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                </MenuItem>
                                            </CompositeCollection>
                                        </ContextMenu.ItemsSource>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </Grid>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,8,0,0"
                                          ContentSource="SelectedContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="库存记录">
                <controls:AccountRecordsInventoryView DataContext="{Binding Inventory, Mode=OneWay}" />
            </TabItem>
            <TabItem Header="材料需求">
                <controls:AccountRecordsEmptyState />
            </TabItem>
            <TabItem Header="活动日历">
                <controls:AccountRecordsEmptyState />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
