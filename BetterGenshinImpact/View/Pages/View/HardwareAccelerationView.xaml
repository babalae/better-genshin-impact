<UserControl x:Class="BetterGenshinImpact.View.Pages.View.HardwareAccelerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages.View"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
             Width="800"
             d:DataContext="{d:DesignInstance Type=pages:HardwareAccelerationViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{i18n:T 硬件加速设置}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" Margin="{StaticResource PagePadding}">
            <!--  当前运行时状态  -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16">
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong"
                                  Text="{i18n:T ONNX Runtime 状态}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{i18n:T 当前实际运行时：}" /><Run Text="{Binding EffectiveRuntimeText}" />
                    </TextBlock>
                    <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{i18n:T 下次启动使用：}" /><Run Text="{Binding NextRuntimeText}" />
                    </TextBlock>
                    <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="ORT Core：" /><Run Text="{Binding OrtVersion}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StartupDiagnostic}"
                               TextWrapping="Wrap"
                               Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding PageMessage}"
                               TextWrapping="Wrap"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StorageStatus}"
                               TextWrapping="Wrap"
                               Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding RestartRequired, StringFormat=需要重启：{0}}"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
            <!--  推理设备配置  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Settings24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 推理设备配置}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" Text="{i18n:T 修改后需要重启程序生效，不正确的修改可能会导致程序异常}" />
                    </Grid>
                    <!-- <TextBlock FontWeight="SemiBold" Text="推理设备配置" /> -->
                </ui:CardExpander.Header>
                <StackPanel>
                    <!--  Inference Device  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 推理设备类型}" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  MinWidth="180"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding ProviderOptions}"
                                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 选择推理使用的硬件设备类型 默认使用CPU}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前加载：}" /><Run Text="{Binding ProviderTypesText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!--  具体推理设备  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 具体推理设备}" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  MinWidth="300"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding InferenceDevices}"
                                  SelectedItem="{Binding SelectedInferenceDevice, Mode=TwoWay}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 支持选择 DirectML 显卡、CUDA GPU，以及 OpenVINO 的 Intel CPU、GPU 和 NPU。}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <!--  缓存管理  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 缓存文件管理}" />
                        <ui:Button Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Command="{Binding OpenCacheFolderCommand}"
                                   Content="{i18n:T 打开缓存目录}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 旧版本的缓存文件可以手动删除。}" />
                    </Grid>
                    <!--  CPU OCR  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 强制OCR使用CPU}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.CpuOcr, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 解决部分GPU推理性能和报错问题 默认开启}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前状态：}" /><Run Text="{Binding Status.CpuOcr, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!--  GPU Device  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T GPU设备ID}" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    MinWidth="80"
                                    Text="{Binding Config.GpuDevice, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 指定使用的GPU设备编号 使用默认配置请设为0 可以在任务管理器中查看编号}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前DML设备：}" /><Run Text="{Binding Status.DmlDeviceId, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!--  _optimizedModel  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 是否输出优化后的模型文件到缓存}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.OptimizedModel, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 注意:在不支持的执行器上使用会导致异常。默认关闭。}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前状态：}" /><Run Text="{Binding Status.OptimizedModel, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                </StackPanel>
            </ui:CardExpander>
            <!--  Plugin EP 包管理  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon ArrowDownload24}"
                             IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T Plugin EP 包管理}" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 包安装在程序目录 ort 下，安装、更新和卸载均在重启后生效。}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center"
                                      Text="{i18n:T 打开此页面时会检查包更新，但不会自动下载。}"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Command="{Binding RefreshCommand}"
                                   Content="{i18n:T 刷新}" />
                        <ui:Button Grid.Column="2"
                                   Margin="8,0,0,0"
                                   Command="{Binding OpenPluginFolderCommand}"
                                   Content="{i18n:T 打开 ort 目录}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PluginPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="16,0,16,12"
                                        Padding="12"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <ui:TextBlock FontTypography="BodyStrong"
                                                          Text="{Binding Descriptor.DisplayName}" />
                                            <TextBlock Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}">
                                                <!-- Run.Text 默认可能采用双向绑定，只读展示属性必须显式使用 OneWay。 -->
                                                <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" · " />
                                                <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " />
                                                <Run Text="{Binding DownloadSizeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,6,0,0"
                                                   Text="{Binding Descriptor.Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding RequirementsText}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding StatusMessage}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="0,8,12,0">
                                            <ProgressBar Height="4"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding DownloadProgress}" />
                                            <TextBlock Text="{Binding ProgressText}"
                                                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <WrapPanel Grid.Row="4"
                                                   Grid.Column="1"
                                                   Margin="0,8,0,0">
                                            <ui:Button Margin="4,0"
                                                       Command="{Binding DataContext.InstallPluginCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="{i18n:T 下载／更新}"
                                                       IsEnabled="{Binding CanDownload}" />
                                            <ui:Button Margin="4,0"
                                                       Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                       Content="{i18n:T 取消}"
                                                       IsEnabled="{Binding IsBusy}" />
                                            <ui:Button Margin="4,0"
                                                        Command="{Binding DataContext.SelectPluginCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{i18n:T 设为当前}"
                                                        IsEnabled="{Binding CanSelect}" />
                                             <ui:Button Margin="4,0"
                                                        Command="{Binding DataContext.UninstallPluginCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{i18n:T 卸载}"
                                                        IsEnabled="{Binding CanUninstall}" />
                                            <ui:Button Margin="4,0"
                                                       Command="{Binding DataContext.OpenPluginFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="{i18n:T 打开目录}" />
                                            <ui:Button Margin="4,0"
                                                       Command="{Binding DataContext.ShowPluginDependenciesCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="{i18n:T 依赖说明}" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:CardExpander>
            <!--  CUDA配置  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Settings24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T CUDA配置}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" Text="{i18n:T 修改后需要重启程序生效。}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <!--  CUDA Plugin EP 主版本  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T CUDA 运行时版本}" />
                        <ComboBox Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Grid.Column="1"
                                  MinWidth="120"
                                  ItemsSource="{Binding CudaRuntimeMajors}"
                                  SelectedItem="{Binding SelectedCudaRuntime, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T Auto 会选择依赖可用的最高已安装版本，需要系统 CUDA 12／13 和 cuDNN 9。}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <!--  CUDA Device  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T CUDA设备ID}" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    MinWidth="80"
                                    Text="{Binding Config.CudaDevice, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 指定CUDA设备编号 使用默认配置请设为0 可以在nvidia-smi中查看编号}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前CUDA设备：}" /><Run Text="{Binding Status.CudaDeviceId, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!--  Auto Append CUDA Path  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 自动添加CUDA路径}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.AutoAppendCudaPath, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 自动添加系统CUDA环境路径 默认关闭}" />
                    </Grid>
                    <!--  _additionalPath  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 附加PATH}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 附加path，用;分割。默认为空。可用于附加DLL路径}"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    MaxWidth="800"
                                    Text="{Binding Config.AdditionalPath, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  TensorRT配置  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Settings24}"
                             Visibility="Collapsed"
                             IsExpanded="False">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T TensorRT配置}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" Text="{i18n:T 修改后需要重启程序生效。}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <!--  Enable Cache  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 启用TensorRT缓存}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.EnableTensorRtCache, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 提升TensorRT模型加载速度 默认开启}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 缓存状态：}" /><Run Text="{Binding Status.EnableCache, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <!--  Embed Mode  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 嵌入式引擎缓存}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.EmbedTensorRtCache, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 将引擎缓存嵌入模型文件 默认开启}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 嵌入模式：}" /><Run Text="{Binding Status.TrtUseEmbedMode, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>


            <!--  OpenVino配置  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Settings24}"
                             IsExpanded="False">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      Grid.Column="0"
                                      FontTypography="Body"
                                      Text="{i18n:T OpenVino配置}"
                                      TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      TextWrapping="Wrap" Text="{i18n:T 修改后需要重启程序生效。}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <!--  OpenVinoDevice  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T OpenVino 设备参数}" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    MaxWidth="800"
                                    Text="{Binding OpenVinoDeviceText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    TextWrapping="Wrap" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.RowSpan="2"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 从“CPU”、“GPU”、“NPU”、“GPU.x”中选择，其中 x 为 0、1、2 等，或者从可用的 HETERO/MULTI/AUTO 选项中选择。默认为 AUTO:GPU／CPU}"
                                      TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前参数：}" /><Run Text="{Binding Status.OpenVinoDevice, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <!--  _enableOpenVinoCache  -->
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,16,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0"
                                      FontTypography="Body"
                                      Text="{i18n:T 是否启用 OpenVINO 缓存(实验性)，默认关闭。}" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         IsChecked="{Binding Config.EnableOpenVinoCache, Mode=TwoWay}" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                      Text="{i18n:T 启用后会在缓存文件夹下生成对应模型缓存，以加快模型载入速度。}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{i18n:T 当前状态：}" /><Run Text="{Binding Status.OpenVinoCache, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
