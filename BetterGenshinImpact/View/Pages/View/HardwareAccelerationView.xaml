<UserControl x:Class="BetterGenshinImpact.View.Pages.View.HardwareAccelerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TimingResultTemplate">
            <StackPanel Margin="0,14,0,0">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="平均耗时" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Average, StringFormat='{}{0:F1} ms'}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最快" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Minimum, StringFormat='{}{0:F1} ms'}" FontSize="16" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最慢" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Maximum, StringFormat='{}{0:F1} ms'}" FontSize="16" Margin="0,8,0,0" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding Execution}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Expander Header="查看 10 次结果" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SamplesText}" TextWrapping="Wrap" FontSize="12" />
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding RefreshCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="推理引擎设置">
            <ui:TitleBar.Icon><ui:ImageIcon Source="pack://application:,,,/Resources/Images/logo.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="24,12,24,0">
            <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="立即重启" Command="{Binding RestartCommand}" IsEnabled="{Binding CanInteract}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="已保存 · 等待重启" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="当前进程继续使用上方引擎。" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,12,24,24">
                <DockPanel Margin="0,12,0,4">
                    <ui:Button DockPanel.Dock="Right" Content="重新检测" Appearance="Transparent" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanInteract}" />
                    <TextBlock Text="选择推理引擎" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="点击卡片选择，再调整设备和设置。高亮边框与圆点表示你的选择，应用并重启后生效。" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ListBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" AutomationProperties.Name="推理引擎选择">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="300" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid>
                                                <Border x:Name="SelectionFill" Background="{DynamicResource SystemAccentColorPrimaryBrush}" CornerRadius="8" Opacity="0.07" Visibility="Collapsed" />
                                                <ContentPresenter Margin="16" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                <Setter TargetName="SelectionFill" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right" Width="20" Height="20" VerticalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                                        <Ellipse Fill="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="5" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                </DockPanel>
                                <WrapPanel Height="28" Margin="0,8,0,0">
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsRecommended, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="推荐" FontSize="11" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="正在使用" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Padding="6,2" Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="待重启" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MinHeight="40" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <DockPanel Margin="0,12,0,10">
                                    <ui:Button DockPanel.Dock="Right" Content="详情" Appearance="Transparent" Padding="6,2" FontSize="12" VerticalAlignment="Center"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Command="{Binding DataContext.ShowEngineDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True"><Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding HasFailure}" Value="True"><Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="执行设备" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding IsInstalled}" ToolTip="{Binding SelectedDevice.Name}" AutomationProperties.Name="执行设备" />
                                        <TextBlock Text="{Binding DeviceMessage}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxHeight="34" ToolTip="{Binding DeviceMessage}" />
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCpu, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="推理线程数" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ComboBox ItemsSource="{Binding DataContext.CpuThreadChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Count"
                                                      SelectedValue="{Binding DataContext.CpuThreads, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Margin="0,12,0,0" Content="模型缓存" IsChecked="{Binding Settings.EnableModelCache, Mode=TwoWay}" IsEnabled="{Binding IsInstalled}"
                                                         ToolTip="推荐开启，缩短后续模型加载时间。缓存位置由程序管理。" Visibility="{Binding SupportsCache, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                                <ui:Button Content="下载运行库" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                           Visibility="{Binding CanDownload, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding DataContext.DownloadRuntimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <ui:Button Content="补齐配套依赖" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                                           Visibility="{Binding CanCompleteDependencies, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Command="{Binding DataContext.CompleteDependenciesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,4,0,0">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ForceCpuOcr, Mode=TwoWay}" IsEnabled="{Binding CanInteract}" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="强制 OCR 使用 CPU" />
                        <StackPanel>
                            <TextBlock Text="强制 OCR 使用 CPU" FontWeight="SemiBold" />
                            <TextBlock Text="推荐开启。关闭后 OCR 跟随所选引擎，重启生效。" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding ValidationHint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border Margin="0,28,0,0" Padding="20" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Timer24" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="性能测试" FontSize="20" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="{Binding CurrentRuntimeText, StringFormat='测试引擎：{0}'}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="切换卡片不会改变测试引擎；待重启设置生效后，才能测试新引擎。" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding BenchmarkHint}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="OCR 文本识别" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentOcrText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Content="开始 OCR 测速" Command="{Binding BenchmarkOcrCommand}" IsEnabled="{Binding CanBenchmark}" HorizontalAlignment="Left" />
                                    <TextBlock Text="还没有测速结果" FontSize="12" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasOcrResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl Content="{Binding OcrResult}" ContentTemplate="{StaticResource TimingResultTemplate}" Visibility="{Binding HasOcrResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="古树检测" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TreeImageText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Content="开始古树测速" Command="{Binding BenchmarkTreeCommand}" IsEnabled="{Binding CanBenchmarkTree}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TreeBenchmarkEmptyText}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasTreeResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl Content="{Binding TreeResult}" ContentTemplate="{StaticResource TimingResultTemplate}" Visibility="{Binding HasTreeResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <ui:Button Content="运行库目录" Appearance="Transparent" Command="{Binding OpenRuntimeFolderCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="模型缓存目录" Appearance="Transparent" Command="{Binding OpenCacheFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Padding="24,14" Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button DockPanel.Dock="Right" Content="查看错误" Appearance="Transparent" Padding="8,2" Command="{Binding ShowErrorCommand}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="36" ToolTip="{Binding ProgressText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" Height="3" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button Content="恢复默认设置" Command="{Binding UseCpuCommand}" IsEnabled="{Binding CanInteract}" Margin="0,0,8,0"
                                   ToolTip="将推理引擎、强制 OCR 与推理线程数恢复为默认设置（CPU 推理）" />
                        <ui:Button Content="{Binding ApplyButtonText}" Appearance="Primary" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" MinWidth="128" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionText, StringFormat='已选择：{0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ApplyHint}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
