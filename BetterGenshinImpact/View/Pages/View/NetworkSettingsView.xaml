<UserControl x:Class="BetterGenshinImpact.View.Pages.View.NetworkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:network="clr-namespace:BetterGenshinImpact.Infrastructure.Network"
             xmlns:vm="clr-namespace:BetterGenshinImpact.ViewModel.Pages.View"
             d:DataContext="{d:DesignInstance Type=vm:NetworkSettingsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="NetworkBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>
        <!-- 代理模式 -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="代理模式" />
            <ui:TextBlock Grid.Row="1"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="{Binding ModeDescription, Mode=OneWay}"
                          TextWrapping="Wrap" />
            <ComboBox Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      Width="200"
                      Margin="0,0,36,0"
                      DisplayMemberPath="Value"
                      ItemsSource="{Binding ProxyModes, Mode=OneWay}"
                      SelectedValue="{Binding ProxyMode, Mode=TwoWay}"
                      SelectedValuePath="Key" />
        </Grid>

        <!-- 自定义代理：地址与绕过列表，只在自定义模式下显示 -->
        <StackPanel Visibility="{Binding IsCustomMode, Mode=OneWay, Converter={StaticResource NetworkBooleanToVisibilityConverter}}">
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="代理地址" />
                <ui:TextBlock Grid.Row="1"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="支持 http:// 和 socks5://，暂不支持需要用户名和密码的代理"
                              TextWrapping="Wrap" />
                <ui:TextBox Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="260"
                            Margin="0,0,36,0"
                            AutomationProperties.Name="代理地址"
                            PlaceholderText="http://127.0.0.1:7890"
                            Text="{Binding ProxyAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CommitProxyAddressCommand, Mode=OneWay}" />
                    </ui:TextBox.InputBindings>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="LostFocus">
                            <b:InvokeCommandAction Command="{Binding CommitProxyAddressCommand, Mode=OneWay}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ui:TextBox>
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,6,36,0"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding ProxyAddressError, Mode=OneWay}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="不使用代理的地址" />
                <ui:TextBlock Grid.Row="1"
                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                              Text="分号分隔，支持 * 通配，例如 *.mihoyo.com。国内服务可以加入这里以直连，本机地址始终直连"
                              TextWrapping="Wrap" />
                <ui:TextBox Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="260"
                            Margin="0,0,36,0"
                            AutomationProperties.Name="不使用代理的地址"
                            PlaceholderText="localhost;127.*;192.168.*"
                            Text="{Binding BypassListText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CommitBypassListCommand, Mode=OneWay}" />
                    </ui:TextBox.InputBindings>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="LostFocus">
                            <b:InvokeCommandAction Command="{Binding CommitBypassListCommand, Mode=OneWay}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ui:TextBox>
            </Grid>
        </StackPanel>

        <!-- 连接测试 -->
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="测试连接" />
            <ui:TextBlock Grid.Row="1"
                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                          Text="用当前设置访问 CNB、GitHub 和米游社"
                          TextWrapping="Wrap" />
            <ui:Button Grid.Row="0"
                       Grid.RowSpan="2"
                       Grid.Column="1"
                       Margin="0,0,36,0"
                       Command="{Binding TestConnectionCommand, Mode=OneWay}"
                       Content="测试连接"
                       Icon="{ui:SymbolIcon PlugConnected24}" />
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,36,0" Orientation="Horizontal">
                <ui:ProgressRing Width="14"
                                 Height="14"
                                 Margin="0,0,8,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsTesting, Mode=OneWay, Converter={StaticResource NetworkBooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding TestResults, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type network:NetworkTestResult}">
                            <TextBlock Margin="0,0,16,0" FontSize="12" Text="{Binding Text, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success, Mode=OneWay}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- 生效范围：写清哪些连接受影响，避免用户误以为网页或更新程序也会走代理 -->
        <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
        <ui:TextBlock Margin="16"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      Text="生效范围：软件内的网络请求、通知推送和 JS 脚本请求；自定义代理模式下也用于脚本仓库的 Git 拉取。网页窗口和云原神网页版跟随系统代理，更新程序不受影响。其他已打开的 BetterGI 实例需要重启后生效。"
                      TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
