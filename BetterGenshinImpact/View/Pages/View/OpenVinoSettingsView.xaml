<UserControl x:Class="BetterGenshinImpact.View.Pages.View.OpenVinoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>
        <!--  运行库与设备  -->
        <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="下载运行库" Command="{Binding DownloadRuntimeCommand}"
                               IsEnabled="{Binding CanDownload}" VerticalAlignment="Center" Margin="16,0,0,0"
                               ToolTip="从 NuGet 下载官方 OpenVINO 运行包（OpenVINO.runtime.win）并解压到 Plugins/OpenVINO。" />
                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RuntimeReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="运行库" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RuntimeText}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <Separator Margin="0,12,0,12" BorderThickness="0,1,0,0" />
                <TextBlock Text="推理设备" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding CanInteract}"
                          ToolTip="{Binding DeviceText}" AutomationProperties.Name="OpenVINO 推理设备" />
                <TextBlock Text="{Binding DeviceHint}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:ToggleSwitch Margin="0,12,0,0" Content="启用模型编译缓存" IsChecked="{Binding EnableModelCache, Mode=TwoWay}"
                                 IsEnabled="{Binding CanInteract}"
                                 ToolTip="编译后的模型缓存到本地，缩短后续加载时间；首次使用 GPU / NPU 建议开启。" />
            </StackPanel>
        </Border>

        <!--  NPU 静态形状策略（仅设备为 NPU 时显示）  -->
        <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,12,0,0"
                Visibility="{Binding IsNpuDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="NPU 静态形状策略" FontWeight="SemiBold" />
                <TextBlock Text="{Binding NpuStrategyHint, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <DockPanel Margin="0,12,0,0">
                    <ui:NumberBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                  Minimum="32" Maximum="1024" SmallChange="32" LargeChange="64"
                                  AcceptsExpression="False" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding NpuRecWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanInteract}" AutomationProperties.Name="NPU 识别固定宽度" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="识别固定宽度" FontWeight="SemiBold" />
                        <TextBlock Text="文本行缩放到模型高度后补零边到该宽度；长文本识别不全时调大（32 的倍数，默认 320）。"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <ComboBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding DetDevices}" SelectedItem="{Binding SelectedDetDevice}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding CanInteract}"
                              AutomationProperties.Name="检测运行设备" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="检测运行设备" FontWeight="SemiBold" />
                        <TextBlock Text="静态画布后检测模型默认留在 NPU；长截图担心小字召回时可改回 CPU（动态形状）。"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <ui:NumberBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                  Minimum="0" Maximum="2048" SmallChange="64" LargeChange="128"
                                  AcceptsExpression="False" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding DetStaticSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanInteract}" AutomationProperties.Name="检测静态画布边长" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="检测静态画布边长" FontWeight="SemiBold" />
                        <TextBlock Text="检测图长边等比缩放到该值、右下补零（框坐标自动映射回原图），消除编译卡顿；0=动态。截图偏大可调到 960。"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!--  GPU 静态宽度桶（仅设备为 GPU 时显示）  -->
        <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,12,0,0"
                Visibility="{Binding IsGpuDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="GPU 静态宽度桶" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GpuStrategyHint, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <DockPanel Margin="0,12,0,0">
                    <ui:TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                                PlaceholderText="320,640,960" ClearButtonEnabled="False"
                                Text="{Binding GpuRecWidthBuckets, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding CanInteract}" AutomationProperties.Name="GPU 识别宽度桶" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="识别宽度桶" FontWeight="SemiBold" />
                        <TextBlock Text="逗号分隔的宽度列表（32–1024），应用时自动去重排序；桶越多编译与显存占用越高，默认 320,640,960。"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <ui:NumberBox DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"
                                  Minimum="0" Maximum="2048" SmallChange="64" LargeChange="128"
                                  AcceptsExpression="False" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline"
                                  ValidationMode="InvalidInputOverwritten"
                                  Value="{Binding DetStaticSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanInteract}" AutomationProperties.Name="检测静态画布边长" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="检测静态画布边长" FontWeight="SemiBold" />
                        <TextBlock Text="检测图长边等比缩放到该值、右下补零（框坐标自动映射回原图），消除 GPU 逐尺寸编译卡顿；0=动态。截图偏大可调到 960。"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!--  用途开关  -->
        <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="用途" FontWeight="SemiBold" />
                <TextBlock Text="OpenVINO 直接推理现有 ONNX 模型文件，无需转换产物；全局后端选择只决定开关的默认值，此处可单独覆盖。"
                           TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <DockPanel Margin="0,12,0,0">
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseOpenVinoOcr, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"
                                     VerticalAlignment="Center" AutomationProperties.Name="OCR 使用 OpenVINO" />
                    <StackPanel>
                        <TextBlock Text="OCR 使用 OpenVINO" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OcrOverrideHint}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseOpenVinoYolo, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"
                                     VerticalAlignment="Center" AutomationProperties.Name="YOLO 使用 OpenVINO" />
                    <StackPanel>
                        <TextBlock Text="YOLO 使用 OpenVINO" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding YoloOverrideHint}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
