<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceSettings.QuestVoiceStoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages.QuestVoiceSettings"
             xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
             Loaded="OnLoaded"
             HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="QuestStoryBoolVisibility" />
        <!-- 不替换 BetterGI 的按钮、输入、选择器主题，只统一面板边界。 -->
        <Style x:Key="QuestStorySection" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="QuestStoryEllipsis" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <TabControl BorderThickness="0" Margin="0,4,0,0">
        <!-- 全局剧情仅在这里选择；右栏配置当前出场角色。台词节点浏览独立于此页。 -->
        <TabItem Header="1. 剧情选择与声线">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="260" />
                    <ColumnDefinition Width="1.05*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource QuestStorySection}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" Text="选择剧情" FontWeight="SemiBold" FontSize="15"
                                      Margin="0,0,0,10" />
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox PlaceholderText="搜索剧情系列或章节"
                                        Text="{Binding ChapterSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsEditable, Mode=OneWay}" />
                            <ui:Button Grid.Column="1" Content="刷新" Margin="8,0,0,0"
                                       Command="{Binding RefreshCatalogCommand, Mode=OneWay}"
                                       IsEnabled="{Binding IsEditable, Mode=OneWay}" />
                        </Grid>
                        <ListBox Grid.Row="2" ItemsSource="{Binding CatalogRows, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedCatalogRow, Mode=TwoWay}"
                                 IsEnabled="{Binding IsEditable, Mode=OneWay}"
                                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="Padding" Value="5,7" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,2">
                                        <ui:TextBlock DockPanel.Dock="Left" Text="{Binding DisplayKind, Mode=OneWay}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,12,0" />
                                        <ui:TextBlock Text="{Binding Title, Mode=OneWay}"
                                                      FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding Title, Mode=OneWay}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 成功加载后完全收起提示；仅真实错误时提供重试入口。 -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0"
                                    Visibility="{Binding HasChapterError, Converter={StaticResource QuestStoryBoolVisibility}}">
                            <ui:TextBlock Text="{Binding ChapterStatus, Mode=OneWay}" TextWrapping="Wrap"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="重试读取" HorizontalAlignment="Left" Margin="0,6,0,0"
                                       Command="{Binding ReloadSelectedSelectionCommand, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <StackPanel IsEnabled="{Binding IsEditable, Mode=OneWay}">
                            <ui:TextBlock Text="配音设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <WrapPanel>
                                <StackPanel Width="145" Margin="0,0,10,0">
                                    <ui:TextBlock Text="目标语言" Margin="0,0,0,5" />
                                    <ComboBox SelectedValuePath="Tag"
                                              SelectedValue="{Binding Config.SpeechLanguage, Mode=TwoWay}">
                                        <ComboBoxItem Tag="jpn" Content="日语（JP）" />
                                        <ComboBoxItem Tag="chs" Content="中文（CHS）" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="155" Margin="0,0,10,0">
                                    <ui:TextBlock Text="旅行者昵称" Margin="0,0,0,5" />
                                    <ui:TextBox Text="{Binding Config.TravelerNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="未指定" />
                                </StackPanel>
                                <StackPanel Width="105">
                                    <ui:TextBlock Text="旅行者" Margin="0,0,0,5" />
                                    <ComboBox SelectedIndex="{Binding TravelerChoiceIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="空" />
                                        <ComboBoxItem Content="荧" />
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource QuestStorySection}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock VerticalAlignment="Center" Text="{Binding Management.StoryRoleCountLabel, Mode=OneWay}"
                                              FontSize="15" FontWeight="SemiBold" />
                                <ComboBox Grid.Column="1" Width="110"
                                          SelectedIndex="{Binding Management.StoryRoleFilter, Mode=TwoWay}">
                                    <ComboBoxItem Content="全部角色" />
                                    <ComboBoxItem Content="未绑定" />
                                    <ComboBoxItem Content="已绑定" />
                                </ComboBox>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Management.DisplayedStorySpeakers, Mode=OneWay}"
                                     Visibility="{Binding HasLoadedStoryRoles, Converter={StaticResource QuestStoryBoolVisibility}}"
                                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Padding" Value="5,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}"
                                                          TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                          ToolTip="{Binding DisplayName, Mode=OneWay}" />
                                            <pages:QuestVoiceVoiceSelector Grid.Column="1"
                                                ItemsSource="{Binding DataContext.Management.VoiceChoices, RelativeSource={RelativeSource AncestorType={x:Type local:QuestVoiceStoryPanel}}, Mode=OneWay}"
                                                SelectedVoiceId="{Binding VoiceId, Mode=TwoWay}"
                                                IsEnabled="{Binding DataContext.Management.CanEditDraft, RelativeSource={RelativeSource AncestorType={x:Type local:QuestVoiceStoryPanel}}, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 只在网络/缓存读取期间出现，使用 BetterGI 自带的无限旋转 ProgressRing。 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsStoryLoading, Converter={StaticResource QuestStoryBoolVisibility}}"
                                        MaxWidth="340" Margin="16" >
                                <ui:ProgressRing Width="38" Height="38" IsIndeterminate="True"
                                                 HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <ui:TextBlock Text="{Binding StoryLoadingText, Mode=OneWay}"
                                              TextWrapping="Wrap" TextAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- 读取失败时给出明确的网络提示和同一选区重试入口。 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasStoryLoadError, Converter={StaticResource QuestStoryBoolVisibility}}"
                                        MaxWidth="360" Margin="16">
                                <ui:TextBlock Text="无法加载剧情角色" FontSize="15" FontWeight="SemiBold"
                                              TextAlignment="Center" Margin="0,0,0,10" />
                                <ui:TextBlock Text="{Binding StoryLoadFailure, Mode=OneWay}"
                                              TextWrapping="Wrap" TextAlignment="Center"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,0,12" />
                                <ui:Button Content="重试加载" HorizontalAlignment="Center"
                                           Command="{Binding ReloadSelectedSelectionCommand, Mode=OneWay}" />
                            </StackPanel>
                            <ui:TextBlock Grid.Row="1" Text="请选择左侧的剧情系列或章节"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Visibility="{Binding IsStoryAwaitingSelection, Converter={StaticResource QuestStoryBoolVisibility}}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource QuestStorySection}">
                        <StackPanel>
                            <WrapPanel>
                                <ui:Button Content="预合成所选剧情" Appearance="Primary" Margin="0,0,8,0"
                                           Command="{Binding StartPreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding CanGenerateSelectedStory, Mode=OneWay}" />
                                <ui:Button Content="暂停" Margin="0,0,6,0"
                                           Command="{Binding PausePreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                                <ui:Button Content="继续" Margin="0,0,6,0"
                                           Command="{Binding ResumePreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                                <ui:Button Content="停止" Command="{Binding StopPreSynthesisCommand, Mode=OneWay}"
                                           IsEnabled="{Binding IsGenerating, Mode=OneWay}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding HasPreSynthesisActivity, Converter={StaticResource QuestStoryBoolVisibility}}"
                                        Margin="0,8,0,0">
                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                                <ui:TextBlock Text="{Binding PreSynthesisStatus, Mode=OneWay}" Margin="0,5,0,0"
                                              TextTrimming="CharacterEllipsis" ToolTip="{Binding PreSynthesisStatus, Mode=OneWay}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
        <!-- 全文浏览：章节、主任务、子任务、对白、选项一条连续的阅读流，不需要多次展开。 -->
        <TabItem Header="2. 剧情文稿与台词">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" MinWidth="320" />
                    <ColumnDefinition Width="1*" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <!-- 左侧连续剧情稿，章与任务以字体和留白区分。 -->
                <Border Grid.Column="0" Style="{StaticResource QuestStorySection}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" Text="{Binding ActiveSelectionLabel, Mode=OneWay}"
                                      FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                                      TextTrimming="CharacterEllipsis" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding TranscriptRows, Mode=OneWay}"
                             SelectedItem="{Binding SelectedTranscriptRow, Mode=TwoWay}"
                             Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0,12,0">
                                    <!-- Title hierarchy uses typography and space, not colored boxes. -->
                                    <Border x:Name="ChapterBlock" Visibility="Collapsed"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Margin="0,18,0,13" Padding="0,0,0,11">
                                        <StackPanel>
                                            <ui:TextBlock Text="章 节" FontSize="11"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Margin="0,0,0,5" />
                                            <ui:TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="20"
                                                          FontWeight="Bold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="StoryBlock" Visibility="Collapsed"
                                                Margin="0,20,0,10">
                                        <ui:TextBlock Text="主任务" FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,0,4" />
                                        <ui:TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="17"
                                                      FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="TaskBlock" Visibility="Collapsed"
                                                Margin="12,14,0,8">
                                        <ui:TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="14"
                                                      FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Height="1" Margin="0,7,0,0"
                                                Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    </StackPanel>
                                    <StackPanel x:Name="DialogueBlock" Visibility="Collapsed"
                                                Margin="24,5,10,8">
                                        <ui:TextBlock Text="{Binding Speaker, Mode=OneWay}"
                                                      FontWeight="SemiBold" FontSize="12"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,0,3" />
                                        <ui:TextBlock Text="{Binding Text, Mode=OneWay}"
                                                      FontSize="14" TextWrapping="Wrap"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="ChoiceBlock" Visibility="Collapsed"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="2,0,0,0" Padding="11,6,0,6"
                                            Margin="34,4,12,8">
                                        <StackPanel>
                                            <ui:TextBlock Text="对话选项" FontSize="11"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          Margin="0,0,0,4" />
                                            <ui:TextBlock Text="{Binding Text, Mode=OneWay}"
                                                          TextWrapping="Wrap" FontSize="14" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="HintBlock" Visibility="Collapsed"
                                                Margin="34,7,12,9">
                                        <ui:TextBlock Text="剧情提示" FontSize="11"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Margin="0,0,0,4" />
                                        <ui:TextBlock Text="{Binding Text, Mode=OneWay}"
                                                      TextWrapping="Wrap" FontStyle="Italic"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="chapter">
                                        <Setter TargetName="ChapterBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="story">
                                        <Setter TargetName="StoryBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="task">
                                        <Setter TargetName="TaskBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="dialogue">
                                        <Setter TargetName="DialogueBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="choice">
                                        <Setter TargetName="ChoiceBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="hint">
                                        <Setter TargetName="HintBlock" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Border>
                <!-- 右侧只保留中日原文与 WAV 试听，没有前置/后续关系和重复状态栏。 -->
                <Border Grid.Column="1" Style="{StaticResource QuestStorySection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" Text="中文原文" FontWeight="SemiBold" FontSize="14"
                                          Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ui:TextBlock Text="{Binding SelectedLine.Chinese, Mode=OneWay}"
                                              FontSize="14" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" Text="日语原文" FontWeight="SemiBold" FontSize="14"
                                          Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ui:TextBlock Text="{Binding SelectedLine.Japanese, Mode=OneWay}"
                                              FontSize="14" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <ui:TextBlock Text="{Binding SelectedLine.State, Mode=OneWay}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Margin="0,0,0,8" />
                            <WrapPanel>
                                <ui:Button Content="播放已生成 WAV" Margin="0,0,8,4"
                                           Command="{Binding PlayCachedWAVCommand, Mode=OneWay}" />
                                <ui:Button Content="停止试听"
                                           Command="{Binding StopCachedWAVCommand, Mode=OneWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
