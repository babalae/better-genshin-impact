<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceSettings.GptSovitsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             HorizontalContentAlignment="Stretch"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="GptBoolVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <ui:TextBlock Text="GPT-SoVITS" FontSize="18" FontWeight="SemiBold" />
        <ui:TextBlock Text="连接自行启动的 api_v2 服务；声线由 GPT 权重、SoVITS 权重和参考音频组成。"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,12" />

        <!-- 服务 -->
        <ui:TextBlock Text="服务" FontWeight="SemiBold" Margin="0,4,0,8" />
        <ui:ToggleSwitch Content="使用远程实例（本地与远程地址分别保留）" IsChecked="{Binding Config.UseRemoteService, Mode=TwoWay}" Margin="0,0,0,8" />
        <ui:TextBlock Text="服务地址" Margin="0,0,0,6" />
        <ui:TextBox Text="{Binding ServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ui:TextBlock Text="{Binding UrlValidationMessage, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <ui:TextBlock Text="远程实例的权重和参考音频必须已经在服务器上，填写服务器路径；不会上传本机文件。"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
        <WrapPanel>
            <ui:Button Content="测试连接" Command="{Binding ProbeCommand, Mode=OneWay}" Margin="0,0,12,0" />
            <ui:TextBlock Text="{Binding ConnectionStatus, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </WrapPanel>
        <ui:ToggleSwitch Content="按句流式合成与增量播放（实验性，关闭时完整合成）" IsChecked="{Binding Config.StreamingEnabled, Mode=TwoWay}" Margin="0,12,0,0" />
        <ui:TextBlock Text="需要后端支持当前 api_v2 的按句流式协议；试听始终完整接收后播放。"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <ui:TextBlock Text="角色声线现集中在「3. 角色映射 → 声线注册」管理；这里仅配置 GPT-SoVITS 服务。"
                      Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>