<Page x:Class="BetterGenshinImpact.View.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:plugins="clr-namespace:BetterGenshinImpact.ViewModel.Pages.Plugins"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="PluginsPage"
      d:DataContext="{d:DesignInstance Type=plugins:PluginsPageViewModel}"
      d:DesignHeight="900"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <!--  设置项标题  -->
        <!--  WPF-UI 没有为 ui:TextBlock 提供按类型索引的默认样式，这里不使用 BasedOn  -->
        <Style x:Key="PluginItemTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  设置项说明  -->
        <Style x:Key="PluginItemDescription" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  醒目提示：回退、不兼容、加载失败  -->
        <Style x:Key="PluginItemWarning" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  功能选择下拉框  -->
        <Style x:Key="PluggableComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}"
               TargetType="ComboBox">
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="Margin" Value="0,0,36,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DisplayMemberPath" Value="Text" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="{StaticResource PagePadding}">
        <!--  标题与操作  -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Text="{i18n:T 插件}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0"
                           Appearance="Primary"
                           Command="{Binding InstallFromFileCommand}"
                           Content="{i18n:T 从文件安装}"
                           Icon="{ui:SymbolIcon Add24}"
                           IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                           Visibility="{Binding CanManagePackages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Margin="0,0,8,0"
                           Command="{Binding OpenPluginsDirectoryCommand}"
                           Content="{i18n:T 打开插件目录}"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:Button Command="{Binding RefreshCommand}"
                           Content="{i18n:T 刷新}"
                           Icon="{ui:SymbolIcon ArrowSync24}" />
            </StackPanel>
        </Grid>
        <ui:TextBlock Margin="0,0,0,12"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      Text="{i18n:T 插件可以替换 BetterGI 的部分功能，例如 OCR 模型。启用、停用和切换都不需要重启。}"
                      TextWrapping="Wrap" />

        <!--  权限提示  -->
        <Border Margin="0,0,0,16"
                Padding="16,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <ui:TextBlock Text="{i18n:T 插件拥有与 BetterGI 相同的系统权限（管理员），请只安装可信来源的插件。}" TextWrapping="Wrap" />
        </Border>

        <!--  功能选择：每项可插拔能力一行，新增可插拔能力时自动出现  -->
        <ui:TextBlock Margin="0,0,0,8"
                      FontTypography="BodyStrong"
                      Text="{i18n:T 功能选择}" />
        <ItemsControl Margin="0,0,0,16" ItemsSource="{Binding Pluggables, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type plugins:PluggableItemViewModel}">
                    <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Options24}">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Style="{StaticResource PluginItemTitle}" Text="{Binding DisplayName, Mode=OneWay}" />
                                    <ui:TextBlock Style="{StaticResource PluginItemDescription}" Text="{Binding Description, Mode=OneWay}" />
                                    <ui:TextBlock Margin="0,4,0,0"
                                                  Style="{StaticResource PluginItemWarning}"
                                                  Text="{Binding FallbackText, Mode=OneWay}"
                                                  Visibility="{Binding HasFallback, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Options, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                          Style="{StaticResource PluggableComboBox}" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  已安装插件  -->
        <ui:TextBlock Margin="0,0,0,8"
                      FontTypography="BodyStrong"
                      Text="{i18n:T 已安装插件}" />
        <ui:TextBlock Margin="0,0,0,8"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      Text="{i18n:T 尚未安装插件。可以从文件安装，或把插件文件夹放到插件目录后点击刷新。}"
                      TextWrapping="Wrap"
                      Visibility="{Binding HasNoPlugins, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ItemsControl ItemsSource="{Binding Plugins, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type plugins:InstalledPluginItemViewModel}">
                    <ui:CardExpander Margin="0,0,0,8"
                                     ContentPadding="0"
                                     Icon="{ui:SymbolIcon PuzzlePiece24}">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Row="0"
                                              Style="{StaticResource PluginItemTitle}"
                                              Text="{Binding Name, Mode=OneWay}" />
                                <ui:TextBlock Grid.Row="1"
                                              Style="{StaticResource PluginItemDescription}"
                                              Text="{Binding VersionText, Mode=OneWay}" />
                                <ui:TextBlock Grid.Row="2"
                                              Style="{StaticResource PluginItemDescription}"
                                              Text="{Binding StatusText, Mode=OneWay}"
                                              Visibility="{Binding IsProblem, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:TextBlock Grid.Row="2"
                                              Style="{StaticResource PluginItemWarning}"
                                              Text="{Binding StatusText, Mode=OneWay}"
                                              Visibility="{Binding IsProblem, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <!--  插件声明了设置界面时显示，点击后在弹窗中打开  -->
                                <ui:Button Grid.Row="0"
                                           Grid.RowSpan="3"
                                           Grid.Column="1"
                                           Margin="12,0,16,0"
                                           VerticalAlignment="Center"
                                           Command="{Binding OpenSettingsCommand}"
                                           Content="{i18n:T 设置}"
                                           Icon="{ui:SymbolIcon Settings24}"
                                           Visibility="{Binding HasSettings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:ToggleSwitch Grid.Row="0"
                                                 Grid.RowSpan="3"
                                                 Grid.Column="2"
                                                 Margin="0,0,24,0"
                                                 IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                 IsEnabled="{Binding CanToggle, Mode=OneWay}" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel Margin="16">
                            <ui:TextBlock Style="{StaticResource PluginItemTitle}" Text="{Binding Description, Mode=OneWay}" />
                            <ui:TextBlock Margin="0,8,0,0" Style="{StaticResource PluginItemDescription}">
                                <Run Text="{i18n:T 提供的功能：}" />
                                <Run Text="{Binding ImplementationsText, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Margin="0,4,0,0" Style="{StaticResource PluginItemDescription}">
                                <Run Text="{i18n:T 标识：}" />
                                <Run Text="{Binding Id, Mode=OneWay}" />
                            </ui:TextBlock>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Command="{Binding OpenDirectoryCommand}"
                                           Content="{i18n:T 打开目录}"
                                           Icon="{ui:SymbolIcon FolderOpen24}" />
                                <ui:Button Margin="0,0,8,0"
                                           Command="{Binding OpenHomepageCommand}"
                                           Content="{i18n:T 主页}"
                                           Icon="{ui:SymbolIcon Globe24}"
                                           Visibility="{Binding HasHomepage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:Button Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                           CommandParameter="{Binding}"
                                           Content="{i18n:T 卸载}"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           IsEnabled="{Binding CanUninstall, Mode=OneWay}"
                                           Visibility="{Binding DataContext.CanManagePackages, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
