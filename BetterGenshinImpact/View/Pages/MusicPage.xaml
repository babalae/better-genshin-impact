<UserControl x:Class="BetterGenshinImpact.View.Pages.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DesignHeight="800"
             d:DesignWidth="1180"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MusicCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="SectionIconStyle" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="MusicListItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="48,20,48,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="390" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="5*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource MusicCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,16,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="我的曲库" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="双击播放 · 拖拽调整顺序" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="8,0,7,0"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.ChooseFolderCommand}"
                                   Content="选择目录"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button Grid.Column="2"
                                   Width="40"
                                   Height="36"
                                   Command="{Binding ViewModel.RefreshCommand}"
                                   IsEnabled="{Binding ViewModel.IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"
                                   ToolTip="重新扫描曲谱目录">
                            <Grid Width="18" Height="18">
                                <ui:SymbolIcon Symbol="ArrowClockwise24"
                                               Visibility="{Binding ViewModel.IsRefreshing, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                <ui:ProgressRing Width="18"
                                                 Height="18"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding ViewModel.IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14,2,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Margin="0,0,8,0"
                                    PlaceholderText="搜索曲名、作者或路径"
                                    Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding ViewModel.FormatFilters}"
                                  SelectedItem="{Binding ViewModel.SelectedFormatFilter}"
                                  ToolTip="按格式筛选" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding ViewModel.InstrumentFilters}"
                                  SelectedItem="{Binding ViewModel.SelectedInstrumentFilter}"
                                  ToolTip="按乐器筛选" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="8,0">
                        <ListView Background="Transparent"
                                  BorderThickness="0"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.UseDefaultDragAdorner="True"
                                  ItemContainerStyle="{StaticResource MusicListItemStyle}"
                                  ItemsSource="{Binding ViewModel.MusicItemsView}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectedItem="{Binding ViewModel.SelectedMusicItem}">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseDoubleClick">
                                    <b:InvokeCommandAction Command="{Binding ViewModel.PlayPauseCommand}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="TrackCard"
                                            Margin="3,2"
                                            Padding="12,10"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            ToolTip="{Binding Error}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="TrackIconBackground"
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="9">
                                                <ui:SymbolIcon x:Name="TrackIcon"
                                                               Symbol="MusicNote224" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="7,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Author, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding FormatName, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding Instrument, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        MinWidth="76"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DurationText}" />
                                                <TextBlock x:Name="TrackStatusText"
                                                           Margin="0,4,0,0"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="{Binding PlayableRatioText, StringFormat=可演奏 {0}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}"
                                                     Value="True">
                                            <Setter TargetName="TrackCard"
                                                    Property="Background"
                                                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}"
                                                     Value="True">
                                            <Setter TargetName="TrackCard"
                                                    Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter TargetName="TrackCard"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter TargetName="TrackStatusText"
                                                    Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter TargetName="TrackStatusText"
                                                    Property="Text"
                                                    Value="解析失败" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Padding="30"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                IsHitTestVisible="False"
                                Visibility="{Binding ViewModel.HasMusicItems, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="20">
                                    <Grid>
                                        <ui:SymbolIcon FontSize="30"
                                                       Symbol="MusicNote224"
                                                       Visibility="{Binding ViewModel.IsRefreshing, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                                        <ui:ProgressRing Width="30"
                                                         Height="30"
                                                         IsIndeterminate="True"
                                                         Visibility="{Binding ViewModel.IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="曲库还是空的" />
                                <TextBlock MaxWidth="300"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ViewModel.LibraryStatusText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="18,9,18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ViewModel.MusicItems.Count, Mode=OneWay, StringFormat={}{0} 首曲目}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0"
                                           Symbol="ReOrder24" />
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="播放顺序自动保存" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionIconStyle}">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="曲谱目录" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding ViewModel.MusicFolderDisplayText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ViewModel.MusicFolderDisplayText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <ui:Button Margin="0,0,6,0"
                                           Appearance="Secondary"
                                           Command="{Binding ViewModel.OpenFolderCommand}"
                                           Content="打开" />
                                <ui:Button Width="36"
                                           Command="{Binding ViewModel.ChooseFolderCommand}"
                                           Icon="{ui:SymbolIcon Options24}"
                                           ToolTip="更改目录" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Style="{StaticResource MusicCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionIconStyle}">
                                    <ui:SymbolIcon Symbol="List24" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding ViewModel.SelectedMusicItem.DisplayTitle, TargetNullValue=未选择曲目}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding ViewModel.SelectedMusicItem.Author, Mode=OneWay, TargetNullValue=选择左侧曲目查看详情}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding ViewModel.SelectedMusicItem.DurationText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="速度" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding ViewModel.SelectedMusicItem.Bpm, StringFormat={}{0:0} BPM, TargetNullValue=--}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="节拍" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding ViewModel.SelectedMusicItem.TimeSignature, TargetNullValue=--}" />
                                </StackPanel>
                                <Border Grid.Column="3"
                                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="可演奏" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Text="{Binding ViewModel.SelectedMusicItem.PlayableRatioText, TargetNullValue=--}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Style="{StaticResource MusicCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionIconStyle}">
                                    <ui:SymbolIcon Symbol="MusicNote224" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="输出设置" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="请在游戏中手动装备对应乐器" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="1,0,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="乐器档案" />
                                    <ComboBox DisplayMemberPath="Name"
                                              ItemsSource="{Binding ViewModel.Profiles}"
                                              SelectedItem="{Binding ViewModel.SelectedInstrumentProfile}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="1,0,0,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="半音移调" />
                                    <ui:NumberBox Maximum="24"
                                                  Minimum="-24"
                                                  SmallChange="1"
                                                  SpinButtonPlacementMode="Inline"
                                                  ValidationMode="InvalidInputOverwritten"
                                                  Value="{Binding ViewModel.Transpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10"
                            Style="{StaticResource MusicCardStyle}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,9,0"
                                                   Symbol="Options24" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="MIDI 轨道" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="单独启用轨道，并查看音域与映射命中率。" />
                                <ItemsControl ItemsSource="{Binding ViewModel.SelectedMusicItem.Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2"
                                                    Padding="10,8"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox VerticalAlignment="Center"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                                        <b:Interaction.Triggers>
                                                            <b:EventTrigger EventName="Click">
                                                                <b:InvokeCommandAction Command="{Binding DataContext.ViewModel.UpdateTrackSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            </b:EventTrigger>
                                                        </b:Interaction.Triggers>
                                                    </CheckBox>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding MinNoteNumber, Mode=OneWay}" />
                                                        <Run Text="–" />
                                                        <Run Text="{Binding MaxNoteNumber, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding PlayableRatioText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource MusicCardStyle}">
                        <Expander>
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,9,0"
                                                   Symbol="Settings24" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="音高映射" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="映射模式" />
                                    <ComboBox Grid.Column="1"
                                              Margin="12,0,0,0"
                                              ItemsSource="{Binding ViewModel.MappingModes}"
                                              SelectedItem="{Binding ViewModel.SelectedInstrumentProfile.MappingMode}" />
                                </Grid>
                                <ItemsControl Margin="0,10,0,0"
                                              ItemsSource="{Binding ViewModel.SelectedInstrumentProfile.Mappings}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Key}" />
                                                <ui:NumberBox Grid.Column="1"
                                                              Maximum="127"
                                                              Minimum="0"
                                                              SmallChange="1"
                                                              SpinButtonPlacementMode="Compact"
                                                              ValidationMode="InvalidInputOverwritten"
                                                              Value="{Binding MidiNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Margin="0,10,0,0"
                                           HorizontalAlignment="Right"
                                           Appearance="Primary"
                                           Command="{Binding ViewModel.SaveProfilesCommand}"
                                           Content="保存映射"
                                           Icon="{ui:SymbolIcon Save24}" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                MinHeight="132"
                Margin="0"
                Padding="0"
                BorderThickness="0,1,0,0"
                CornerRadius="0"
                Style="{StaticResource MusicCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Slider Height="20"
                        Margin="0,-10,0,0"
                        Panel.ZIndex="2"
                        VerticalAlignment="Top"
                        Maximum="{Binding ViewModel.TotalDurationMilliseconds}"
                        Minimum="0"
                        Value="{Binding ViewModel.CurrentPositionMilliseconds, Mode=OneWay}">
                    <b:Interaction.Behaviors>
                        <behavior:SliderSeekBehavior Command="{Binding ViewModel.SeekCommand}" />
                    </b:Interaction.Behaviors>
                </Slider>

                <Grid Margin="66,7,66,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ViewModel.CurrentTimeText}" />
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ViewModel.TotalTimeText}" />
                </Grid>

                <Grid Grid.Row="1" Margin="66,7,66,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel MinWidth="180"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="46"
                                Height="46"
                                Margin="0,0,11,0"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                CornerRadius="12">
                            <ui:SymbolIcon FontSize="23"
                                           Symbol="MusicNote224" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock MaxWidth="260"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding ViewModel.CurrentTrackName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding ViewModel.SelectedMusicItem.FormatName, Mode=OneWay, TargetNullValue=等待播放}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ViewModel.SelectedMusicItem.Instrument, Mode=OneWay, TargetNullValue=--}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:Button Width="44"
                                   Height="44"
                                   Margin="3,0"
                                   Appearance="Secondary"
                                   Command="{Binding ViewModel.PreviousCommand}"
                                   Icon="{ui:SymbolIcon Previous24}"
                                   ToolTip="上一首" />
                        <ui:Button Width="52"
                                   Height="52"
                                   Margin="4,0"
                                   Appearance="Primary"
                                   Command="{Binding ViewModel.PlayPauseCommand}"
                                   ToolTip="播放/暂停">
                            <ui:SymbolIcon FontSize="22"
                                           Symbol="{Binding ViewModel.PlayPauseSymbol}" />
                        </ui:Button>
                        <ui:Button Width="44"
                                   Height="44"
                                   Margin="3,0"
                                   Appearance="Secondary"
                                   Command="{Binding ViewModel.NextCommand}"
                                   Icon="{ui:SymbolIcon Next24}"
                                   ToolTip="下一首" />
                        <ui:Button Width="44"
                                   Height="44"
                                   Margin="3,0"
                                   Appearance="Transparent"
                                   Command="{Binding ViewModel.StopCommand}"
                                   Icon="{ui:SymbolIcon Stop24}"
                                   ToolTip="停止" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="倍速" />
                        <ui:NumberBox Width="86"
                                      MaxDecimalPlaces="2"
                                      Maximum="2"
                                      Minimum="0.5"
                                      SmallChange="0.1"
                                      SpinButtonPlacementMode="Inline"
                                      ValidationMode="InvalidInputOverwritten"
                                      Value="{Binding ViewModel.Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="66,9,66,14"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="播放模式" />
                    <ComboBox Width="126"
                              ItemsSource="{Binding ViewModel.PlaybackModeOptions}"
                              SelectedItem="{Binding ViewModel.SelectedPlaybackModeText}" />
                    <TextBlock Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="输入方式" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding ViewModel.InputModeOptions}"
                              SelectedItem="{Binding ViewModel.SelectedInputModeText}"
                              ToolTip="后台模式会继续向已关联的游戏窗口发键；前台模式要求游戏保持前台。" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
