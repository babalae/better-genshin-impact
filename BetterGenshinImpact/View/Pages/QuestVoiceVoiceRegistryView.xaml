<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceVoiceRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VoiceRegistryBoolVisibility" />
        <Style x:Key="RegistryCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource RegistryCard}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.Row="0" Text="声线库" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ui:TextBlock Grid.Row="1" Text="先注册独立声线，再在「角色映射」中分配。名称与角色引用互相独立。"
                              TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Profiles, Mode=OneWay}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="Name"
                         Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <WrapPanel Grid.Row="3" Margin="0,9,0,0">
                    <ui:Button Content="新建 GPT 声线" Margin="0,0,8,6"
                               Command="{Binding AddGptProfileCommand, Mode=OneWay}" />
                    <ui:Button Content="删除选中声线" Margin="0,0,8,6"
                               Command="{Binding DeleteProfileCommand, Mode=OneWay}" />
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource RegistryCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <ui:TextBlock Text="{Binding SelectedProfile.Name, Mode=OneWay}"
                                  TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold"
                                  ToolTip="{Binding SelectedProfile.Name, Mode=OneWay}" />
                    <ui:TextBlock Text="{Binding SelectedProfileDiagnostic, Mode=OneWay}" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0" IsEnabled="{Binding CanEditDraft, Mode=OneWay}">
                        <ui:TextBlock Text="声线名称" Margin="0,0,0,5" />
                        <ui:TextBox Text="{Binding SelectedProfile.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,10" />
                        <ui:TextBlock Text="配音引擎" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Providers, Mode=OneWay}"
                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedProfile.ProviderId, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <ui:TextBlock Text="服务实例" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding InstanceChoices, Mode=OneWay}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                  SelectedValue="{Binding SelectedProfile.InstanceId, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <StackPanel Visibility="{Binding SelectedProfile.UsesGptAssets, Mode=OneWay, Converter={StaticResource VoiceRegistryBoolVisibility}}">
                            <ui:TextBlock Text="GPT 权重（.ckpt）" Margin="0,0,0,5" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding SelectedProfile.GptWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding SelectedProfile.GptWeightsPath, Mode=OneWay}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                           Command="{Binding BrowseProfileAssetCommand, Mode=OneWay}" CommandParameter="gpt" />
                            </Grid>
                            <ui:TextBlock Text="SoVITS 权重（.pth）" Margin="0,0,0,5" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding SelectedProfile.SovitsWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding SelectedProfile.SovitsWeightsPath, Mode=OneWay}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                           Command="{Binding BrowseProfileAssetCommand, Mode=OneWay}" CommandParameter="sovits" />
                            </Grid>
                            <ui:TextBlock Text="参考音频" Margin="0,0,0,5" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding SelectedProfile.ReferenceAudioPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding SelectedProfile.ReferenceAudioPath, Mode=OneWay}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="浏览"
                                           Command="{Binding BrowseProfileAssetCommand, Mode=OneWay}" CommandParameter="audio" />
                            </Grid>
                            <ui:TextBlock Text="参考台词（与参考音频一致）" Margin="0,0,0,5" />
                            <ui:TextBox Text="{Binding SelectedProfile.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,10" />
                        </StackPanel>
                        <StackPanel>
                            <ui:TextBlock Text="服务预设音色 ID（无 GPT 权重的引擎使用）" Margin="0,0,0,5" />
                            <ui:TextBox Text="{Binding SelectedProfile.ProviderVoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,10" />
                        </StackPanel>
                        <ui:TextBlock Text="试听台词" FontWeight="SemiBold" Margin="0,6,0,6" />
                        <ui:TextBox Text="{Binding PreviewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" />
                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button Content="试听声线" Margin="0,0,8,0"
                                       Command="{Binding PreviewProfileCommand, Mode=OneWay}" />
                            <ui:Button Content="停止试听" Command="{Binding CancelPreviewCommand, Mode=OneWay}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>