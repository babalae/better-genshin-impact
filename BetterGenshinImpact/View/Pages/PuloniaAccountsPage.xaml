<UserControl x:Class="BetterGenshinImpact.View.Pages.PuloniaAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:BetterGenshinImpact.View.Converters"
             xmlns:models="clr-namespace:BetterGenshinImpact.Pulonia.Models"
             xmlns:pages="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:pulonia="clr-namespace:BetterGenshinImpact.ViewModel.Pages.Pulonia"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=pages:PuloniaAccountsPage}"
             d:DesignHeight="720"
             d:DesignWidth="1100"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding ViewModel.OpenPageCommand, Mode=OneWay}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction Command="{Binding ViewModel.ClosePageCommand, Mode=OneWay}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <!-- 本视图只引用自身资源与 WPF-UI 的动态主题资源，构造时不依赖父视图或应用资源。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="AccountsBoolVisibility" />
        <converters:BooleanToVisibilityRevertConverter x:Key="AccountsBoolVisibilityRevert" />
        <!-- ContextMenu 位于独立可视树，通过 Freezable 代理访问页面 ViewModel。 -->
        <behavior:BindingProxy x:Key="AccountsProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页首：标题、说明与“新增账户”；只有一个账户时列表收起，“新增账户”仍在这里。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="账户" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ViewModel.HeaderText, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       VerticalAlignment="Top"
                       Command="{Binding ViewModel.AddAccountCommand, Mode=OneWay}"
                       Content="新增账户"
                       Icon="{ui:SymbolIcon PersonAdd24}"
                       ToolTip="新增一个账户：填写名称、UID 和服务器，UID 可以从当前游戏读取" />
        </Grid>

        <!-- 本实例当前账户：修改立即保存，未确定时提示。 -->
        <Border Grid.Row="1"
                Margin="0,14,0,12"
                Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="本实例当前账户" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ViewModel.CurrentInstanceText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          MinWidth="220"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="本实例当前账户"
                          DisplayMemberPath="DisplayText"
                          IsEnabled="{Binding ViewModel.CanEdit, Mode=OneWay}"
                          ItemsSource="{Binding ViewModel.CurrentAccountOptions, Mode=OneWay}"
                          SelectedValue="{Binding ViewModel.CurrentAccountId, Mode=TwoWay}"
                          SelectedValuePath="Id" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{Binding ViewModel.CurrentAccountHint, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ViewModel.HasCurrentAccountHint, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧账户列表：只有一个账户时收起。上移、下移调整顺序，改名、删除在操作菜单中，保存后生效（删除立即保存）。 -->
            <DockPanel Width="270"
                       Margin="0,0,16,0"
                       Visibility="{Binding ViewModel.ShowAccountList, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}">
                <StackPanel Margin="0,0,0,8"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                    <ui:Button Margin="0,0,6,0"
                               AutomationProperties.Name="上移"
                               Command="{Binding ViewModel.MoveUpCommand, Mode=OneWay}"
                               Icon="{ui:SymbolIcon ArrowUp24}"
                               ToolTip="上移" />
                    <ui:Button Margin="0,0,6,0"
                               AutomationProperties.Name="下移"
                               Command="{Binding ViewModel.MoveDownCommand, Mode=OneWay}"
                               Icon="{ui:SymbolIcon ArrowDown24}"
                               ToolTip="下移" />
                    <ui:DropDownButton Content="操作"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                       ToolTip="账户操作：改名、删除">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Command="{Binding Data.ViewModel.RenameAccountCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="改名…" />
                                <Separator />
                                <MenuItem Command="{Binding Data.ViewModel.DeleteAccountCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="删除账户…" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
                <ListBox HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding ViewModel.Accounts, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding ViewModel.SelectedAccount, Mode=TwoWay}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding Data.ViewModel.MoveUpCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="上移" />
                            <MenuItem Command="{Binding Data.ViewModel.MoveDownCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="下移" />
                            <Separator />
                            <MenuItem Command="{Binding Data.ViewModel.RenameAccountCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="改名…" />
                            <MenuItem Command="{Binding Data.ViewModel.DeleteAccountCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}" Header="删除账户…" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type pulonia:PuloniaAccountItemViewModel}">
                            <StackPanel Margin="2,4">
                                <DockPanel>
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Right"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding UidText, Mode=OneWay}" />
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name, Mode=OneWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding InstancesText, Mode=OneWay, StringFormat=是{0}的当前账户}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding InstancesText, Mode=OneWay}"
                                           Visibility="{Binding HasInstances, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                                <!-- 账户正被运行占用时显示在哪个实例运行，例如“运行中 · 云原神 · 小号a”。 -->
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Text="{Binding RunningText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding LoginProfileText, Mode=OneWay}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="未保存"
                                           Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!--
                右侧账户详情：概况与登录资料是草稿，点“保存”后一次保存整个目录；
                路线 CD 与首领领奖是所选账户的账户进度，不属于草稿，页签显示时读取；狛荷屋页签只负责跳转。
            -->
            <TabControl Grid.Column="1"
                        BorderThickness="0"
                        IsEnabled="{Binding ViewModel.CanEdit, Mode=OneWay}"
                        SelectedIndex="{Binding ViewModel.SelectedDetailTabIndex, Mode=TwoWay}">
                <TabItem Header="概况">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640"
                                    Margin="4,12,12,12"
                                    HorizontalAlignment="Left">
                            <TextBlock Margin="0,0,0,6" Text="账户名称" />
                            <TextBox Margin="0,0,0,14"
                                     AutomationProperties.Name="账户名称"
                                     Text="{Binding ViewModel.SelectedAccount.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,0,0,6" Text="UID" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="UID"
                                         MaxLength="10"
                                         Text="{Binding ViewModel.SelectedAccount.Uid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Command="{Binding ViewModel.ReadUidCommand, Mode=OneWay}"
                                           Content="从当前游戏读取"
                                           Icon="{ui:SymbolIcon ScanText24}"
                                           ToolTip="请先让本实例的游戏停在主界面；只截图识别，不按键" />
                            </Grid>
                            <TextBlock Margin="0,0,0,14"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="完整的 9 或 10 位数字，不能与其他账户重复。目录中最多一个账户可以不填 UID；没有 UID 的账户不能被计划指定，也不做 UID 比对。"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,0,0,6" Text="服务器" />
                            <ComboBox Margin="0,0,0,4"
                                      HorizontalAlignment="Left"
                                      MinWidth="260"
                                      AutomationProperties.Name="服务器"
                                      DisplayMemberPath="Value"
                                      ItemsSource="{Binding ViewModel.ServerTimeZones, Mode=OneWay}"
                                      SelectedValue="{Binding ViewModel.SelectedAccount.ServerTimeZone, Mode=TwoWay}"
                                      SelectedValuePath="Key" />
                            <TextBlock Margin="0,0,0,14"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="决定这个账户的路线 CD 按哪个时区日切。"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,0,0,6" Text="作为哪些实例的当前账户" />
                            <TextBlock Margin="0,0,0,14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ViewModel.SelectedAccount.InstancesDetailText, Mode=OneWay}"
                                       TextWrapping="Wrap" />

                            <!-- 最近一次运行：所有实例中运行账户为该账户、最晚提交的一次。 -->
                            <TextBlock Margin="0,0,0,6" Text="最近一次运行" />
                            <TextBlock Margin="0,0,0,14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ViewModel.LastRunText, Mode=OneWay}"
                                       TextWrapping="Wrap" />

                            <!-- 指定了该账户的计划：点击跳转到任务计划页或新一条龙页并选中该计划。 -->
                            <TextBlock Margin="0,0,0,6" Text="指定了该账户的计划" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="没有计划指定这个账户。跟随当前账户的计划为各实例的当前账户运行。"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ViewModel.HasPlanUsages, Mode=OneWay, Converter={StaticResource AccountsBoolVisibilityRevert}}" />
                            <ItemsControl AutomationProperties.Name="指定了该账户的计划" ItemsSource="{Binding ViewModel.PlanUsages, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PuloniaAccountPlanUsage}">
                                        <ui:HyperlinkButton Padding="0,2"
                                                            Command="{Binding Data.ViewModel.OpenPlanCommand, Source={StaticResource AccountsProxy}, Mode=OneWay}"
                                                            CommandParameter="{Binding Mode=OneWay}"
                                                            Content="{Binding PlanName, Mode=OneWay}"
                                                            ToolTip="打开这个计划" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="登录资料">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640"
                                    Margin="4,12,12,12"
                                    HorizontalAlignment="Left">
                            <TextBlock Margin="0,0,0,14"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="只有需要 BetterGI 自动切换到这个账户时才需要填写。自动切换只支持本机 PC 官服窗口（主实例和桌面分身）。"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,0,0,6" Text="登录方式" />
                            <ComboBox Margin="0,0,0,14"
                                      HorizontalAlignment="Left"
                                      MinWidth="260"
                                      AutomationProperties.Name="登录方式"
                                      DisplayMemberPath="Value"
                                      ItemsSource="{Binding ViewModel.LoginModes, Mode=OneWay}"
                                      SelectedValue="{Binding ViewModel.SelectedAccount.LoginMode, Mode=TwoWay}"
                                      SelectedValuePath="Key" />

                            <TextBlock Margin="0,0,0,6"
                                       Text="登录列表中的账号文字（按登录列表填写脱敏手机号或邮箱）"
                                       TextWrapping="Wrap" />
                            <TextBox Margin="0,0,0,14"
                                     AutomationProperties.Name="登录列表文字"
                                     Text="{Binding ViewModel.SelectedAccount.ListText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,0,0,6" Text="账户图片" />
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ViewModel.SelectedAccount.ImagePathText, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,14">
                                <ui:Button Margin="0,0,8,0"
                                           Command="{Binding ViewModel.ImportImageCommand, Mode=OneWay}"
                                           Content="导入图片"
                                           Icon="{ui:SymbolIcon ImageAdd24}"
                                           ToolTip="导入 1080p 登录列表中的账户标识裁剪图" />
                                <ui:Button Command="{Binding ViewModel.CaptureImageCommand, Mode=OneWay}"
                                           Content="采集当前账户图片"
                                           Icon="{ui:SymbolIcon Camera24}"
                                           ToolTip="从本实例游戏当前登录的账户识别 UID，并在登录界面采集账户标识" />
                            </WrapPanel>

                            <TextBlock Margin="0,0,0,6"
                                       Text="账号和密码（可选，作为备用登录方式）"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,6"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="密码只保存在 Windows 凭据管理器。留空保留已保存的凭据；登录方式为账户图片或列表文字时，保存后删除已保存的凭据。"
                                       TextWrapping="Wrap" />
                            <ui:TextBox Margin="0,0,0,8"
                                        AutomationProperties.Name="登录账号"
                                        PlaceholderText="账号"
                                        Text="{Binding ViewModel.SelectedAccount.LoginUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox Margin="0,0,0,18" AutomationProperties.Name="登录密码">
                                <b:Interaction.Behaviors>
                                    <behavior:PasswordBoxBindingBehavior Password="{Binding ViewModel.SelectedAccount.LoginPassword, Mode=TwoWay}" />
                                </b:Interaction.Behaviors>
                            </PasswordBox>

                            <Separator Margin="0,0,0,14" />
                            <TextBlock Margin="0,0,0,6" Text="测试切换" />
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ViewModel.TestSwitchHint, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                            <ui:Button HorizontalAlignment="Left"
                                       Command="{Binding ViewModel.TestSwitchCommand, Mode=OneWay}"
                                       Content="测试切换"
                                       Icon="{ui:SymbolIcon PeopleSwap24}"
                                       ToolTip="{Binding ViewModel.TestSwitchHint, Mode=OneWay}"
                                       ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 路线 CD：固定为所选账户的完成记录，可按计划、状态和关键词筛选；清除记录立即生效，不能撤销。 -->
                <TabItem Header="路线 CD">
                    <controls:PuloniaRouteCooldownOverviewView Margin="4,12,12,12" DataContext="{Binding ViewModel.RouteCooldowns, Mode=OneWay}" />
                </TabItem>
                <!-- 首领领奖：所选账户在各计划首领讨伐任务中当前重置批次内的累计领奖次数，只读；页签显示时读取。 -->
                <TabItem Header="首领领奖">
                    <Grid Margin="4,12,12,12" DataContext="{Binding ViewModel.BossRewards, Mode=OneWay}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Loaded">
                                <b:InvokeCommandAction Command="{Binding ShowCommand, Mode=OneWay}" />
                            </b:EventTrigger>
                            <b:EventTrigger EventName="Unloaded">
                                <b:InvokeCommandAction Command="{Binding HideCommand, Mode=OneWay}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SummaryText, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Row="1"
                                Padding="10,6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="计划" />
                                <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" Text="任务" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="累计成功领奖" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl AutomationProperties.Name="首领领奖次数列表" ItemsSource="{Binding Entries, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pulonia:PuloniaBossRewardEntryViewModel}">
                                            <Grid Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="140" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PlanName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PlanName, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0"
                                                           Text="{Binding NodeName, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding NodeName, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CountText, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Margin="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="{Binding EmptyText, Mode=OneWay}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowEmptyText, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                            <ui:ProgressRing HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                        </Grid>
                        <ui:Button Grid.Row="3"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   Command="{Binding RefreshCommand, Mode=OneWay}"
                                   Content="刷新"
                                   ToolTip="重新读取这个账户的领奖次数；其他实例刚写入的次数需要刷新后显示" />
                    </Grid>
                </TabItem>
                <!-- 狛荷屋：跳转到狛荷屋页面并选中该账户；没有 UID 或 UID 未保存时按钮不可用，说明文字提示先填写并保存。 -->
                <TabItem Header="狛荷屋">
                    <StackPanel MaxWidth="640"
                                Margin="4,12,12,12"
                                HorizontalAlignment="Left">
                        <TextBlock Margin="0,0,0,8"
                                   Text="狛荷屋按 UID 记录这个账户的库存、异常和事件。修改 UID 时记录随之改名，删除账户时一并删除。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,12"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding ViewModel.AccountRecordsHint, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <ui:Button HorizontalAlignment="Left"
                                   Command="{Binding ViewModel.OpenAccountRecordsCommand, Mode=OneWay}"
                                   Content="打开狛荷屋"
                                   Icon="{ui:SymbolIcon Box24}"
                                   ToolTip="{Binding ViewModel.AccountRecordsHint, Mode=OneWay}"
                                   ToolTipService.ShowOnDisabled="True" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部：操作结果、未保存提示、取消游戏操作、放弃修改与保存。 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel VerticalAlignment="Center">
                <ui:ProgressRing Width="14"
                                 Height="14"
                                 Margin="0,0,8,0"
                                 DockPanel.Dock="Left"
                                 IsIndeterminate="True"
                                 Visibility="{Binding ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding ViewModel.Message, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="有未保存的修改"
                       Visibility="{Binding ViewModel.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
            <ui:Button Grid.Column="2"
                       Margin="12,0,0,0"
                       Command="{Binding ViewModel.CancelOperationCommand, Mode=OneWay}"
                       Content="取消"
                       Visibility="{Binding ViewModel.IsGameOperationRunning, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
            <ui:Button Grid.Column="3"
                       Margin="12,0,0,0"
                       Command="{Binding ViewModel.DiscardChangesCommand, Mode=OneWay}"
                       Content="放弃修改"
                       Visibility="{Binding ViewModel.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource AccountsBoolVisibility}}" />
            <ui:Button Grid.Column="4"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Command="{Binding ViewModel.SaveCommand, Mode=OneWay}"
                       Content="保存"
                       Icon="{ui:SymbolIcon Save24}" />
        </Grid>
    </Grid>
</UserControl>
