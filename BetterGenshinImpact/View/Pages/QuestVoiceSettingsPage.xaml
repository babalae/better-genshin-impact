<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=local:QuestVoiceSettingsPage}"
             d:DesignHeight="950"
             d:DesignWidth="900"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <ui:TextBlock Text="自动配音" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="配置角色声线、映射规则、OCR 与 GPT-SoVITS 后端。运行状态请在「运行与日志」页面查看。"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,12" />

            <!-- 5.1 基础配置 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon Settings24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="基础配置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="控制自动配音的角色路由、默认声线、流式模式与 GPT-SoVITS 服务"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="启用角色声线路由" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="根据角色映射规则选择对应声线进行合成，关闭时使用默认 NPC 声线"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="16,0,24,0"
                                         IsChecked="{Binding ViewModel.Config.RoutingEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="默认 NPC 声线" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="未启用角色路由或未命中角色映射时使用的默认兜底声线名称"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Width="240"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ViewModel.Config.VoiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="流式配音（实验性）" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="启用按句流式合成以降低首段延迟；请先停止配音再修改，下次启动生效"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="16,0,24,0"
                                         IsChecked="{Binding ViewModel.Config.StreamingEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="GPT-SoVITS 服务地址" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="填写本地或远程 GPT-SoVITS api_v2 HTTP 地址"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Width="280"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ViewModel.Config.ServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="后端连接与恢复" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding ViewModel.Status.Tts, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Margin="16,0,24,0"
                                   VerticalAlignment="Center">
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding ViewModel.ProbeBackendCommand, Mode=OneWay}"
                                       Content="检测后端 HTTP" />
                            <ui:Button Command="{Binding ViewModel.ConfirmBackendRestartedCommand, Mode=OneWay}"
                                       Content="确认后端已重启"
                                       ToolTip="仅在后端状态未知时可用；须先手动重启 GPT-SoVITS，再确认恢复。" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.2 角色映射与声线配置 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon PeopleSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="角色映射与声线配置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="配置角色名与声线的映射规则，支持角色别名、旅行者、玩家昵称与默认 NPC 兜底"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="角色路由配置文件路径" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="默认使用 User/QuestVoice/routing.json，支持相对路径或绝对路径"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,8,8,0"
                                    Text="{Binding ViewModel.Config.RoutingCatalogPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,8,24,0"
                                   Command="{Binding ViewModel.BrowseRoutingCatalogCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.OpenRoutingCommand, Mode=OneWay}"
                                       Content="编辑角色映射 JSON"
                                       Icon="{ui:SymbolIcon Document24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.OpenConfigurationCommand, Mode=OneWay}"
                                       Content="打开配置与资源目录"
                                       Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.ValidateCommand, Mode=OneWay}"
                                       Content="校验映射配置"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1">
                            <ui:TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="映射状态：" />
                                <Run Text="{Binding ViewModel.Status.Routing, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="校验结果：" />
                                <Run Text="{Binding ViewModel.Status.Validation, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="旅行者（ProtagonistId）、玩家昵称（PlayerNames）、角色别名及 FallbackVoiceId 在 JSON 中定义；修改配置后停止并重新启动自动配音即可生效。"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.3 高级声线资源（默认折叠） -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="False"
                             Icon="{ui:SymbolIcon Box24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="高级声线资源" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="配置默认 NPC 声线的 GPT 权重、SoVITS 权重、参考音频路径与逐字原文"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="GPT 权重（.ckpt）路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.Config.GptWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Command="{Binding ViewModel.BrowseGptWeightsCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="SoVITS 权重（.pth）路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.Config.SovitsWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Command="{Binding ViewModel.BrowseSovitsWeightsCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="参考音频路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.Config.ReferenceAudioPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Command="{Binding ViewModel.BrowseReferenceAudioCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <StackPanel Margin="16,12,40,16">
                        <ui:TextBlock FontTypography="Body" Text="参考音频对应的逐字原文" />
                        <ui:TextBox Margin="0,6,0,0"
                                    MinHeight="64"
                                    AcceptsReturn="True"
                                    Text="{Binding ViewModel.Config.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.4 OCR 设置 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon BarcodeScanner24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="OCR 设置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="对白区域文字识别的模型路径、DirectML 设备序号与采样间隔设置"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="OCR 模型路径" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="带 18708 字 character 字典的 PP-OCRv6 Rec ONNX 模型路径"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,8,8,0"
                                    Text="{Binding ViewModel.Config.OcrModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,8,24,0"
                                   Command="{Binding ViewModel.BrowseOcrModelCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="DirectML 设备序号" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="专用 OCR 使用的 DirectML 设备序号，不修改全局 OCR 配置"
                                      TextWrapping="Wrap" />
                        <ui:NumberBox Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="1"
                                      Width="140"
                                      Margin="16,0,24,0"
                                      VerticalAlignment="Center"
                                      MaxDecimalPlaces="0"
                                      Maximum="16"
                                      Minimum="0"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.Config.DeviceId, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="采样间隔（毫秒）" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="自动配音沿用 BetterGI 的全局截图与帧输入能力按此间隔取样（50～500 毫秒），不单独创建捕获器"
                                      TextWrapping="Wrap" />
                        <ui:NumberBox Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="1"
                                      Width="140"
                                      Margin="16,0,24,0"
                                      VerticalAlignment="Center"
                                      MaxDecimalPlaces="0"
                                      Maximum="500"
                                      Minimum="50"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.Config.SampleIntervalMilliseconds, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:TextBlock Margin="0,0,0,8"
                          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ViewModel.CommandError, Mode=OneWay}"
                          TextWrapping="Wrap"
                          Visibility="{Binding ViewModel.HasCommandError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
