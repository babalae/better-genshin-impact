<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoiceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=local:QuestVoiceSettingsPage}"
             d:DesignHeight="950"
             d:DesignWidth="900"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <ui:TextBlock Text="自动配音" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="配置 TTS 引擎、角色声线、映射规则与 OCR。运行状态请在「运行与日志」页面查看。"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,12" />

            <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="True" Icon="{ui:SymbolIcon Speaker224}">
                <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="Body" Text="TTS 引擎与测试语音" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <StackPanel IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <ComboBox ItemsSource="{Binding ViewModel.Providers, Mode=OneWay}"
                                  SelectedItem="{Binding ViewModel.SelectedProvider, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                        <ui:TextBlock Margin="0,8,0,12" Text="{Binding ViewModel.ProviderDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding ViewModel.SupportsPresetVoices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="默认声音（选择预设或输入声音 ID）" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ViewModel.Voices, Mode=OneWay}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding ViewModel.SelectedVoice, Mode=TwoWay}" />
                            <ui:Button Content="刷新声音列表" Command="{Binding ViewModel.RefreshVoicesCommand, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,6,0,6" />
                            <ui:TextBox Text="{Binding ViewModel.SelectedVoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="声音 ID / SAPI token / 兼容服务自定义 ID" />
                            <ui:TextBlock Text="VOICEVOX 与 vits-simple-api 需点击刷新读取服务声音；刷新不会清除已填写的 ID。" TextWrapping="Wrap" Margin="0,6,0,6" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ToggleSwitch Content="使用远程服务实例（独立保存地址和默认声线）" IsChecked="{Binding ViewModel.Config.UseRemoteService, Mode=TwoWay}" />
                            <ui:TextBlock Margin="0,6,0,0" Text="远程权重及参考音频必须已经存在于服务器；支持 Linux 或服务器相对路径，不会自动上传本机文件。角色映射中的路径也按当前服务器解释。" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,8" Visibility="{Binding ViewModel.SupportsExtraServerConnection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="当前引擎服务连接" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:ToggleSwitch Content="使用此引擎的远程实例" IsChecked="{Binding ViewModel.SelectedEngineConfig.UseRemote, Mode=TwoWay}" />
                            <ui:TextBox Margin="0,6,0,6" Text="{Binding ViewModel.ActiveExtraServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HTTP / HTTPS Base URL，保留代理子路径与 /v1/" />
                            <ui:TextBlock Text="本地与远程地址分别保存；请自行启动已有服务。OpenAI 兼容服务填写完整 Base URL（例如 https://api.openai.com/v1/）。" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsLanguage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="语言（使用服务支持的语言代码，例如 auto / zh / ja）" Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding ViewModel.SelectedEngineConfig.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsModel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="模型（由兼容服务提供，例如 tts-1）" Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding ViewModel.SelectedEngineConfig.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsApiKey, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="API Key（可选，取决于服务要求）" Margin="0,0,0,6" />
                            <PasswordBox>
                                <i:Interaction.Behaviors>
                                    <behavior:PasswordBoxBindingBehavior Password="{Binding ViewModel.SelectedEngineConfig.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </i:Interaction.Behaviors>
                            </PasswordBox>
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsRate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="{Binding ViewModel.RateHint, Mode=OneWay}" Margin="0,0,0,6" />
                            <ui:NumberBox Minimum="0.25" Maximum="4" MaxDecimalPlaces="2"
                                          Value="{Binding ViewModel.SelectedEngineConfig.Rate, Mode=TwoWay}" Visibility="{Binding ViewModel.SupportsContinuousRate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox ItemsSource="{Binding ViewModel.DiscreteRates, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedEngineConfig.Rate, Mode=TwoWay}"
                                      Visibility="{Binding ViewModel.UsesDiscreteRate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsPitch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="音高 pitchScale（-0.15～0.15，0 为默认）" Margin="0,0,0,6" />
                            <ui:NumberBox Minimum="-0.15" Maximum="0.15" MaxDecimalPlaces="2" Value="{Binding ViewModel.SelectedEngineConfig.Pitch, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,6" Visibility="{Binding ViewModel.SupportsAudioFormat, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="服务返回格式（pcm 按 OpenAI PCM16 / 24kHz / 单声道解释）" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ViewModel.AudioFormats, Mode=OneWay}" SelectedItem="{Binding ViewModel.SelectedEngineConfig.Format, Mode=TwoWay}" />
                        </StackPanel>
                        <ui:TextBlock Margin="0,8,0,6" Text="连接 / 请求 / 合成超时（秒）" />
                        <WrapPanel>
                            <ui:NumberBox Width="150" Minimum="1" Maximum="120" MaxDecimalPlaces="0" Value="{Binding ViewModel.Config.ConnectTimeoutSeconds, Mode=TwoWay}" />
                            <ui:NumberBox Width="150" Margin="8,0" Minimum="1" Maximum="600" MaxDecimalPlaces="0" Value="{Binding ViewModel.Config.RequestTimeoutSeconds, Mode=TwoWay}" />
                            <ui:NumberBox Width="150" Minimum="1" Maximum="600" MaxDecimalPlaces="0" Value="{Binding ViewModel.Config.SynthesisTimeoutSeconds, Mode=TwoWay}" />
                        </WrapPanel>
                        <ui:TextBox Margin="0,12,0,8" Text="{Binding ViewModel.TestText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>
                    <WrapPanel>
                        <ui:Button Content="连接检测" Command="{Binding ViewModel.ProbeBackendCommand, Mode=OneWay}" Margin="0,0,8,6" />
                        <ui:Button Content="测试合成并播放" Command="{Binding ViewModel.TestSpeechCommand, Mode=OneWay}" Margin="0,0,8,6" />
                        <ui:Button Content="取消测试" Command="{Binding ViewModel.CancelTestSpeechCommand, Mode=OneWay}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <ui:TextBlock Text="{Binding ViewModel.Status.Tts, Mode=OneWay}" TextWrapping="Wrap" />
                    <ui:TextBlock Text="{Binding ViewModel.Status.Playback, Mode=OneWay}" TextWrapping="Wrap" />
                    <ui:TextBlock Margin="0,6,0,0" Text="设置自动保存，停止后修改，下次启动生效。测试语音无需游戏或 OCR；测试入口完整接收后播放。" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardExpander>
            <!-- 5.1 基础配置 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon Settings24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="基础配置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="控制当前引擎支持的角色路由、默认声线、流式模式与服务连接"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="启用角色声线路由" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="根据角色映射规则选择对应声线进行合成，关闭时使用默认 NPC 声线"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="16,0,24,0"
                                         IsChecked="{Binding ViewModel.Config.RoutingEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Visibility="{Binding ViewModel.SupportsVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="默认 NPC 声线" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="未启用角色路由或未命中角色映射时使用的默认兜底声线名称"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Width="240"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ViewModel.Config.VoiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Visibility="{Binding ViewModel.SupportsStreaming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="流式配音（实验性）" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="启用按句流式合成以降低首段延迟；请先停止配音再修改，下次启动生效"
                                      TextWrapping="Wrap" />
                        <ui:ToggleSwitch Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="1"
                                         Margin="16,0,24,0"
                                         IsChecked="{Binding ViewModel.Config.StreamingEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Visibility="{Binding ViewModel.SupportsVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="GPT-SoVITS 服务地址" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="填写本地或远程 GPT-SoVITS api_v2 HTTP 地址"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Width="280"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding ViewModel.ActiveServiceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Visibility="{Binding ViewModel.RequiresBackendDrain, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="后端连接与恢复" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="{Binding ViewModel.Status.Tts, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="1"
                                   Margin="16,0,24,0"
                                   VerticalAlignment="Center">
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding ViewModel.ProbeBackendCommand, Mode=OneWay}"
                                       Content="检测后端 HTTP" />
                            <ui:Button Command="{Binding ViewModel.ConfirmBackendRestartedCommand, Mode=OneWay}"
                                       Content="确认后端已重启"
                                       ToolTip="仅在后端状态未知时可用；须先手动重启 GPT-SoVITS，再确认恢复。" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.2 角色映射与声线配置 -->
            <ui:CardExpander Margin="0,0,0,12" ContentPadding="0" IsExpanded="True" Icon="{ui:SymbolIcon PeopleSwap24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="角色映射与声线配置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="配置角色名与声线的映射规则，支持角色别名、旅行者、玩家昵称与默认 NPC 兜底"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16" IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="角色路由配置文件路径" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="默认使用 User/QuestVoice/routing.json，支持相对路径或绝对路径"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,8,8,0"
                                    Text="{Binding ViewModel.Config.RoutingCatalogPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,8,24,0"
                                   Command="{Binding ViewModel.BrowseRoutingCatalogCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.OpenRoutingCommand, Mode=OneWay}"
                                       Content="编辑角色映射 JSON"
                                       Icon="{ui:SymbolIcon Document24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.OpenConfigurationCommand, Mode=OneWay}"
                                       Content="打开配置与资源目录"
                                       Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.ValidateCommand, Mode=OneWay}"
                                       Content="校验映射配置"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                        </WrapPanel>
                        <StackPanel Grid.Row="1">
                            <ui:TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="映射状态：" />
                                <Run Text="{Binding ViewModel.Status.Routing, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="校验结果：" />
                                <Run Text="{Binding ViewModel.Status.Validation, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="下方管理器使用独立草稿，点击保存后下次启动生效；直接编辑外部 JSON 后请重新加载。"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <local:QuestVoiceManagementView DataContext="{Binding ViewModel.Management, Mode=OneWay}" />
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.3 高级声线资源（默认折叠） -->
            <ui:CardExpander Visibility="{Binding ViewModel.SupportsVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="False"
                             Icon="{ui:SymbolIcon Box24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="高级声线资源" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="配置当前实例的权重、参考音频和逐字原文；远程实例只使用服务器已有路径，不上传文件"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="GPT 权重（.ckpt）路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.ActiveGptWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Visibility="{Binding ViewModel.CanBrowseVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ViewModel.BrowseGptWeightsCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="SoVITS 权重（.pth）路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.ActiveSovitsWeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Visibility="{Binding ViewModel.CanBrowseVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ViewModel.BrowseSovitsWeightsCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="参考音频路径" />
                        <ui:TextBox Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,6,8,0"
                                    Text="{Binding ViewModel.ActiveReferenceAudioPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,6,24,0"
                                   Visibility="{Binding ViewModel.CanBrowseVoiceAssets, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ViewModel.BrowseReferenceAudioCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <StackPanel Margin="16,12,40,16">
                        <ui:TextBlock FontTypography="Body" Text="参考音频对应的逐字原文" />
                        <ui:TextBox Margin="0,6,0,0"
                                    MinHeight="64"
                                    AcceptsReturn="True"
                                    Text="{Binding ViewModel.ActivePromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- 5.4 OCR 设置 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon BarcodeScanner24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="OCR 设置" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="对白区域文字识别的模型路径、DirectML 设备序号与采样间隔设置"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel IsEnabled="{Binding ViewModel.IsConfigEditable, Mode=OneWay}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="OCR 模型路径" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="带 18708 字 character 字典的 PP-OCRv6 Rec ONNX 模型路径"
                                      TextWrapping="Wrap" />
                        <ui:TextBox Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,8,8,0"
                                    Text="{Binding ViewModel.Config.OcrModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,8,24,0"
                                   Command="{Binding ViewModel.BrowseOcrModelCommand, Mode=OneWay}"
                                   Content="浏览"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="DirectML 设备序号" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="专用 OCR 使用的 DirectML 设备序号，不修改全局 OCR 配置"
                                      TextWrapping="Wrap" />
                        <ui:NumberBox Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="1"
                                      Width="140"
                                      Margin="16,0,24,0"
                                      VerticalAlignment="Center"
                                      MaxDecimalPlaces="0"
                                      Maximum="16"
                                      Minimum="0"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.Config.DeviceId, Mode=TwoWay}" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Row="0" Grid.Column="0" FontTypography="Body" Text="采样间隔（毫秒）" />
                        <ui:TextBlock Grid.Row="1"
                                      Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="自动配音沿用 BetterGI 的全局截图与帧输入能力按此间隔取样（50～500 毫秒），不单独创建捕获器"
                                      TextWrapping="Wrap" />
                        <ui:NumberBox Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="1"
                                      Width="140"
                                      Margin="16,0,24,0"
                                      VerticalAlignment="Center"
                                      MaxDecimalPlaces="0"
                                      Maximum="500"
                                      Minimum="50"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding ViewModel.Config.SampleIntervalMilliseconds, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <ui:TextBlock Margin="0,0,0,8"
                          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                          Text="{Binding ViewModel.CommandError, Mode=OneWay}"
                          TextWrapping="Wrap"
                          Visibility="{Binding ViewModel.HasCommandError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
