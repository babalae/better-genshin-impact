<UserControl x:Class="BetterGenshinImpact.View.Pages.QuestVoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:qv="clr-namespace:BetterGenshinImpact.GameTask.QuestVoice"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DataContext="{d:DesignInstance Type=local:QuestVoicePage}"
             d:DesignHeight="850"
             d:DesignWidth="900"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{DynamicResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OverallStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.InProgress}">
                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Completed}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Failed}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverallStatusTextStyle" TargetType="ui:TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.InProgress}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Completed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StageNodeCircleStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.InProgress}">
                    <Setter Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Completed}">
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Failed}">
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StageConnectorStyle" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.InProgress}">
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Completed}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Failed}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StageLabelStyle" TargetType="ui:TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.InProgress}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Completed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static qv:QuestVoiceStageState.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <ui:TextBlock Text="自动配音" FontTypography="Title" Margin="0,0,0,4" />
            <ui:TextBlock Text="原神实时对白识别与自动配音。"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,12" />

            <!-- 4.2 运行控制 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon PlayCircle24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="运行控制" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="启动或停止实时自动配音，切换页面不会中断当前会话"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,8,4"
                                       Appearance="Primary"
                                       Command="{Binding ViewModel.StartCommand, Mode=OneWay}"
                                       Content="启动自动配音"
                                       Icon="{ui:SymbolIcon Play24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.StopCommand, Mode=OneWay}"
                                       Content="停止配音与播放"
                                       Icon="{ui:SymbolIcon Stop24}" />
                            <ui:Button Margin="0,0,8,4"
                                       Command="{Binding ViewModel.ValidateCommand, Mode=OneWay}"
                                       Content="校验配置"
                                       Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                        </WrapPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,8,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <ui:TextBlock Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="当前状态" />
                            <Ellipse Style="{StaticResource OverallStatusDotStyle}"
                                     Tag="{Binding ViewModel.Status.OverallStatusState, Mode=OneWay}" />
                            <ui:TextBlock Style="{StaticResource OverallStatusTextStyle}"
                                          Tag="{Binding ViewModel.Status.OverallStatusState, Mode=OneWay}"
                                          Text="{Binding ViewModel.Status.OverallStatus, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <StackPanel Margin="16,10,16,14">
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap">
                            <Run Text="{Binding ViewModel.Status.Game, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding ViewModel.Status.Session, Mode=OneWay}" />
                        </ui:TextBlock>
                        <ui:TextBlock Margin="0,6,0,0"
                                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                      Text="{Binding ViewModel.Status.Error, Mode=OneWay}"
                                      TextWrapping="Wrap"
                                      Visibility="{Binding ViewModel.Status.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:TextBlock Margin="0,4,0,0"
                                      Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                      Text="{Binding ViewModel.CommandError, Mode=OneWay}"
                                      TextWrapping="Wrap"
                                      Visibility="{Binding ViewModel.HasCommandError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- 4.3 当前流程进度 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon TaskListSquareLtr24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="当前流程进度" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="对话界面检测 → OCR 识别 → 角色识别 → 声线路由 → TTS 合成 → 音频播放"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="16">
                    <Grid Margin="0,4,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 步骤连接线 -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="56,0,56,0"
                                Style="{StaticResource StageConnectorStyle}"
                                Tag="{Binding ViewModel.Status.SceneStage, Mode=OneWay}" />
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                Margin="56,0,56,0"
                                Style="{StaticResource StageConnectorStyle}"
                                Tag="{Binding ViewModel.Status.OcrStage, Mode=OneWay}" />
                        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                Margin="56,0,56,0"
                                Style="{StaticResource StageConnectorStyle}"
                                Tag="{Binding ViewModel.Status.SpeakerStage, Mode=OneWay}" />
                        <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2"
                                Margin="56,0,56,0"
                                Style="{StaticResource StageConnectorStyle}"
                                Tag="{Binding ViewModel.Status.RoutingStage, Mode=OneWay}" />
                        <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                                Margin="56,0,56,0"
                                Style="{StaticResource StageConnectorStyle}"
                                Tag="{Binding ViewModel.Status.TtsStage, Mode=OneWay}" />

                        <!-- 1. 对话界面检测 -->
                        <Ellipse Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.SceneStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="0"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="对话界面检测" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="0"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.SceneStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.SceneStageText, Mode=OneWay}" />

                        <!-- 2. OCR 识别 -->
                        <Ellipse Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.OcrStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="1"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="OCR 识别" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.OcrStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.OcrStageText, Mode=OneWay}" />

                        <!-- 3. 角色识别 -->
                        <Ellipse Grid.Row="0" Grid.Column="2"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.SpeakerStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="2"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="角色识别" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="2"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.SpeakerStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.SpeakerStageText, Mode=OneWay}" />

                        <!-- 4. 声线路由 -->
                        <Ellipse Grid.Row="0" Grid.Column="3"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.RoutingStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="3"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="声线路由" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="3"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.RoutingStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.RoutingStageText, Mode=OneWay}" />

                        <!-- 5. TTS 合成 -->
                        <Ellipse Grid.Row="0" Grid.Column="4"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.TtsStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="4"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="TTS 合成" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="4"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.TtsStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.TtsStageText, Mode=OneWay}" />

                        <!-- 6. 音频播放 -->
                        <Ellipse Grid.Row="0" Grid.Column="5"
                                 Style="{StaticResource StageNodeCircleStyle}"
                                 Tag="{Binding ViewModel.Status.PlaybackStage, Mode=OneWay}" />
                        <ui:TextBlock Grid.Row="1" Grid.Column="5"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"
                                      Text="音频播放" />
                        <ui:TextBlock Grid.Row="2" Grid.Column="5"
                                      Style="{StaticResource StageLabelStyle}"
                                      Tag="{Binding ViewModel.Status.PlaybackStage, Mode=OneWay}"
                                      Text="{Binding ViewModel.Status.PlaybackStageText, Mode=OneWay}" />
                    </Grid>

                    <Border Padding="12,8"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6">
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding ViewModel.Status.StageSummary, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ui:CardExpander>

            <!-- 4.4 当前处理内容 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon Document24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="当前处理内容" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="当前对白状态、识别角色、实际命中声线及合成播放结果"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前对话状态" />
                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding ViewModel.Status.DialogueState, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前角色" />
                        <ui:TextBlock Grid.Column="1"
                                      FontTypography="BodyStrong"
                                      Text="{Binding ViewModel.Status.Character, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前对白" />
                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding ViewModel.Status.Dialogue, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前实际声线" />
                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding ViewModel.Status.Voice, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前合成状态" />
                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding ViewModel.Status.Tts, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="当前播放状态" />
                        <ui:TextBlock Grid.Column="1"
                                      Text="{Binding ViewModel.Status.Playback, Mode=OneWay}"
                                      TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- 4.5 最近事件 -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             IsExpanded="True"
                             Icon="{ui:SymbolIcon History24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock Grid.Row="0" FontTypography="Body" Text="最近事件" />
                        <ui:TextBlock Grid.Row="1"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      Text="保留最近关键运行反馈，完整日志请通过下方按钮查看 BetterGI 主日志"
                                      TextWrapping="Wrap" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <StackPanel Margin="16,12">
                        <ItemsControl ItemsSource="{Binding ViewModel.Status.RecentEvents, Mode=OneWay}"
                                      Visibility="{Binding ViewModel.Status.HasRecentEvents, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:TextBlock Margin="0,3"
                                                  Text="{Binding Mode=OneWay}"
                                                  TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="暂无最近运行事件。"
                                      TextWrapping="Wrap">
                            <ui:TextBlock.Style>
                                <Style TargetType="ui:TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.Status.HasRecentEvents, Mode=OneWay}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:TextBlock.Style>
                        </ui:TextBlock>
                    </StackPanel>
                    <Separator Margin="-18,0" BorderThickness="0,1,0,0" />
                    <WrapPanel Margin="16,12">
                        <ui:Button Margin="0,0,8,4"
                                   Command="{Binding ViewModel.OpenLogFileCommand, Mode=OneWay}"
                                   Content="打开 BetterGI 日志"
                                   Icon="{ui:SymbolIcon Document24}" />
                        <ui:Button Margin="0,0,8,4"
                                   Command="{Binding ViewModel.OpenLogFolderCommand, Mode=OneWay}"
                                   Content="打开日志目录"
                                   Icon="{ui:SymbolIcon FolderOpen24}" />
                    </WrapPanel>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
