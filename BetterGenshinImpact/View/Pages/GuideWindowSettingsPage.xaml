<Page x:Class="BetterGenshinImpact.View.Pages.GuideWindowSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:hotKey="clr-namespace:BetterGenshinImpact.View.Controls.HotKey"
      xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:model="clr-namespace:BetterGenshinImpact.Model"
      xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="GuideWindowSettingsPage"
      d:DataContext="{d:DesignInstance Type=pages:GuideWindowSettingsPageViewModel}"
      d:DesignHeight="2400"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FontFamily="{StaticResource TextThemeFontFamily}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <!--  设置项标题  -->
        <!--  WPF-UI 没有为 ui:TextBlock 提供按类型索引的默认样式，这里不使用 BasedOn  -->
        <Style x:Key="GuideItemTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  设置项说明  -->
        <Style x:Key="GuideItemDescription" TargetType="ui:TextBlock">
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  右侧下拉框  -->
        <Style x:Key="GuideComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}"
               TargetType="ComboBox">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Margin" Value="0,0,36,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="DisplayMemberPath" Value="Name" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="{StaticResource PagePadding}">
        <ui:TextBlock Margin="0,0,0,4"
                      FontTypography="BodyStrong"
                      Text="{i18n:T 悬浮小窗}" />
        <ui:TextBlock Margin="0,0,0,12"
                      Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                      Text="{i18n:T 边玩边看攻略视频的置顶小窗。在游戏中按住 Alt 把鼠标移到小窗上即可操作，常用操作都可以用快捷键完成，不需要切换窗口。}"
                      TextWrapping="Wrap" />

        <!--  子实例不可用的说明  -->
        <Border Margin="0,0,0,12"
                Padding="16,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="{Binding IsAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
            <ui:TextBlock Text="{i18n:T 悬浮小窗只能在主实例中使用。}" TextWrapping="Wrap" />
        </Border>

        <StackPanel IsEnabled="{Binding IsAvailable, Mode=OneWay}">
            <!--  状态与操作  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon VideoClip24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 小窗}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{Binding StatusText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Command="{Binding OpenWindowCommand}"
                                       Content="{i18n:T 打开小窗}"
                                       Icon="{ui:SymbolIcon Open24}" />
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding HideWindowCommand}"
                                       Content="{i18n:T 隐藏}"
                                       IsEnabled="{Binding State.IsShown, Mode=OneWay}" />
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding CloseWindowCommand}"
                                       Content="{i18n:T 关闭}"
                                       IsEnabled="{Binding State.IsOpen, Mode=OneWay}" />
                            <ui:Button Command="{Binding RestoreWindowCommand}"
                                       Content="{i18n:T 恢复小窗}"
                                       Icon="{ui:SymbolIcon ArrowReset24}"
                                       ToolTip="{i18n:T 显示小窗，关闭鼠标穿透、退出沉浸与交互模式，不透明度恢复 100%，并移回屏幕内}" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!--  主页  -->
            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 主页}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 没有上次看过的页面时打开}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <ui:TextBox Width="280"
                                        Margin="0,0,8,0"
                                        Text="{Binding Config.HomeUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <ui:Button Command="{Binding ResetHomeUrlCommand}"
                                       Content="{i18n:T 恢复 B 站首页}" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!--  外观与窗口  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Window24}"
                             IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 外观与窗口}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 鼠标不在小窗上时的不透明度、置顶与位置。鼠标移到小窗上时总是 100% 显示}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 不透明度}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 也可以在小窗的窗口栏上滚动鼠标调整}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <Slider Width="200"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="1"
                                    Minimum="0.2"
                                    TickFrequency="0.05"
                                    Value="{Binding Config.Opacity, Mode=TwoWay}" />
                            <TextBlock Width="44"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Config.Opacity, Mode=OneWay, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 始终置顶}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 关闭后小窗是普通窗口，适合放在副屏}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.Topmost, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 位置}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 跟随游戏窗口：小窗停靠在游戏画面的一角，随游戏窗口移动。自由放置：可以放在任意显示器上}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PositionModeOptions}"
                                  SelectedValue="{Binding PositionMode, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 网页缩放}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 小窗较小时适当缩小网页，可以看到更多内容}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ZoomOptions}"
                                  SelectedValue="{Binding Config.ZoomFactor, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 沉浸模式下按视频比例缩放}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 进入沉浸模式和拖动缩放时保持视频宽高比，避免黑边}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.LockAspectInImmersive, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 显示底部进度线}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 窗口栏隐藏时，在小窗底边显示一条细的播放进度线}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.ShowProgressLine, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  鼠标与焦点  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon CursorClick24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 鼠标穿透与交互}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 小窗默认不抢游戏焦点；需要在网页里输入文字时进入交互模式，结束后自动回到游戏}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 鼠标穿透}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 开启后点击直接落到下方的游戏上，不会误点小窗。穿透时用快捷键、托盘菜单或上方的“恢复小窗”恢复操作}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.IsClickThrough, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 智能透明}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 鼠标穿透时，鼠标经过小窗会自动淡化，露出下方的游戏画面，方便点击被挡住的按钮}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.SmartFadeEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12" Visibility="{Binding Config.SmartFadeEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 淡化后的不透明度}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <Slider Width="200"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="0.8"
                                    Minimum="0.1"
                                    TickFrequency="0.05"
                                    Value="{Binding Config.SmartFadeOpacity, Mode=TwoWay}" />
                            <TextBlock Width="44"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Config.SmartFadeOpacity, Mode=OneWay, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 交互模式自动结束}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 交互模式下可以在网页中输入文字；鼠标离开小窗一段时间后自动结束，并把焦点还给游戏}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding InteractionExitOptions}"
                                  SelectedValue="{Binding Config.InteractionAutoExitSeconds, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  自动显示隐藏  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon EyeOff24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 自动显示与隐藏}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 进入游戏时打开，游戏切到后台时隐藏，执行任务时让开}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 进入游戏时}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 截图器连接到游戏窗口时自动打开小窗。自动打开时不会自动播放视频}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AutoOpenOptions}"
                                  SelectedValue="{Binding Config.AutoOpenOnGameStart, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 游戏最小化或切到后台时隐藏}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 切到其他程序时隐藏，回到游戏时自动显示；切到 BetterGI 主界面时保持不变}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.HideWhenGameInactive, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 小窗在其他显示器上时不自动隐藏}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 小窗与游戏不在同一显示器时，只在游戏最小化时隐藏}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.KeepVisibleOnOtherMonitor, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 小窗隐藏时暂停视频}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 关闭时隐藏小窗后视频继续播放，可以只听声音}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.PauseWhenHidden, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 执行任务时隐藏小窗}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 独立任务、调度器、一条龙、任务计划运行时隐藏，避免挡住自动操作}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.HideDuringTask, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 任务开始时暂停视频}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.PauseDuringTask, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 任务结束后恢复小窗}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 恢复显示，但不会自动继续播放}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.RestoreAfterTask, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  播放习惯  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon PlayCircle24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 播放习惯}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 快进步长、倍速、临时加速、续播与字幕}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 快进、快退步长}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SeekOptions}"
                                  SelectedValue="{Binding Config.SeekSeconds, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 倍速调整步长}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RateStepOptions}"
                                  SelectedValue="{Binding Config.RateStep, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 按住临时加速的倍速}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 按住快捷键时加速，松开后恢复原来的倍速}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BoostRateOptions}"
                                  SelectedValue="{Binding Config.BoostRate, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 音量调整步长}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding VolumeStepOptions}"
                                  SelectedValue="{Binding Config.VolumeStep, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 从上次位置继续}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 直接打开网页时沿用网站自己的观看进度（例如 B 站的“上次看到”），不会重复跳转}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ResumeModeOptions}"
                                  SelectedValue="{Binding Config.ResumeMode, Mode=TwoWay}"
                                  Style="{StaticResource GuideComboBox}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 续播时恢复上次的倍速}" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.RestorePlaybackRate, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 自动开启中文字幕（B 站）}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 普通中文字幕优先，其次 AI 中文字幕；本集内手动关闭后不再干预}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.AutoEnableChineseSubtitle, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 记住沉浸模式}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 下次打开视频时自动进入 B 站网页全屏}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.RememberImmersive, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  字幕浮窗  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon ClosedCaption24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 字幕浮窗}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 把视频字幕单独显示在游戏画面上，小窗可以缩小或隐藏}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,24,0"
                                         IsChecked="{Binding Config.SubtitleWindowEnabled, Mode=TwoWay}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 位置与宽度}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 字幕跟随游戏画面。调整时可以拖动位置、拖右侧边缘调整宽度、Ctrl+滚轮调整字号}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding AdjustSubtitleCommand}"
                                       Content="{i18n:T 调整位置}"
                                       Icon="{ui:SymbolIcon Edit24}" />
                            <ui:Button Command="{Binding ResetSubtitlePositionCommand}" Content="{i18n:T 恢复默认}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 字号}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <Slider Width="200"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="48"
                                    Minimum="12"
                                    TickFrequency="1"
                                    Value="{Binding Config.SubtitleFontSize, Mode=TwoWay}" />
                            <TextBlock Width="44"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Config.SubtitleFontSize, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 背景不透明度}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,36,0"
                                    Orientation="Horizontal">
                            <Slider Width="200"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="0.8"
                                    Minimum="0"
                                    TickFrequency="0.05"
                                    Value="{Binding Config.SubtitleBackgroundOpacity, Mode=TwoWay}" />
                            <TextBlock Width="44"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Config.SubtitleBackgroundOpacity, Mode=OneWay, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 开启字幕浮窗时隐藏网页内字幕}" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.HidePageSubtitle, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 小窗隐藏时继续显示字幕}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 隐藏小窗后只听声音、看字幕}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.ShowSubtitleWhenHidden, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!--  快捷键  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Keyboard24}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 快捷键}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{Binding HotKeySummary, Mode=OneWay}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="0,0,24,0"
                                   Appearance="Primary"
                                   Command="{Binding ApplyRecommendedHotKeysCommand}"
                                   Content="{i18n:T 一键填入推荐快捷键}"
                                   Icon="{ui:SymbolIcon Flash24}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Margin="16,12,16,4"
                                  Style="{StaticResource GuideItemDescription}"
                                  Text="{i18n:T 推荐方案使用 Ctrl+Alt 组合，只填入还没有绑定的项，并跳过已被其他功能占用的组合。部分 Intel 显卡驱动会用 Ctrl+Alt+方向键旋转屏幕，遇到时请在驱动设置中关闭或改用其他组合。按住临时加速只能使用单键或鼠标侧键，按键会同时传给游戏。}" />
                    <ItemsControl Margin="0,4,0,8" ItemsSource="{Binding HotKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:HotKeySettingModel}">
                                <Grid Margin="16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding LocalizedFunctionName, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="1"
                                               Height="32"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Stretch"
                                               Command="{Binding SwitchHotKeyTypeCommand}"
                                               Content="{Binding LocalizedHotKeyTypeName, Mode=OneWay}"
                                               IsEnabled="{Binding SwitchHotkeyTypeEnabled, Mode=OneWay}" />
                                    <hotKey:HotKeyTextBox Grid.Column="2"
                                                          Margin="0,0,36,0"
                                                          Padding="12,6"
                                                          VerticalAlignment="Center"
                                                          HotKeyTypeName="{Binding HotKeyTypeName, Mode=OneWay}"
                                                          Hotkey="{Binding HotKey}"
                                                          Style="{StaticResource DefaultTextBoxStyle}"
                                                          TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:HyperlinkButton Margin="12,0,0,12"
                                        Command="{Binding OpenHotKeyPageCommand}"
                                        Content="{i18n:T 在快捷键页查看全部快捷键}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  收藏与观看记录  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Star24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 收藏与观看记录}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{Binding LibrarySummary, Mode=OneWay}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <!--  右侧留 52（16 + 36），与其他设置行的控件右边缘对齐  -->
                <StackPanel Margin="16,12,52,12">
                    <ui:TextBlock Margin="0,0,0,6"
                                  FontTypography="BodyStrong"
                                  Text="{i18n:T 收藏}" />
                    <ui:TextBlock Style="{StaticResource GuideItemDescription}"
                                  Text="{i18n:T 在小窗窗口栏点 ★ 收藏当前视频。标题可以直接修改}"
                                  Visibility="{Binding HasFavorites, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:GuideFavoriteItemViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Url, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Progress, Mode=OneWay}" />
                                    <ui:Button Grid.Column="2"
                                               Margin="0,0,8,0"
                                               Command="{Binding DataContext.OpenFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Content="{i18n:T 打开}"
                                               Icon="{ui:SymbolIcon Play24}" />
                                    <ui:Button Grid.Column="3"
                                               Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="{i18n:T 删除收藏}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock VerticalAlignment="Center"
                                      FontTypography="BodyStrong"
                                      Text="{i18n:T 最近观看（最多显示 50 条）}" />
                        <ui:Button Grid.Column="1"
                                   Command="{Binding ClearHistoryCommand}"
                                   Content="{i18n:T 清空观看记录}"
                                   Icon="{ui:SymbolIcon Broom24}"
                                   IsEnabled="{Binding HasHistory, Mode=OneWay}" />
                    </Grid>
                    <ui:TextBlock Style="{StaticResource GuideItemDescription}"
                                  Text="{i18n:T 观看超过 10 秒的视频会自动记录进度}"
                                  Visibility="{Binding HasHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityRevertConverter}}" />
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:GuideHistoryItemViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding Title, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Url, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Progress, Mode=OneWay}" />
                                    <ui:Button Grid.Column="2"
                                               Margin="0,0,8,0"
                                               Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Content="{i18n:T 继续看}"
                                               Icon="{ui:SymbolIcon Play24}" />
                                    <ui:Button Grid.Column="3"
                                               Command="{Binding DataContext.RemoveHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="{i18n:T 删除这条记录}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:CardExpander>

            <!--  网页数据与链接  -->
            <ui:CardExpander Margin="0,0,0,12"
                             ContentPadding="0"
                             Icon="{ui:SymbolIcon Link24}">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 网页数据与快捷打开}" />
                        <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 小窗使用独立的网页环境，B 站登录只保存在小窗中}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 网页缓存}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 在存储空间中清理“悬浮小窗 · 网页缓存”，下次启动时生效，不会退出登录}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="0,0,36,0"
                                   Command="{Binding OpenStorageCommand}"
                                   Content="{i18n:T 打开存储空间}"
                                   Icon="{ui:SymbolIcon Storage24}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 地图点位视频默认用小窗打开}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 在大地图遮罩的点位详情中点击视频攻略时，直接在小窗中播放}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.OpenMapVideoInWindow, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Style="{StaticResource GuideItemTitle}" Text="{i18n:T 识别剪贴板中的 B 站链接}" />
                            <ui:TextBlock Style="{StaticResource GuideItemDescription}" Text="{i18n:T 复制 B 站视频链接后切到 BetterGI 主界面时，询问是否用小窗打开。也可以在游戏中按“用小窗打开剪贴板链接”快捷键}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         Margin="0,0,36,0"
                                         IsChecked="{Binding Config.ClipboardPromptEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </StackPanel>
</Page>
