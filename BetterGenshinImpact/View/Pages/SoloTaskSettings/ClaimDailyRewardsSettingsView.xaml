<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior" xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers" xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.SoloTaskSettings" x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.ClaimDailyRewardsSettingsView" ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}" ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoloTaskSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 领取每日奖励：沿用旧一条龙的冒险家协会与好感队卡片。 -->
    <!-- Fluent 设置布局：单项设置独立成卡，强关联设置使用展开卡片及带分隔线的设置行。 -->
    <StackPanel>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="领取奖励的冒险家协会" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="前往所选地区领取每日委托奖励。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="180" ItemsSource="{x:Static tasksVm:ClaimDailyRewardsSettingsViewModel.CountryChoices}" SelectedItem="{Binding Country, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="领取前切换好感队" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="填写游戏内队伍名称；留空使用当前队伍。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="210" Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空则不切换队伍"/>
        </ui:CardControl>
    </StackPanel>
</UserControl>
