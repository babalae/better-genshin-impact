<UserControl x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.SereniteaPotSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <!-- 尘歌壶奖励：按原一条龙提供进壶方式、购买日期及商品勾选，由宿主统一应用草稿。 -->
 <StackPanel>
  <ui:CardControl Margin="0,0,0,12">
   <ui:CardControl.Header>
    <StackPanel>
     <ui:TextBlock FontTypography="Body" Text="进壶方式选择" TextWrapping="Wrap"/>
     <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="通过地图传送或背包中的尘歌壶道具进入" TextWrapping="Wrap"/>
    </StackPanel>
   </ui:CardControl.Header>
   <ComboBox MinWidth="120" Margin="0,0,36,0" ItemsSource="{Binding TeleportTypeChoices}"
             SelectedItem="{Binding TeleportType, Mode=TwoWay}"/>
  </ui:CardControl>
  <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
   <ui:CardExpander.Header>
    <StackPanel>
     <ui:TextBlock FontTypography="Body" Text="购买选择" TextWrapping="Wrap"/>
     <ui:TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="购买日期和商品；日期不影响领取好感和钱币" TextWrapping="Wrap"/>
    </StackPanel>
   </ui:CardExpander.Header>
   <StackPanel Margin="16">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ui:TextBlock Text="购买日期" VerticalAlignment="Center"/>
     <ComboBox Grid.Column="1" MinWidth="150" ItemsSource="{Binding PurchaseScheduleChoices}"
               SelectedItem="{Binding PurchaseSchedule, Mode=TwoWay}"/>
    </Grid>
    <Separator Margin="0,12"/>
    <ItemsControl ItemsSource="{Binding PurchaseItems}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <CheckBox Margin="0,0,0,8" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ui:CardExpander>
 </StackPanel>
</UserControl>
