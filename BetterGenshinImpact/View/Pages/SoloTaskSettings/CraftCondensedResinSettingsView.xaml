<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior" xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers" xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.SoloTaskSettings" x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.CraftCondensedResinSettingsView" ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}" ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoloTaskSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 合成浓缩树脂：沿用旧一条龙的合成台卡片，绑定本任务的 country 参数。 -->
    <!-- Fluent 设置布局：单项设置独立成卡，强关联设置使用展开卡片及带分隔线的设置行。 -->
    <StackPanel>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="合成台所在地区" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="前往所选地区的合成台合成浓缩树脂。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="180" ItemsSource="{x:Static tasksVm:CraftCondensedResinSettingsViewModel.CountryChoices}" SelectedItem="{Binding Country, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="树脂使用" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SoloDescription}" Text="{Binding ResinSummary, Mode=OneWay}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="设置" MinWidth="88" Command="{Binding EditResinCommand, Mode=OneWay}"
                       AutomationProperties.Name="设置树脂使用" ToolTip="{Binding ResinSummary, Mode=OneWay}" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
