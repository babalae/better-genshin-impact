<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior" xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers" xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.SoloTaskSettings" x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.AutoLeyLineOutcropSettingsView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoloTaskSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 自动地脉花：沿用旧一条龙的模式与运行日期卡片，字段绑定 auto_ley_line_outcrop 参数。 -->
    <!-- 类型或国家留空表示当天沿用默认设置。 -->
    <!-- Fluent 设置布局：单项设置独立成卡，强关联设置使用展开卡片及带分隔线的设置行。 -->
    <StackPanel>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="跳过准备流程" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="适合一条龙连续执行，开始前不再传送回七天神像。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding OneDragonMode, Mode=TwoWay}"/>
        </ui:CardControl>

        <ui:CardExpander Style="{StaticResource SoloExpander}">
            <ui:CardExpander.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="每周运行安排" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="按星期设置运行日期、地脉花类型及国家。"/>
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource SoloDescription}" Margin="20,12" Text="服务器时间凌晨 4:00 切换日期；全部取消勾选时每天执行，留空使用任务默认类型与国家。"/>
                    <ItemsControl ItemsSource="{Binding Weekdays, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardExpander Style="{StaticResource SoloExpander}">
                                    <ui:CardExpander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <ui:TextBlock FontTypography="Body" Text="{Binding DayName, Mode=OneWay}" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource SoloDescription}" Text="选择当天是否执行，以及地脉花类型与国家。"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" Margin="12,0,16,0" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                        </Grid>
                                    </ui:CardExpander.Header>
                                    <StackPanel>
                                        <Grid Style="{StaticResource SoloRow}" IsEnabled="{Binding Enabled, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <ui:TextBlock FontTypography="Body" Text="地脉花类型" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource SoloDescription}" Text="留空使用默认类型。"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right">
                                                <ComboBox Width="180" ItemsSource="{x:Static tasksVm:AutoLeyLineOutcropSettingsViewModel.TypeChoices}" SelectedItem="{Binding Type, Mode=TwoWay}"/>
                                            </ContentControl>
                                        </Grid>
                                        <Separator Margin="20,0"/>
                                        <Grid Style="{StaticResource SoloRow}" IsEnabled="{Binding Enabled, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <ui:TextBlock FontTypography="Body" Text="国家" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource SoloDescription}" Text="留空使用默认国家。"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right">
                                                <ComboBox Width="180" ItemsSource="{x:Static tasksVm:AutoLeyLineOutcropSettingsViewModel.CountryChoices}" SelectedItem="{Binding Country, Mode=TwoWay}"/>
                                            </ContentControl>
                                        </Grid>
                                    </StackPanel>
                                </ui:CardExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="树脂使用" TextWrapping="Wrap" />
                    <ContentControl Content="{Binding Resin, Mode=OneWay}" ContentTemplate="{StaticResource ResinUsageSummaryTemplate}"
                                    Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    HorizontalContentAlignment="Stretch" Focusable="False" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="设置" MinWidth="88" Command="{Binding Resin.EditCommand, Mode=OneWay}"
                       AutomationProperties.Name="设置树脂使用" ToolTip="{Binding Resin.Summary, Mode=OneWay}" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
