<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resin="clr-namespace:BetterGenshinImpact.View.Controls.Resin" xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior" xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers" xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.SoloTaskSettings" x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.AutoStygianOnslaughtSettingsView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoloTaskSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 自动幽境危战：旧一条龙没有此卡片，按旧卡片的视觉风格为 auto_stygian_onslaught 设计。 -->
    <!-- Fluent 设置布局：单项设置独立成卡，强关联设置使用展开卡片及带分隔线的设置行。 -->
    <StackPanel>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="战斗策略" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="选择此任务使用的幽境危战策略。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <combat:CombatStrategyPicker Width="288" AllowedKinds="WithoutCombo" Strategy="{Binding StrategyName, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="幽境首领序号" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="对应挑战界面从左到右的三位首领。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="100" ItemsSource="{x:Static tasksVm:AutoStygianOnslaughtSettingsViewModel.BossNumChoices}" SelectedItem="{Binding BossNum, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="战斗队伍" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="填写游戏内队伍名称；留空使用当前队伍。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="210" Text="{Binding FightTeamName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空则不切换队伍"/>
        </ui:CardControl>

        <resin:ResinSettingsCard Summary="{Binding Resin.Summary, Mode=OneWay}" Problem="{Binding Resin.Problem, Mode=OneWay}" Command="{Binding Resin.EditCommand, Mode=OneWay}" Margin="0,0,0,8"/>
        <ui:CardExpander Style="{StaticResource SoloExpander}">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock FontTypography="Body" Text="结束后分解圣遗物" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SoloDescription}" Text="开启后按指定最高星级分解，避免背包占满。"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" Margin="12,0,16,0" IsChecked="{Binding AutoArtifactSalvage, Mode=TwoWay}"/>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Style="{StaticResource SoloRow}" IsEnabled="{Binding AutoArtifactSalvage, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock FontTypography="Body" Text="最高星级" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SoloDescription}" Text="只分解不高于此星级的圣遗物。"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right">
                        <ComboBox Width="100" ItemsSource="{x:Static tasksVm:AutoStygianOnslaughtSettingsViewModel.ArtifactStarChoices}" SelectedItem="{Binding MaxArtifactStar, Mode=TwoWay}"/>
                    </ContentControl>
                </Grid>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</UserControl>
