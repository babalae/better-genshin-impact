<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resin="clr-namespace:BetterGenshinImpact.View.Controls.Resin" xmlns:combat="clr-namespace:BetterGenshinImpact.View.Controls.CombatStrategy" xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta" xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior" xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers" xmlns:tasksVm="clr-namespace:BetterGenshinImpact.ViewModel.SoloTaskSettings" x:Class="BetterGenshinImpact.View.Pages.SoloTaskSettings.AutoBossSettingsView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SoloTaskSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 自动首领讨伐：沿用旧一条龙的配置卡片，字段绑定 auto_boss 参数；旧累计上限未迁入新系统。 -->
    <!-- Fluent 设置布局：单项设置独立成卡，强关联设置使用展开卡片及带分隔线的设置行。 -->
    <StackPanel>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="战斗策略" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="选择此任务使用的首领讨伐策略。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <combat:CombatStrategyPicker Width="288" AllowedKinds="WithoutCombo" Strategy="{Binding StrategyName, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="讨伐首领" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="选择要挑战的首领，暂不支持部分特殊机制首领。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <vio:CascadingComboBox Width="210" behavior:DomainCascadingComboBoxBehavior.ClearValue="{Binding BossName, Mode=TwoWay}" behavior:DomainCascadingComboBoxBehavior.UseFullLabelsWhenOpen="True" ItemsSource="{x:Static helpers:AutoBossCascadingItems.Items}" SelectedCascadingItem="{Binding BossName, Mode=TwoWay, Converter={StaticResource AutoBossNameConverter}}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="战斗队伍" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="填写游戏内队伍名称；留空使用当前队伍。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="210" Text="{Binding TeamName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空则不切换队伍"/>
        </ui:CardControl>

        <resin:ResinSettingsCard Summary="{Binding Resin.Summary, Mode=OneWay}" Problem="{Binding Resin.Problem, Mode=OneWay}" Command="{Binding Resin.EditCommand, Mode=OneWay}" Margin="0,0,0,8"/>
        <ui:CardExpander Style="{StaticResource SoloExpander}">
            <ui:CardExpander.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="累计成功领奖次数" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="跨次运行累计，每个任务、账号分别统计；0 表示不限制。"/>
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Style="{StaticResource SoloRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <ui:TextBlock FontTypography="Body" Text="累计上限" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SoloDescription}" Text="到达上限后跳过本任务，不影响后续步骤。"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right">
                        <ui:NumberBox Width="150" Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline" Value="{Binding TotalRunCountLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </ContentControl>
                </Grid>
                <Separator Margin="20,0"/>
                <Grid Style="{StaticResource SoloRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CompletedRunCountText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Margin="8,0,0,0" Content="刷新累计" Command="{Binding RefreshProgressCommand}"/>
                        <ui:Button Margin="8,0,0,0" Content="清空累计" Command="{Binding ResetProgressCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="每轮结束返回七天神像" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="领奖后先回神像恢复，再前往首领开始下一轮。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ReturnToStatueAfterEachRound, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="奖励识别" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="每轮领奖后识别奖励名称与数量，结束时汇总。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding RewardRecognitionEnabled, Mode=TwoWay}"/>
        </ui:CardControl>
        <ui:CardControl Style="{StaticResource SoloCard}">
            <ui:CardControl.Header>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock FontTypography="Body" Text="角色死亡后重试次数" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource SoloDescription}" Text="复活后重新挑战当前首领，0 表示不重试。"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox Width="150" Minimum="0" SmallChange="1" LargeChange="5" ClearButtonEnabled="False" SpinButtonPlacementMode="Inline" Value="{Binding ReviveRetryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </ui:CardControl>
    </StackPanel>
</UserControl>
