    "default": false
  },
  {
    "type": "separator"
  },
  {
    "name": "key",
    "type": "input-text",
    "label": "密钥",
    "default": "PGCSBY37NJA"
  },
  {
    "type": "separator"
  },
  {
    "name": "config_run",
    "type": "select",
    "label": "配置模式",
    "options": [
      "刷新",
      "加载",
      "执行"
    ],
    "default": "执行"
  },
  {
    "name": "refresh_record",
    "type": "checkbox",
    "label": "配置模式-刷新-清空运行记录",
    "default": false
  },
  {
    "name": "refresh_record_mode",
    "type": "select",
    "label": "清空运行记录模式",
    "options": [
      "全部",
      "UID"
    ],
    "default": "UID"
  },
  {
    "name": "loading_level",
    "type": "input-text",
    "label": "加载路径层级(不可小于1)<配置模式 刷新||加载 生效>",
    "default": "3"
  },
  {
    "name": "the_layer",
    "type": "checkbox",
    "label": "只加载指定层级<配置模式 加载 生效>",
    "default": false
  },
  {
    "name": "high_level_filtering",
    "type": "input-text",
