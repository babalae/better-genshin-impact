  },
  {
    "name": "order_rules",
    "type": "input-text",
    "label": "执行顺序规则(可留空)\n{语法:父文件夹名称->文件夹名称=顺序请填整数,.....}",
    "default": ""
  },
  {
    "type": "separator"
  },
  {
    "name": "config_white_list",
    "type": "input-text",
    "label": "刷新白名单 以,分割",
